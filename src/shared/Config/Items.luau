	item.order = index
	byId[item.id] = item
end

local function hasFlag(item, flag: string): boolean
	if not item.flags then
		return false
	end
	for _, f in ipairs(item.flags) do
		if f == flag then
			return true
		end
	end
	return false
end

return {
	List = Items,
	ById = byId,
	HasFlag = hasFlag,
	-- Ключевые постройки, которые переключают этап игры
	StageMilestones = {
		{ stage = 2, item = "tower" },
		{ stage = 3, item = "factory_building" },
		{ stage = 4, item = "drone_station" },
		{ stage = 5, item = "lab" },
	},
}
