		requiresPass = "vip",
		cost = 1_000,
		growth = 1,
		max = 1,
		incomeBoost = 0.1,
		visual = "Robot",
		color = { 255, 210, 50 },
	},
}

local byId = {}
for index, s in ipairs(Staff) do
	s.order = index
	byId[s.id] = s
end

local function costOf(s, owned: number): number
	return math.floor(s.cost * s.growth ^ owned)
end

return {
	List = Staff,
	ById = byId,
	CostOf = costOf,
}
]]></string>
          </Properties>
