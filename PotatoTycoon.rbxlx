		cost = 3100,
		requires = "autobed_t2_1",
		stage = 2,
		asset = 28,
		color = { 235, 205, 110 },
	},
	{
		id = "siney",
		name = "Синеглазка",
		price = 20,
		growth = 1,
		cost = 23_000,
		requires = "autobed_t3_1",
		stage = 2,
		asset = 29,
		color = { 196, 170, 210 },
