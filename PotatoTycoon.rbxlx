          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[-- Локальные анимации объектов по тегам CollectionService (сервер их только помечает):
-- Spin, Slide, Bob, Sway, Pulse, Hover (дроны), Roam (роботы), Bug (жуки)

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Animator = {}

type Entry = {
	inst: Instance,
	tag: string,
	base: CFrame,
	current: CFrame,
	transparency: number?,
	seed: number,
	depth: number,
	parent: any?, -- ближайший анимируемый предок (лопасти дрона внутри летящего дрона)
	rel: CFrame?,
}

local entries: { [Instance]: { Entry } } = {}
local list: { Entry } = {}
local TAGS = { "Spin", "Slide", "Bob", "Sway", "Pulse", "Hover", "Roam", "Bug" }
local MOVERS = { Spin = true, Slide = true, Bob = true, Sway = true, Hover = true, Roam = true, Bug = true }
local CULL_DISTANCE = 220

local function pivotOf(inst: Instance): CFrame?
	if inst:IsA("Model") then
		return inst:GetPivot()
	elseif inst:IsA("BasePart") then
		return inst.CFrame
	end
	return nil
end

local function setPivot(inst: Instance, cf: CFrame)
	if inst:IsA("Model") then
		inst:PivotTo(cf)
	elseif inst:IsA("BasePart") then
		inst.CFrame = cf
	end
end

local function depthOf(inst: Instance): number
	local d = 0
	local node = inst.Parent
	while node do
		d += 1
		node = node.Parent
	end
	return d
end

local function rebuildList()
	table.clear(list)
	for _, group in pairs(entries) do
		for _, e in ipairs(group) do
			table.insert(list, e)
		end
	end
	for _, e in ipairs(list) do
		e.parent = nil
		e.rel = nil
		e.depth = depthOf(e.inst)
		if MOVERS[e.tag] then
			local node = e.inst.Parent
			while node and node ~= workspace and not e.parent do
				for _, pe in ipairs(entries[node] or {}) do
					if MOVERS[pe.tag] then
						e.parent = pe
						e.rel = pe.base:ToObjectSpace(e.base)
						break
					end
				end
				node = node.Parent
			end
		end
	end
	-- родители анимируются раньше детей
	table.sort(list, function(a, b)
		return a.depth < b.depth
	end)
end

local function add(inst: Instance, tag: string)
	local base = pivotOf(inst)
	if not base then
		return
	end
	local e: Entry = {
		inst = inst,
		tag = tag,
		base = base,
		current = base,
		transparency = if inst:IsA("BasePart") then inst.Transparency else nil,
		seed = math.random() * 100,
		depth = 0,
	}
	entries[inst] = entries[inst] or {}
	table.insert(entries[inst], e)
	rebuildList()
end

local function remove(inst: Instance)
	if entries[inst] then
		entries[inst] = nil
		rebuildList()
	end
end

local function axisRotation(axis: string?, angle: number): CFrame
	if axis == "X" then
		return CFrame.Angles(angle, 0, 0)
	elseif axis == "Z" then
		return CFrame.Angles(0, 0, angle)
	end
	return CFrame.Angles(0, angle, 0)
end

local function axisVector(axis: string?): Vector3
	if axis == "X" then
		return Vector3.xAxis
	elseif axis == "Y" then
		return Vector3.yAxis
	end
	return Vector3.zAxis
end

local function step()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local t = os.clock()
	for _, e in ipairs(list) do
		local inst = e.inst
		local base = if e.parent and e.rel then e.parent.current * e.rel else e.base
		if (base.Position - camPos).Magnitude > CULL_DISTANCE then
			continue
		end
		local speed = inst:GetAttribute("Speed") or 1
		local tag = e.tag
		local cf: CFrame? = nil
		if tag == "Spin" then
			local angle = math.rad(t * speed + e.seed * 10)
			cf = base * axisRotation(inst:GetAttribute("Axis"), angle)
		elseif tag == "Slide" then
			local offset = math.sin(t * speed * 2 + e.seed) * (inst:GetAttribute("Amplitude") or 1)
			cf = base * CFrame.new(axisVector(inst:GetAttribute("Axis")) * offset)
		elseif tag == "Bob" then
			local offset = math.sin(t * speed * 2 + e.seed) * (inst:GetAttribute("Amplitude") or 0.3)
			cf = base * CFrame.new(0, offset, 0)
		elseif tag == "Sway" then
			local angle = math.rad(math.sin(t * speed + e.seed) * (inst:GetAttribute("Amplitude") or 10))
			cf = base * axisRotation(inst:GetAttribute("Axis"), angle)
		elseif tag == "Pulse" then
			if inst:IsA("BasePart") then
				local baseT = e.transparency or 0
				inst.Transparency = baseT + (1 - baseT) * 0.6 * (0.5 + 0.5 * math.sin(t * speed * 3 + e.seed))
			end
		elseif tag == "Hover" then
			local r = inst:GetAttribute("Radius") or 3
			local phase = inst:GetAttribute("Phase") or 0
			local a = t * speed + phase
			local pos = Vector3.new(math.cos(a) * r, math.sin(t * 2 + phase) * 0.4, math.sin(a) * r)
			local facing = math.atan2(-math.cos(a), math.sin(a))
			cf = base * CFrame.new(pos) * CFrame.Angles(0, facing, math.sin(t * 3) * 0.08)
		elseif tag == "Roam" then
			local r = inst:GetAttribute("Radius") or 1.5
			local a = t * speed + e.seed
			local pos = Vector3.new(math.sin(a) * r, 0, math.sin(a * 0.5) * r)
			cf = base * CFrame.new(pos) * CFrame.Angles(0, math.sin(a) * 0.8, 0)
		elseif tag == "Bug" then
			local a = t * 0.9 + e.seed
			local pos = Vector3.new(math.sin(a) * 3, math.abs(math.sin(t * 9 + e.seed)) * 0.15, math.sin(a * 0.7) * 3)
			local dx = math.cos(a) * 3
			local dz = math.cos(a * 0.7) * 2.1
			cf = base * CFrame.new(pos) * CFrame.Angles(0, math.atan2(dx, dz), 0)
		end
		if cf then
			e.current = cf
			setPivot(inst, cf)
		end
	end
end

function Animator.init()
	for _, tag in ipairs(TAGS) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			add(inst, tag)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
			-- ждём, пока модель полностью реплицируется
			task.defer(add, inst, tag)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(remove)
	end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 / 30 then
			accumulator = 0
			step()
		end
	end)
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Beds</string>
              <string name="Source"><![CDATA[-- Рост кустов на ручных грядках (Этап 1): сервер присылает время созревания, клиент анимирует

local RunService = game:GetService("RunService")

local Beds = {}

type BedInfo = {
	model: Model,
	parts: { { part: BasePart, size: Vector3, cframe: CFrame, bottom: number } },
	tubers: { BasePart },
	last: number,
}

local beds: { [Model]: BedInfo } = {}

-- Половина высоты детали по мировой оси Y (учитывает повёрнутые цилиндры-стебли)
local function halfHeight(cf: CFrame, size: Vector3): number
	return (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z)
		/ 2
end

local function track(model: Model)
	if beds[model] or not model:GetAttribute("ManualBed") then
		return
	end
	local bush = model:WaitForChild("Bush", 5)
	local tubers = model:WaitForChild("Tubers", 5)
	if not (bush and tubers) then
		return
	end
	local info: BedInfo = { model = model, parts = {}, tubers = {}, last = -1 }
	for _, p in ipairs(bush:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(info.parts, {
				part = p,
				size = p.Size,
				cframe = p.CFrame,
				bottom = p.CFrame.Position.Y - halfHeight(p.CFrame, p.Size),
			})
		end
	end
	for _, p in ipairs(tubers:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(info.tubers, p)
		end
	end
	beds[model] = info
	model.Destroying:Connect(function()
		beds[model] = nil
	end)
end

local function growth(model: Model): number
	if model:GetAttribute("Auto") then
		return 1
	end
	local ripeAt = model:GetAttribute("RipeAt")
	local ripen = model:GetAttribute("RipenTime") or 3
	if not ripeAt then
		return 1
	end
	return math.clamp(1 - (ripeAt - workspace:GetServerTimeNow()) / ripen, 0, 1)
end

function Beds.isRipe(model: Model): boolean
	return not model:GetAttribute("Auto") and growth(model) >= 0.97
end

local function update()
	for model, info in pairs(beds) do
		if not model.Parent then
			beds[model] = nil
			continue
		end
		local f = growth(model)
		local auto = model:GetAttribute("Auto") == true
		local key = math.floor(f * 30) + (if auto then 100 else 0)
		if key ~= info.last then
			info.last = key
			local k = 0.25 + 0.75 * f
			for _, rec in ipairs(info.parts) do
				local size = rec.size * k
				rec.part.Size = size
				local pos = rec.cframe.Position
				local half = halfHeight(rec.cframe, size)
				rec.part.CFrame = rec.cframe - pos + Vector3.new(pos.X, rec.bottom + half, pos.Z)
			end
			local ripe = f >= 0.97 and not auto
			for _, t in ipairs(info.tubers) do
				t.Transparency = if ripe then 0 else 1
			end
		end
	end
end

function Beds.init()
	local plots = workspace:WaitForChild("Plots")
	for _, d in ipairs(plots:GetDescendants()) do
		if d:IsA("Model") and d:GetAttribute("ManualBed") then
			task.spawn(track, d)
		end
	end
	plots.DescendantAdded:Connect(function(d)
		if d:IsA("Model") then
			task.defer(function()
				if d:GetAttribute("ManualBed") then
					track(d)
				end
			end)
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.08 then
			acc = 0
			update()
		end
	end)
end

return Beds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Click</string>
              <string name="Source"><![CDATA[-- Клики по миру: копка грядок лопатой и ловля жуков

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Beds = require(script.Parent.Beds)
local Sound = require(script.Parent.Sound)

local player = Players.LocalPlayer

local Click = {}

local digRemote = Remotes.get("Dig")
local bugRemote = Remotes.get("ClickBug")

local function shovelEquipped(): boolean
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Shovel") == true
end

local function modelWith(part: Instance, attribute: string): Model?
	local node = part.Parent
	while node and node ~= workspace do
		if node:IsA("Model") and node:GetAttribute(attribute) then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function handle(screenPos: Vector2)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { player.Character :: Instance, workspace:FindFirstChild("ClientFx") :: Instance }
	local result
	-- полупрозрачные детали (стекло теплиц) пропускаем, кроме хитбоксов жуков
	for _ = 1, 5 do
		params.FilterDescendantsInstances = ignore
		result = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		if not result or result.Instance.Transparency < 0.5 or modelWith(result.Instance, "Bug") then
			break
		end
		table.insert(ignore, result.Instance)
	end
	if not result then
		return
	end
	local bug = modelWith(result.Instance, "Bug")
	if bug then
		if bug:GetAttribute("Owner") == player.UserId then
			bugRemote:FireServer(bug)
		end
		return
	end
	local bed = modelWith(result.Instance, "ManualBed")
	if bed and bed:GetAttribute("Owner") == player.UserId and shovelEquipped() then
		if Beds.isRipe(bed) then
			digRemote:FireServer(bed.Name)
		else
			Sound.play("Click", 0.3)
		end
	end
end

function Click.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			handle(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
end

return Click
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Визуальные эффекты (ГДД, ассеты 205–210): всплывающие «+$», золотое сияние, искры перегрузки,
-- конфетти Rebirth, дым и пламя шаттла, лопание жуков, баннер нового этапа

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Root = require(script.Parent.Parent.UI.Root)
local Theme = require(script.Parent.Parent.UI.Theme)
local Sound = require(script.Parent.Sound)

local player = Players.LocalPlayer

local Effects = {}

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFx"
fxFolder.Parent = workspace

local function anchorPart(position: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = position
	p.Parent = fxFolder
	return p
end

-- Всплывающий текст над точкой
function Effects.float(position: Vector3, text: string, color: Color3?, size: number?)
	local part = anchorPart(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160 * (size or 1), 40 * (size or 1))
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color or Theme.Colors.Cash
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	local info = TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(gui, info, { StudsOffset = Vector3.new(0, 4.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1.4, function()
		part:Destroy()
	end)
end

-- Подпрыгивающие клубни при копке
local function potatoPop(position: Vector3, count: number, color: Color3?)
	for _ = 1, math.min(count, 6) do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.6, 0.6, 0.6)
		p.Color = color or Color3.fromRGB(190, 145, 85)
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Anchored = true
		p.Position = position + Vector3.new(0, 1.5, 0)
		p.Parent = fxFolder
		local target = p.Position
			+ Vector3.new(math.random(-20, 20) / 10, math.random(25, 40) / 10, math.random(-20, 20) / 10)
		TweenService
			:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target })
			:Play()
		task.delay(0.35, function()
			TweenService:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = target + Vector3.new(0, -3, 0),
				Transparency = 1,
			}):Play()
		end)
		task.delay(0.8, function()
			p:Destroy()
		end)
	end
end

-- Золотое сияние вокруг грядки
function Effects.glow(target: Instance?, seconds: number)
	if not (target and target:IsA("Model")) then
		return
	end
	local pivot = (target :: Model):GetPivot().Position
	local part = anchorPart(pivot + Vector3.new(0, 1.5, 0))
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 210, 60)
	sparkles.Parent = part
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 80)
	light.Range = 14
	light.Brightness = 3
	light.Parent = part
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(255, 210, 60)
	hl.FillTransparency = 0.6
	hl.OutlineColor = Color3.fromRGB(255, 240, 150)
	hl.Adornee = target
	hl.Parent = part
	task.delay(seconds, function()
		part:Destroy()
	end)
end

-- Конфетти на весь экран
function Effects.confetti(big: boolean?)
	local colors = {
		Color3.fromRGB(255, 205, 60),
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(90, 200, 255),
		Color3.fromRGB(120, 230, 110),
		Color3.fromRGB(200, 120, 255),
	}
	local count = if big then 140 else 60
	for i = 1, count do
		local piece = Instance.new("Frame")
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = colors[(i % #colors) + 1]
		piece.Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22))
		piece.Position = UDim2.new(math.random(), 0, 0, -30)
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 60
		piece.Parent = Root.fx
		local duration = math.random(18, 34) / 10
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- Баннер посередине экрана
function Effects.banner(title: string, subtitle: string?, color: Color3?)
	local frame = Theme.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(620, 120),
		BackgroundTransparency = 1,
		ZIndex = 55,
		Parent = Root.fx,
	})
	local t = Theme.label({
		Size = UDim2.fromScale(1, 0.62),
		Text = title,
		Font = Theme.FontBlack,
		TextColor3 = color or Theme.Colors.Gold,
		TextStrokeTransparency = 0.1,
		ZIndex = 56,
		Parent = frame,
	})
	local s = Theme.label({
		Position = UDim2.fromScale(0, 0.64),
		Size = UDim2.fromScale(1, 0.32),
		Text = subtitle or "",
		TextStrokeTransparency = 0.2,
		ZIndex = 56,
		Parent = frame,
	})
	local scale = Theme.New("UIScale", { Scale = 0.4, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	task.delay(3, function()
		local info = TweenInfo.new(0.5)
		TweenService:Create(t, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.55)
		frame:Destroy()
	end)
end

-- Брызги при лопании жука
local function splat(position: Vector3, dead: boolean)
	local part = anchorPart(position + Vector3.new(0, 0.6, 0))
	local p = Instance.new("ParticleEmitter")
	p.Color = ColorSequence.new(if dead then Color3.fromRGB(120, 220, 60) else Color3.fromRGB(255, 220, 120))
	p.Size = NumberSequence.new(0.5, 0)
	p.Speed = NumberRange.new(6, 12)
	p.SpreadAngle = Vector2.new(180, 180)
	p.Lifetime = NumberRange.new(0.3, 0.6)
	p.Rate = 0
	p.Parent = part
	p:Emit(if dead then 25 else 8)
	task.delay(1, function()
		part:Destroy()
	end)
end

-- Старт шаттла: огонь, дым и подъём (виден всем)
local function launch(plotIndex: number)
	local plots = workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. plotIndex)
	local shuttle = plot and plot:FindFirstChild("Items") and plot.Items:FindFirstChild("shuttle")
	if not shuttle then
		return
	end
	local stack = shuttle:FindFirstChild("Stack") :: Model?
	if not stack then
		return
	end
	for _, d in ipairs(stack:GetDescendants()) do
		if d:IsA("Fire") or d:IsA("Smoke") then
			d.Enabled = true
		end
	end
	if plot:GetAttribute("OwnerUserId") == player.UserId then
		Sound.play("Rocket")
	end
	local base = stack:GetPivot()
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		if not stack.Parent or t > 5 then
			connection:Disconnect()
			return
		end
		local lift = if t < 1 then t * 0.3 else 0.3 + (t - 1) ^ 2 * 9
		local shake = if t < 1 then (math.random() - 0.5) * 0.2 else 0
		stack:PivotTo(base * CFrame.new(shake, lift, shake))
	end)
end

function Effects.handle(data)
	local kind = data.type
	if kind == "Float" then
		Effects.float(data.position, data.text, data.color)
	elseif kind == "Dig" then
		potatoPop(data.position, data.amount)
		Effects.float(
			data.position + Vector3.new(0, 2, 0),
			"+" .. data.amount .. " 🥔",
			Color3.fromRGB(255, 220, 150)
		)
		Sound.play("Dig", 0.2)
	elseif kind == "Sell" then
		if data.position then
			Effects.float(
				data.position + Vector3.new(0, 5, 0),
				"+" .. Format.money(data.amount),
				Theme.Colors.Cash,
				1.4
			)
		end
		Sound.play("Dump")
		Sound.play("Cash")
	elseif kind == "Golden" then
		local target = data.target
		local pos = if target and target:IsA("Model") then target:GetPivot().Position else nil
		if pos then
			Effects.float(pos + Vector3.new(0, 4, 0), "✨ +" .. Format.money(data.amount), Theme.Colors.Gold, 1.4)
			potatoPop(pos, 3, Color3.fromRGB(255, 205, 50))
		end
		Effects.glow(target, data.glow or 6)
		Sound.play("Golden")
	elseif kind == "Confetti" then
		Effects.confetti(data.big)
		Sound.play("Cash")
	elseif kind == "Launch" then
		launch(data.plotIndex)
	elseif kind == "Squash" then
		splat(data.position, data.dead)
		Sound.play("Squash", 0.3)
	elseif kind == "Purchase" then
		Sound.play("Build")
		Sound.play("Cash")
	elseif kind == "Stage" then
		local stage = Config.Game.Stages[data.stage]
		if stage then
			Effects.banner("ЭТАП " .. data.stage, stage.name)
			Effects.confetti(false)
		end
	elseif kind == "Sound" then
		Sound.play(data.sound)
	end
end

function Effects.init()
	Remotes.get("Effect").OnClientEvent:Connect(Effects.handle)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[-- Воспроизведение звуков по ключу из Config.Sounds

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local Sound = {}

local cache: { [string]: Sound } = {}

local function get(key: string): Sound?
	local def = Config.Sounds[key]
	if not def or def.id == "" then
		return nil
	end
	local s = cache[key]
	if not s then
		s = Instance.new("Sound")
		s.Name = "Sfx_" .. key
		s.SoundId = def.id
		s.Volume = def.volume
		s.Parent = SoundService
		cache[key] = s
	end
	return s
end

function Sound.play(key: string, pitchJitter: number?)
	local s = get(key)
	if not s then
		return
	end
	local def = Config.Sounds[key]
	s.PlaybackSpeed = def.pitch * (1 + (math.random() - 0.5) * (pitchJitter or 0))
	SoundService:PlayLocalSound(s)
end

-- Зацикленный 3D-звук на объекте (жарка, слайсер, гул трансформатора)
function Sound.attachLoop(key: string, part: BasePart): Sound?
	local def = Config.Sounds[key]
	if not def or def.id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "Loop_" .. key
	s.SoundId = def.id
	s.Volume = def.volume
	s.PlaybackSpeed = def.pitch
	s.Looped = true
	s.RollOffMaxDistance = 45
	s.RollOffMinDistance = 6
	s.Parent = part
	s:Play()
	return s
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">WorldFx</string>
              <string name="Source"><![CDATA[-- Живой мир базы: цвет кнопок покупки, анимация постройки, «+$» над полями,
-- искры при перегрузке сети, фоновые звуки цехов, фильтр подсказок чужих баз

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Format = require(ReplicatedStorage.Shared.Format)

local Effects = require(script.Parent.Effects)
local Sound = require(script.Parent.Sound)
local State = require(script.Parent.Parent.State)

local player = Players.LocalPlayer

local WorldFx = {}

-- Открытие меню через ProximityPrompt (офис, лаборатория, терминал звёзд, шаттл)
WorldFx.openMenu = function(_name: string) end

local GREEN = Color3.fromRGB(60, 210, 90)
local RED = Color3.fromRGB(215, 60, 55)
local GREY = Color3.fromRGB(120, 120, 125)

local function myPlot(): Instance?
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			return plot
		end
	end
	return nil
end
WorldFx.myPlot = myPlot

local function plotOf(inst: Instance): Instance?
	local plots = workspace:FindFirstChild("Plots")
	local node = inst
	while node and node.Parent do
		if node.Parent == plots then
			return node
		end
		node = node.Parent
	end
	return nil
end

------------------------------------------------------------------
-- Кнопки покупки
------------------------------------------------------------------
local function paintButton(model: Instance)
	local pad = model:FindFirstChild("Pad", true) :: BasePart?
	if not pad then
		return
	end
	local info = pad:FindFirstChild("Info") :: BillboardGui?
	local mine = model:GetAttribute("Owner") == player.UserId
	if not mine then
		pad.Color = GREY
		if info then
			info.Enabled = false
		end
		return
	end
	local cost = model:GetAttribute("Cost") or 0
	local affordable = State.num("Cash") + 1e-6 >= cost
	pad.Color = if affordable then GREEN else RED
	if info then
		info.Enabled = true
		local price = info:FindFirstChild("Price") :: TextLabel?
		if price then
			price.TextColor3 = if affordable then GREEN else Color3.fromRGB(255, 120, 110)
			price.Text = if affordable then Format.money(cost) else "🔒 " .. Format.money(cost)
		end
	end
end

local function paintAll()
	for _, model in ipairs(CollectionService:GetTagged("BuyButton")) do
		paintButton(model)
	end
end

------------------------------------------------------------------
-- Подсказки ProximityPrompt только на своей базе
------------------------------------------------------------------
local function filterPrompt(prompt: ProximityPrompt)
	local plot = plotOf(prompt)
	if not plot then
		return
	end
	local function apply()
		if plot:GetAttribute("OwnerUserId") ~= player.UserId and prompt.Enabled then
			prompt.Enabled = false
		end
	end
	apply()
	prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
end

------------------------------------------------------------------
-- Анимация появления постройки (прозрачность 1 → исходная)
------------------------------------------------------------------
local function buildAnimation(model: Model)
	local builtAt = model:GetAttribute("BuiltAt")
	if not builtAt or workspace:GetServerTimeNow() - builtAt > 3 then
		return
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			table.insert(parts, { part = d, transparency = d.Transparency })
			d.Transparency = 1
		end
	end
	local pivot = model:GetPivot().Position
	Effects.float(pivot + Vector3.new(0, 4, 0), "🔨", Color3.new(1, 1, 1), 1.2)
	for i, rec in ipairs(parts) do
		local delayTime = math.min(i * 0.012, 0.6)
		task.delay(delayTime, function()
			if rec.part.Parent then
				TweenService:Create(rec.part, TweenInfo.new(0.35), { Transparency = rec.transparency }):Play()
			end
		end)
	end
end

------------------------------------------------------------------
-- Всплывающие «+$» над полями (ГДД 205)
------------------------------------------------------------------
local function incomeFloats()
	local income = State.num("Income")
	if income <= 0 then
		return
	end
	local plot = myPlot()
	local items = plot and plot:FindFirstChild("Items")
	if not items then
		return
	end
	local sources, total = {}, 0
	for _, model in ipairs(items:GetChildren()) do
		local y = model:GetAttribute("Yield")
		if y then
			table.insert(sources, model)
			total += y
		end
	end
	if #sources == 0 then
		return
	end
	local model = sources[math.random(1, #sources)]
	local share = income * 2 * (model:GetAttribute("Yield") / total) * #sources / 3
	Effects.float(model:GetPivot().Position + Vector3.new(0, 3, 0), "+" .. Format.money(share))
end

------------------------------------------------------------------
-- Перегрузка сети: сирена и искры над генераторами (ГДД 202, 207)
------------------------------------------------------------------
local sparks: { Instance } = {}

local function setOverload(on: boolean)
	for _, s in ipairs(sparks) do
		s:Destroy()
	end
	table.clear(sparks)
	if not on then
		return
	end
	Sound.play("Alarm")
	local plot = myPlot()
	local items = plot and plot:FindFirstChild("Items")
	if not items then
		return
	end
	for _, model in ipairs(items:GetChildren()) do
		local id = model.Name
		if id == "substation" or string.find(id, "gen_") or string.find(id, "diesel") or id == "breaker" then
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.Transparency = 1
			p.Size = Vector3.new(1, 1, 1)
			p.Position = (model :: Model):GetPivot().Position + Vector3.new(0, 3, 0)
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(120, 200, 255))
			e.LightEmission = 1
			e.Size = NumberSequence.new(0.25, 0)
			e.Speed = NumberRange.new(8, 14)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Lifetime = NumberRange.new(0.15, 0.35)
			e.Rate = 40
			e.Acceleration = Vector3.new(0, -30, 0)
			e.Parent = p
			p.Parent = workspace:FindFirstChild("ClientFx") or workspace
			table.insert(sparks, p)
		end
	end
end

------------------------------------------------------------------
-- Фоновые звуки цехов
------------------------------------------------------------------
local function ambient(model: Instance)
	local key = model:GetAttribute("Sound")
	if key and model:IsA("Model") then
		local part = model:FindFirstChildWhichIsA("BasePart", true)
		if part then
			Sound.attachLoop(key, part)
		end
	end
end

function WorldFx.init()
	CollectionService:GetInstanceAddedSignal("BuyButton"):Connect(function(model)
		task.defer(paintButton, model)
	end)
	State.onAttr({ "Cash" }, paintAll)
	paintAll()

	local plots = workspace:WaitForChild("Plots")
	for _, d in ipairs(plots:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			filterPrompt(d)
		end
	end
	plots.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			task.defer(filterPrompt, d)
		elseif d:IsA("Model") and d:GetAttribute("BuiltAt") then
			task.defer(buildAnimation, d)
		end
		if d:IsA("Model") then
			task.defer(ambient, d)
		end
	end)
	for _, plot in ipairs(plots:GetChildren()) do
		plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			for _, d in ipairs(plot:GetDescendants()) do
				if d:IsA("ProximityPrompt") then
					filterPrompt(d)
				end
			end
			paintAll()
		end)
	end

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt:GetAttribute("Action") == "OpenMenu" then
			local plot = plotOf(prompt)
			if not plot or plot:GetAttribute("OwnerUserId") == player.UserId then
				WorldFx.openMenu(prompt:GetAttribute("Menu"))
			end
		end
	end)

	State.onAttr({ "Overloaded" }, function()
		setOverload(State.attr("Overloaded") == true)
	end)

	task.spawn(function()
		while true do
			task.wait(1.6)
			incomeFloats()
		end
	end)
end

return WorldFx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Potato Tycoon — точка входа клиента: интерфейс, эффекты, управление

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Client = script.Parent
require(Client.State)
local Toasts = require(Client.UI.Toasts)
local Hud = require(Client.UI.Hud)
local Windows = require(Client.UI.Windows)
local Effects = require(Client.Controllers.Effects)
local Animator = require(Client.Controllers.Animator)
local Beds = require(Client.Controllers.Beds)
local Click = require(Client.Controllers.Click)
local WorldFx = require(Client.Controllers.WorldFx)

Effects.init()
Animator.init()
Beds.init()
Click.init()
WorldFx.init()
Hud.init()
Windows.init()

local function openMenu(name: string)
	if name == "Home" then
		Remotes.get("GoHome"):FireServer()
		return
	end
	Windows.open(name)
end
Hud.onMenu = openMenu
WorldFx.openMenu = openMenu

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
		Windows.close()
	end
end)

-- Чат-тег [VIP] (геймпасс «VIP Фермер»)
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local sender = Players:GetPlayerByUserId(source.UserId)
		if sender and sender:GetAttribute("VIP") then
			props.PrefixText = "<font color='#FFD232'>[VIP]</font> " .. message.PrefixText
		end
	end
	return props
end

Remotes.get("Ready"):FireServer()
Toasts.show(
	"🥔 Добро пожаловать в Potato Tycoon! Поговори с Дедом Матвеем у входа на базу.",
	"tip"
)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Клиентское состояние: данные синхронизации с сервера и атрибуты игрока

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local player = Players.LocalPlayer

local State = {}

State.data = nil :: any
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

function State.attr(name: string): any
	return player:GetAttribute(name)
end

function State.num(name: string): number
	return player:GetAttribute(name) or 0
end

function State.owns(itemId: string): boolean
	return State.data ~= nil and State.data.owned[itemId] == true
end

function State.onAttr(names: { string }, fn: () -> ())
	for _, name in ipairs(names) do
		player:GetAttributeChangedSignal(name):Connect(fn)
	end
end

Remotes.get("Sync").OnClientEvent:Connect(function(data)
	State.data = data
	changed:Fire()
end)

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Верхний HUD-бар (ГДД 192): баланс, прирост $/сек, энергия, звёзды, этап.
-- Плюс цель этапа, таймеры событий, мешок картошки (Этап 1) и боковое меню.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local State = require(script.Parent.Parent.State)

local C = Theme.Colors
local New = Theme.New

local player = Players.LocalPlayer
local GameState = ReplicatedStorage:WaitForChild("GameState")

local Hud = {}

Hud.onMenu = function(_name: string) end

local function pill(parent: Instance, width: number, color: Color3, order: number): (Frame, TextLabel)
	local frame = New("Frame", {
		Size = UDim2.fromOffset(width, 46),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(12), Theme.stroke(color, 2, 0.35) })
	local label = Theme.label({
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -20, 1, -12),
		TextColor3 = color,
		Font = Theme.FontBlack,
		Parent = frame,
	})
	return frame, label
end

function Hud.init()
	local bar = New("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(760, 46),
		BackgroundTransparency = 1,
		Parent = Root.gui,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	local _, cashLabel = pill(bar, 190, C.Cash, 1)
	local incomeFrame, incomeLabel = pill(bar, 150, C.Cash, 2)
	local energyFrame, energyLabel = pill(bar, 170, C.Energy, 3)
	local _, starsLabel = pill(bar, 100, C.Star, 4)
	local _, stageLabel = pill(bar, 110, C.Accent, 5)

	-- клик по доходу открывает разбор формулы
	local incomeButton = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = incomeFrame,
	})
	incomeButton.Activated:Connect(function()
		Hud.onMenu("Stats")
	end)

	local goal = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(700, 22),
		Font = Theme.Font,
		TextColor3 = Color3.fromRGB(255, 240, 200),
		TextStrokeTransparency = 0.4,
		Parent = Root.gui,
	})
	local eventLine = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(700, 26),
		Font = Theme.FontBlack,
		TextColor3 = C.Accent,
		TextStrokeTransparency = 0.3,
		Parent = Root.gui,
	})
	local timers = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 114),
		Size = UDim2.fromOffset(500, 18),
		Font = Theme.FontRegular,
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.5,
		Parent = Root.gui,
	})

	-- мешок картошки (Этап 1)
	local bag = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(340, 58),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		Parent = Root.gui,
	}, { Theme.corner(12), Theme.stroke(C.Accent, 2, 0.4) })
	local bagFill = New("Frame", {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(0, 0, 0, 22),
		BackgroundColor3 = Color3.fromRGB(190, 140, 70),
		Parent = bag,
	}, { Theme.corner(8) })
	local bagLabel = Theme.label({
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 0, 22),
		Font = Theme.FontBlack,
		ZIndex = 2,
		Parent = bag,
	})
	Theme.label({
		Position = UDim2.fromOffset(6, 32),
		Size = UDim2.new(1, -12, 0, 20),
		Font = Theme.FontRegular,
		TextColor3 = C.Muted,
		Text = "Лопатой кликай по созревшим кустам, сдавай урожай скупщику",
		Parent = bag,
	})

	-- боковое меню
	local menu = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(76, 470),
		BackgroundTransparency = 1,
		Parent = Root.gui,
	}, {
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	local MENU = {
		{ "Research", "🧬", "Сорта" },
		{ "Staff", "🤖", "Персонал" },
		{ "StarTech", "⭐", "Звёзды" },
		{ "Rebirth", "🚀", "Rebirth" },
		{ "Shop", "💎", "Магазин" },
		{ "Stats", "📊", "Доход" },
		{ "Home", "🏠", "Домой" },
	}
	for i, entry in ipairs(MENU) do
		local button = Theme.button({
			Size = UDim2.fromOffset(76, 58),
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = 0.1,
			LayoutOrder = i,
			Parent = menu,
		}, function()
			Hud.onMenu(entry[1])
		end)
		Theme.stroke(C.Stroke, 1.5, 0.8).Parent = button
		Theme.label({
			Size = UDim2.new(1, 0, 0.62, 0),
			Text = entry[2],
			Parent = button,
		})
		Theme.label({
			Position = UDim2.fromScale(0, 0.62),
			Size = UDim2.new(1, 0, 0.32, 0),
			Text = entry[3],
			Font = Theme.Font,
			TextColor3 = C.Muted,
			Parent = button,
		})
	end

	local function refresh()
		local cash = State.num("Cash")
		cashLabel.Text = "💰 " .. Format.money(cash)
		local manual = State.attr("Manual") == true
		if manual then
			incomeLabel.Text = "🥔 ручной сбор"
			incomeLabel.TextColor3 = C.Muted
		else
			incomeLabel.Text = "+" .. Format.money(State.num("Income")) .. "/с"
			incomeLabel.TextColor3 = C.Cash
		end
		local gen, use = State.num("EnergyGen"), State.num("EnergyUse")
		local over = State.attr("Overloaded") == true
		energyLabel.Text = string.format("⚡ %s/%s кВт", Format.number(use), Format.number(gen))
		energyLabel.TextColor3 = if over then C.Danger else C.Energy
		local stroke = energyFrame:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if over then C.Danger else C.Energy
		end
		starsLabel.Text = "⭐ " .. Format.number(State.num("Stars"))
		local stage = math.max(1, State.num("Stage"))
		stageLabel.Text = "Этап " .. stage

		local info = Config.Game.Stages[stage]
		local text = if info then "🎯 " .. info.goal else ""
		if over then
			text = "⚠ ПЕРЕГРУЗКА СЕТИ: доход -50%! Купи генератор ⚡"
			goal.TextColor3 = C.Danger
		else
			goal.TextColor3 = Color3.fromRGB(255, 240, 200)
		end
		goal.Text = text

		bag.Visible = manual
		local capacity = math.max(1, State.num("BagCapacity"))
		local count = State.num("Bag")
		bagLabel.Text = string.format("🥔 Мешок: %d / %d", count, capacity)
		bagFill.Size = UDim2.new(math.clamp(count / capacity, 0, 1), -12, 0, 22)
		bagFill.BackgroundColor3 = if count >= capacity then C.Danger else Color3.fromRGB(190, 140, 70)
	end

	State.onAttr(
		{ "Cash", "Income", "EnergyGen", "EnergyUse", "Overloaded", "Stars", "Stage", "Manual", "Bag", "BagCapacity" },
		refresh
	)
	refresh()

	-- таймеры событий
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local now = workspace:GetServerTimeNow()
		local bugsEnd = GameState:GetAttribute("BugsEndsAt") or 0
		local boomEnd = GameState:GetAttribute("BoomEndsAt") or 0
		local lines = {}
		if bugsEnd > now and player:GetAttribute("BugsCaught") ~= nil then
			table.insert(
				lines,
				string.format(
					"🪲 Жуки: %d / %d — %s",
					player:GetAttribute("BugsCaught") or 0,
					Config.Game.Events.Bugs.Goal,
					Format.time(bugsEnd - now)
				)
			)
		end
		if boomEnd > now then
			table.insert(lines, "📈 БУМ НА БИРЖЕ x3 — " .. Format.time(boomEnd - now))
		end
		eventLine.Text = table.concat(lines, "   ")
		local nextBugs = (GameState:GetAttribute("NextBugsAt") or 0) - now
		local nextBoom = (GameState:GetAttribute("NextBoomAt") or 0) - now
		local parts = {}
		if nextBugs > 0 and nextBugs < 7200 then
			table.insert(parts, "🪲 жуки через " .. Format.time(nextBugs))
		end
		if nextBoom > 0 and nextBoom < 7200 then
			table.insert(parts, "📈 бум через " .. Format.time(nextBoom))
		end
		timers.Text = table.concat(parts, "  ·  ")
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[-- Корневой ScreenGui с автоматическим масштабом под размер экрана

local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer

local Root = {}

local gui = Theme.New("ScreenGui", {
	Name = "PotatoUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
})
Root.gui = gui

local scale = Theme.New("UIScale", { Parent = gui })

local function rescale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.25)
end

rescale()
local function watchCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	rescale()
end
watchCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)

-- Слой для полноэкранных эффектов (конфетти, баннеры)
Root.fx = Theme.New("Frame", {
	Name = "Fx",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 50,
	Parent = gui,
})

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Оформление интерфейса и помощники для создания элементов

local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(28, 32, 42),
	PanelLight = Color3.fromRGB(42, 48, 62),
	Card = Color3.fromRGB(50, 57, 74),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(245, 245, 250),
	Muted = Color3.fromRGB(170, 178, 195),
	Cash = Color3.fromRGB(120, 230, 110),
	Gold = Color3.fromRGB(255, 205, 60),
	Star = Color3.fromRGB(255, 225, 90),
	Energy = Color3.fromRGB(90, 200, 255),
	Danger = Color3.fromRGB(240, 80, 70),
	Accent = Color3.fromRGB(255, 160, 50),
	Button = Color3.fromRGB(70, 175, 90),
	ButtonOff = Color3.fromRGB(85, 90, 105),
	Purple = Color3.fromRGB(165, 110, 255),
}

Theme.Font = Enum.Font.GothamBold
Theme.FontBlack = Enum.Font.GothamBlack
Theme.FontRegular = Enum.Font.Gotham

-- New("Frame", {props}, {children})
function Theme.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	return Theme.New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Theme.New("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Theme.New("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u })
end

function Theme.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Theme.New("TextLabel", defaults)
end

function Theme.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local defaults = {
		BackgroundColor3 = Theme.Colors.Button,
		Font = Theme.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local button = Theme.New("TextButton", defaults, { Theme.corner(8) })
	button.Activated:Connect(onClick)
	return button
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- Всплывающие уведомления в правом нижнем углу

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local C = Theme.Colors

local Toasts = {}

local KIND_COLORS = {
	info = C.PanelLight,
	success = Color3.fromRGB(45, 120, 60),
	error = Color3.fromRGB(150, 45, 45),
	gold = Color3.fromRGB(150, 110, 20),
	stage = Color3.fromRGB(110, 60, 170),
	event = Color3.fromRGB(190, 95, 20),
	tip = Color3.fromRGB(60, 95, 140),
}

local holder = Theme.New("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -16),
	Size = UDim2.fromOffset(360, 420),
	BackgroundTransparency = 1,
	Parent = Root.gui,
}, {
	Theme.New("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
	}),
})

local order = 0
local recent: { [string]: number } = {}

function Toasts.show(text: string, kind: string?)
	-- одинаковые сообщения не дублируем чаще раза в 2 секунды
	local key = text
	if recent[key] and os.clock() - recent[key] < 2 then
		return
	end
	recent[key] = os.clock()

	order += 1
	local long = #text > 70 or kind == "tip" or kind == "event"
	local toast = Theme.New("Frame", {
		BackgroundColor3 = KIND_COLORS[kind or "info"] or C.PanelLight,
		BackgroundTransparency = 0.08,
		Size = UDim2.fromOffset(360, if long then 74 else 46),
		LayoutOrder = order,
		Parent = holder,
	}, {
		Theme.corner(10),
		Theme.stroke(nil, 1.5, 0.8),
		Theme.padding(8),
		Theme.label({
			Size = UDim2.fromScale(1, 1),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			TextScaled = true,
		}),
	})
	local label = toast:FindFirstChildOfClass("TextLabel")
	if label then
		Theme.New("UITextSizeConstraint", { MaxTextSize = 17, Parent = label })
	end
	if kind == "error" then
		Sound.play("Error")
	end
	local children = holder:GetChildren()
	local frames = {}
	for _, c in ipairs(children) do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames > 6 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	local life = if long then 6 else 3.5
	task.delay(life, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			tween:Play()
			for _, d in ipairs(toast:GetDescendants()) do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				end
			end
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

Remotes.get("Notify").OnClientEvent:Connect(function(text: string, kind: string)
	Toasts.show(text, kind)
end)

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[-- Окна меню: исследования семян (ГДД 193), найм персонала и дронов (194), подтверждение Rebirth (195),
-- звёздные технологии, магазин геймпассов, разбор дохода и отчёт об офлайн-доходе

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local State = require(script.Parent.Parent.State)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local C = Theme.Colors
local New = Theme.New

local player = Players.LocalPlayer
local GameState = ReplicatedStorage:WaitForChild("GameState")

local Windows = {}

type Def = { title: string, icon: string, render: (ScrollingFrame) -> (), signature: (() -> string)? }

local current: { name: string, frame: Frame, list: ScrollingFrame, signature: string? }? = nil
local defs: { [string]: Def } = {}

-- Профиль-«тень» для расчёта цен на клиенте (те же формулы, что на сервере)
local function shadowProfile()
	local d = State.data
	if not d then
		return nil
	end
	return {
		cash = State.num("Cash"),
		owned = d.owned,
		varieties = d.varieties,
		activeVariety = d.activeVariety,
		staff = d.staff,
		starTech = d.starTech,
		rebirths = d.rebirths,
		stars = State.num("Stars"),
	}
end

local function itemName(id: string): string
	local item = Config.Items.ById[id]
	return if item then item.name else id
end

------------------------------------------------------------------
-- Компоненты
------------------------------------------------------------------
local function header(list: Instance, text: string, order: number)
	Theme.label({
		Size = UDim2.new(1, -8, 0, 30),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Gold,
		LayoutOrder = order,
		Parent = list,
	})
end

local function card(
	list: Instance,
	order: number,
	opts: {
		icon: string,
		iconColor: Color3?,
		title: string,
		subtitle: string,
		button: string?,
		buttonColor: Color3?,
		onClick: (() -> ())?,
		height: number?,
	}
)
	local frame = New("Frame", {
		Size = UDim2.new(1, -8, 0, opts.height or 78),
		BackgroundColor3 = C.Card,
		LayoutOrder = order,
		Parent = list,
	}, { Theme.corner(10) })
	New("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = opts.iconColor or C.PanelLight,
		Parent = frame,
	}, {
		Theme.corner(10),
		Theme.label({ Size = UDim2.fromScale(1, 1), Text = opts.icon }),
	})
	Theme.label({
		Position = UDim2.fromOffset(80, 8),
		Size = UDim2.new(1, -250, 0, 24),
		Text = opts.title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local sub = Theme.label({
		Position = UDim2.fromOffset(80, 34),
		Size = UDim2.new(1, -250, 0, 38),
		Text = opts.subtitle,
		Font = Theme.FontRegular,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Parent = frame,
	})
	New("UITextSizeConstraint", { MaxTextSize = 15, Parent = sub })
	if opts.button then
		local enabled = opts.onClick ~= nil
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(158, 44),
			BackgroundColor3 = opts.buttonColor or (if enabled then C.Button else C.ButtonOff),
			AutoButtonColor = enabled,
			Text = opts.button,
			Parent = frame,
		}, function()
			if opts.onClick then
				Sound.play("Click")
				opts.onClick()
			end
		end)
		Theme.padding(6).Parent = button
	end
	return frame
end

local function line(list: Instance, order: number, left: string, right: string, color: Color3?)
	local frame = New("Frame", {
		Size = UDim2.new(1, -8, 0, 32),
		BackgroundColor3 = C.Card,
		LayoutOrder = order,
		Parent = list,
	}, { Theme.corner(8) })
	Theme.label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(0.62, -12, 1, -8),
		Text = left,
		Font = Theme.FontRegular,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.new(0.62, 0, 0, 4),
		Size = UDim2.new(0.38, -12, 1, -8),
		Text = right,
		TextColor3 = color or C.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
end

------------------------------------------------------------------
-- Исследования семян
------------------------------------------------------------------
defs.Research = {
	title = "Исследования семян",
	icon = "🧬",
	signature = function()
		local p = shadowProfile()
		if not p then
			return ""
		end
		local parts = {}
		for _, v in ipairs(Config.Varieties) do
			table.insert(parts, if p.cash >= Economy.varietyCost(v, p, Config) then "1" else "0")
		end
		return table.concat(parts)
	end,
	render = function(list)
		local p = shadowProfile()
		if not p then
			return
		end
		local active = Economy.activeVariety(p, Config)
		header(
			list,
			"Сейчас растёт: "
				.. active.name
				.. (if p.activeVariety then "" else " (авто: самый выгодный)"),
			0
		)
		if p.activeVariety then
			card(list, 1, {
				icon = "⚙",
				title = "Автовыбор сорта",
				subtitle = "Всегда сажать самый доходный из открытых сортов",
				button = "Включить авто",
				onClick = function()
					Remotes.get("SelectVariety"):FireServer(nil)
				end,
			})
		end
		local wild = Config.Varieties[1]
		for i, v in ipairs(Config.Varieties) do
			local color = Color3.fromRGB(v.color[1], v.color[2], v.color[3])
			local value = v.price * v.growth / (wild.price * wild.growth)
			local subtitle = string.format(
				"Урожайность %s · Доход с поля ×%s к дикому",
				Format.percent(v.growth),
				Format.number(value)
			)
			local opts: any = {
				icon = "🥔",
				iconColor = color,
				title = string.format("%s — $%s/кг", v.name, Format.number(v.price)),
				subtitle = subtitle,
			}
			if p.varieties[v.id] then
				if active.id == v.id then
					opts.button = "✓ Растёт"
					opts.buttonColor = Color3.fromRGB(150, 110, 20)
				else
					opts.button = "Посадить"
					opts.buttonColor = C.Energy
					opts.onClick = function()
						Remotes.get("SelectVariety"):FireServer(v.id)
					end
				end
			elseif v.requires and not p.owned[v.requires] then
				opts.subtitle = subtitle .. "\n🔒 Нужно построить: " .. itemName(v.requires)
				opts.button = "🔒 Закрыто"
				opts.buttonColor = Color3.fromRGB(120, 50, 50)
			else
				local cost = Economy.varietyCost(v, p, Config)
				opts.button = "Исследовать " .. Format.money(cost)
				if p.cash >= cost then
					opts.onClick = function()
						Remotes.get("BuyResearch"):FireServer(v.id)
					end
				end
			end
			card(list, i + 1, opts)
		end
	end,
}

------------------------------------------------------------------
-- Персонал и дроны
------------------------------------------------------------------
local VISUAL_ICON = { Drone = "🚁", Robot = "🤖", Npc = "👷" }

local function staffEffect(s): string
	local parts = {}
	if s.yieldBoost then
		table.insert(parts, "+" .. Format.percent(s.yieldBoost) .. " к урожаю")
	end
	if s.factoryAdd then
		table.insert(parts, "+" .. s.factoryAdd .. " к множителю цехов")
	end
	if s.factoryBoost then
		table.insert(parts, "+" .. Format.percent(s.factoryBoost) .. " к множителю цехов")
	end
	if s.powerGen then
		table.insert(parts, "+" .. s.powerGen .. " кВт")
	end
	if s.powerBoost then
		table.insert(parts, "+" .. Format.percent(s.powerBoost) .. " к генерации")
	end
	if s.incomeBoost then
		table.insert(parts, "+" .. Format.percent(s.incomeBoost) .. " к доходу")
	end
	if s.priceBoost then
		table.insert(parts, "+" .. Format.percent(s.priceBoost) .. " к цене картофеля")
	end
	if s.bugBoost then
		table.insert(parts, "+" .. Format.percent(s.bugBoost) .. " к награде за жуков")
	end
	return table.concat(parts, ", ") .. " за единицу"
end

defs.Staff = {
	title = "Найм персонала и дронов",
	icon = "🤖",
	signature = function()
		local p = shadowProfile()
		if not p then
			return ""
		end
		local parts = {}
		for _, st in ipairs(Config.Staff.List) do
			table.insert(parts, if p.cash >= Economy.staffCost(st, p, Config) then "1" else "0")
		end
		return table.concat(parts)
	end,
	render = function(list)
		local p = shadowProfile()
		if not p then
			return
		end
		local passes = State.data.passes or {}
		for i, s in ipairs(Config.Staff.List) do
			local count = p.staff[s.id] or 0
			local opts: any = {
				icon = VISUAL_ICON[s.visual] or "👷",
				title = string.format("%s  (%d/%d)", s.name, count, s.max),
				subtitle = staffEffect(s),
			}
			if count >= s.max then
				opts.button = "✓ Максимум"
				opts.buttonColor = Color3.fromRGB(150, 110, 20)
			elseif not p.owned[s.requires] then
				opts.subtitle ..= "\n🔒 Нужно построить: " .. itemName(s.requires)
				opts.button = "🔒 Закрыто"
				opts.buttonColor = Color3.fromRGB(120, 50, 50)
			elseif s.requiresPass and not passes[s.requiresPass] then
				opts.subtitle ..= "\n👑 Только для VIP Фермеров"
				opts.button = "👑 VIP"
				opts.buttonColor = Color3.fromRGB(150, 110, 20)
				opts.onClick = function()
					Remotes.get("BuyPass"):FireServer(s.requiresPass)
				end
			else
				local cost = Economy.staffCost(s, p, Config)
				opts.button = "Нанять " .. Format.money(cost)
				if p.cash >= cost then
					opts.onClick = function()
						Remotes.get("HireStaff"):FireServer(s.id)
					end
				end
			end
			card(list, i, opts)
		end
	end,
}

------------------------------------------------------------------
-- Звёздные технологии
------------------------------------------------------------------
defs.StarTech = {
	title = "Древо звёздных технологий",
	icon = "⭐",
	signature = function()
		return tostring(State.num("Stars"))
	end,
	render = function(list)
		local p = shadowProfile()
		if not p then
			return
		end
		header(
			list,
			string.format(
				"У тебя ⭐ %s Картофельных Звезд (даются за Rebirth)",
				Format.number(p.stars)
			),
			0
		)
		for i, t in ipairs(Config.StarTech.List) do
			local level = p.starTech[t.id] or 0
			local opts: any = {
				icon = "⭐",
				iconColor = Color3.fromRGB(110, 80, 20),
				title = string.format("%s  (ур. %d/%d)", t.name, level, t.max),
				subtitle = t.desc,
			}
			if level >= t.max then
				opts.button = "✓ MAX"
				opts.buttonColor = Color3.fromRGB(150, 110, 20)
			else
				local cost = Config.StarTech.CostOf(t, level)
				opts.button = "⭐ " .. Format.number(cost)
				if p.stars >= cost then
					opts.buttonColor = Color3.fromRGB(170, 120, 20)
					opts.onClick = function()
						Remotes.get("BuyStarTech"):FireServer(t.id)
					end
				end
			end
			card(list, i, opts)
		end
	end,
}

------------------------------------------------------------------
-- Rebirth
------------------------------------------------------------------
defs.Rebirth = {
	title = "Подтверждение Rebirth",
	icon = "🚀",
	signature = function()
		local d = State.data
		return if d and State.num("Cash") >= d.rebirthCost then "1" else "0"
	end,
	render = function(list)
		local d = State.data
		if not d then
			return
		end
		local cash = State.num("Cash")
		local hasShuttle = d.owned.shuttle == true
		local enough = cash >= d.rebirthCost
		header(list, string.format("Rebirth #%d", d.rebirths + 1), 0)
		line(
			list,
			1,
			"Множитель всех доходов",
			string.format("x%s → x%s", Format.number(State.num("RebirthMult")), Format.number(d.nextMult)),
			C.Gold
		)
		line(list, 2, "Картофельные Звезды", "+" .. Format.number(d.nextStars) .. " ⭐", C.Star)
		line(list, 3, "Нужно накопить", Format.money(d.rebirthCost), if enough then C.Cash else C.Danger)
		line(
			list,
			4,
			"Экспортный шаттл «Галактический Картофель»",
			if hasShuttle then "✓ построен" else "✗ не построен",
			if hasShuttle then C.Cash else C.Danger
		)
		local warn = Theme.label({
			Size = UDim2.new(1, -8, 0, 54),
			Text = "Сбросятся: деньги, постройки, сорта и персонал.\nОстанутся: Звёзды, звёздные технологии и множитель Rebirth.",
			Font = Theme.FontRegular,
			TextColor3 = C.Muted,
			TextWrapped = true,
			LayoutOrder = 5,
			Parent = list,
		})
		New("UITextSizeConstraint", { MaxTextSize = 16, Parent = warn })
		local ready = hasShuttle and enough
		local button = Theme.button({
			Size = UDim2.new(1, -8, 0, 56),
			BackgroundColor3 = if ready then C.Purple else C.ButtonOff,
			AutoButtonColor = ready,
			Text = if ready then "🚀 ЗАПУСТИТЬ REBIRTH" else "🔒 Условия не выполнены",
			LayoutOrder = 6,
			Parent = list,
		}, function()
			if ready then
				Remotes.get("Rebirth"):FireServer()
				Windows.close()
			end
		end)
		Theme.padding(10).Parent = button
	end,
}

------------------------------------------------------------------
-- Магазин геймпассов
------------------------------------------------------------------
defs.Shop = {
	title = "Магазин",
	icon = "💎",
	signature = function()
		return ""
	end,
	render = function(list)
		local passes = (State.data and State.data.passes) or {}
		for i, pass in ipairs(Config.GamePasses.List) do
			local owned = passes[pass.key] == true
			local price = GameState:GetAttribute("PassPrice_" .. pass.key)
			card(list, i, {
				icon = pass.icon,
				iconColor = Color3.fromRGB(110, 80, 20),
				title = pass.name,
				subtitle = pass.desc,
				button = if owned then "✓ Куплено" else (if price then "R$ " .. price else "Купить"),
				buttonColor = if owned then Color3.fromRGB(150, 110, 20) else Color3.fromRGB(0, 160, 90),
				onClick = if owned
					then nil
					else function()
						if pass.id > 0 then
							MarketplaceService:PromptGamePassPurchase(player, pass.id)
						else
							Remotes.get("BuyPass"):FireServer(pass.key)
						end
					end,
			})
		end
	end,
}

------------------------------------------------------------------
-- Разбор дохода по формуле ГДД 2.1
------------------------------------------------------------------
defs.Stats = {
	title = "Доход фабрики",
	icon = "📊",
	render = function(list)
		local d = State.data
		if not d then
			return
		end
		local variety
		for _, v in ipairs(Config.Varieties) do
			if v.id == State.attr("Variety") then
				variety = v
			end
		end
		local s = d.stats
		header(
			list,
			"Доход = Урожай × Цена × Цеха × Энергия × Rebirth × Бонусы",
			0
		)
		line(
			list,
			1,
			string.format(
				"🌱 Урожай (%d полей, бонус +%s, сорт %s)",
				s.plots,
				Format.percent(s.yieldBoost),
				if variety then Format.percent(variety.growth) else "?"
			),
			Format.mass(State.num("YieldKg")) .. "/с"
		)
		line(
			list,
			2,
			"🥔 Цена сорта «" .. (if variety then variety.name else "?") .. "»",
			Format.money(State.num("Price")) .. "/кг"
		)
		line(
			list,
			3,
			"🏭 Суммарный множитель цехов",
			"x" .. Format.number(State.num("FactoryMult"))
		)
		local over = State.attr("Overloaded") == true
		line(
			list,
			4,
			string.format(
				"⚡ Энергия %s / %s кВт",
				Format.number(State.num("EnergyUse")),
				Format.number(State.num("EnergyGen"))
			),
			if over then "x0.5 ПЕРЕГРУЗКА" else "x1",
			if over then C.Danger else C.Energy
		)
		line(list, 5, "🚀 Множитель Rebirth", "x" .. Format.number(State.num("RebirthMult")), C.Gold)
		line(
			list,
			6,
			"🎁 Бонусы (постройки, персонал, звёзды, геймпассы, бум)",
			"x" .. string.format("%.2f", State.num("BonusMult"))
		)
		line(list, 7, "💰 Итого", "+" .. Format.money(State.num("Income")) .. "/с", C.Cash)
		header(list, "Статистика", 8)
		line(list, 9, "Всего заработано", Format.money(d.totalEarned or 0))
		line(list, 10, "Всего собрано картофеля", Format.mass(State.num("TotalKg")))
		line(
			list,
			11,
			"Офлайн-доход",
			string.format("%s дохода до %d ч", Format.percent(s.offlineRate), s.offlineHours)
		)
		line(list, 12, "Rebirth", tostring(d.rebirths))
	end,
}

------------------------------------------------------------------
-- Каркас окна
------------------------------------------------------------------
function Windows.close()
	if current then
		current.frame:Destroy()
		current = nil
	end
end

function Windows.refresh()
	if not current then
		return
	end
	local signature = defs[current.name].signature
	current.signature = if signature then signature() else nil
	local list = current.list
	for _, child in ipairs(list:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	defs[current.name].render(list)
end

function Windows.open(name: string)
	if current and current.name == name then
		Windows.close()
		return
	end
	Windows.close()
	local def = defs[name]
	if not def then
		return
	end
	local frame = New("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(700, 500),
		BackgroundColor3 = C.Panel,
		ZIndex = 20,
		Parent = Root.gui,
	}, { Theme.corner(16), Theme.stroke(C.Stroke, 2, 0.75) })
	Theme.label({
		Position = UDim2.fromOffset(18, 10),
		Size = UDim2.new(1, -90, 0, 38),
		Text = def.icon .. "  " .. def.title,
		Font = Theme.FontBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = C.Danger,
		Text = "✕",
		Parent = frame,
	}, Windows.close)
	local list = New("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -24, 1, -70),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, {
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
	current = { name = name, frame = frame, list = list }
	local scale = New("UIScale", { Scale = 0.85, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()
	Sound.play("Click")
	Windows.refresh()
end

-- Отчёт об офлайн-доходе
function Windows.offline(seconds: number, amount: number)
	local frame = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(460, 220),
		BackgroundColor3 = C.Panel,
		ZIndex = 30,
		Parent = Root.gui,
	}, { Theme.corner(16), Theme.stroke(C.Gold, 2, 0.4) })
	Theme.label({
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 0, 40),
		Text = "🌙 С возвращением, магнат!",
		Font = Theme.FontBlack,
		TextColor3 = C.Gold,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(16, 62),
		Size = UDim2.new(1, -32, 0, 70),
		Text = string.format(
			"Пока тебя не было (%s), ферма заработала\n%s",
			Format.time(seconds),
			Format.money(amount)
		),
		TextWrapped = true,
		Parent = frame,
	})
	Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(200, 48),
		Text = "Забрать",
		Parent = frame,
	}, function()
		Sound.play("Cash")
		frame:Destroy()
	end)
end

function Windows.init()
	local pending = false
	local function schedule(force: boolean)
		if pending or not current then
			return
		end
		-- при изменении денег перерисовываем, только если сменилась доступность кнопок
		local signature = defs[current.name].signature
		if not force and signature and signature() == current.signature then
			return
		end
		pending = true
		task.delay(0.25, function()
			pending = false
			Windows.refresh()
		end)
	end
	State.Changed:Connect(function()
		schedule(true)
	end)
	State.onAttr({ "Cash", "Stars", "Income", "Overloaded" }, function()
		schedule(false)
	end)
	Remotes.get("Offline").OnClientEvent:Connect(function(data)
		Windows.offline(data.seconds, data.amount)
	end)
end

return Windows
