        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Staff</string>
            <string name="Source"><![CDATA[-- Меню найма персонала и дронов (ГДД: ассет 194, категория 5).
-- cost — цена первого найма, каждый следующий дороже в growth раз; max — сколько можно нанять.
-- Эффекты за одну единицу:
--   yieldBoost   — +доля к урожаю
--   factoryAdd   — +к суммарному множителю цехов
--   factoryBoost — +доля к множителю цехов
--   powerGen     — +кВт генерации
--   powerBoost   — +доля к генерации
--   incomeBoost  — +доля к доходу
--   priceBoost   — +доля к цене продажи
--   bugBoost     — +доля к награде за «Нашествие жуков»
-- visual: Drone / Robot / Npc — как сотрудник выглядит на базе.

local Staff = {
	{
		id = "robo_inspector",
		name = "Робот-инспектор целостности грядок",
