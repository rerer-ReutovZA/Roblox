      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Экономика и формулы (ГДД, раздел 2). «Чистый» модуль: конфиг передаётся параметром,
-- поэтому те же формулы использует и сервер, и клиент, и симулятор баланса (tools/simulate.luau).
--
-- Доход ($/сек) = Урожай (кг/сек) * Цена сорта * Суммарный множитель цехов
--                 * Энергоэффективность * Множитель Rebirth * Бонусы

local Economy = {}

export type Passes = {
	x2cash: boolean?,
	infiniteEnergy: boolean?,
	magnateDrone: boolean?,
	vip: boolean?,
}

export type Context = {
	passes: Passes?,
	boom: boolean?,
}

local function starLevel(profile, id: string): number
	return (profile.starTech and profile.starTech[id]) or 0
end

local function starValue(profile, Config, id: string): number
	local tech = Config.StarTech.ById[id]
	return starLevel(profile, id) * tech.perLevel
end

function Economy.owns(profile, itemId: string): boolean
	return profile.owned[itemId] == true
end

function Economy.isManual(profile): boolean
	return profile.owned.tower ~= true
end

function Economy.stage(profile, Config): number
	local stage = 1
	for _, milestone in ipairs(Config.Items.StageMilestones) do
		if profile.owned[milestone.item] then
			stage = math.max(stage, milestone.stage)
		end
	end
	return stage
end

function Economy.rebirthMultiplier(rebirths: number, Config): number
	return Config.Game.Rebirth.MultiplierBase ^ rebirths
end

function Economy.rebirthCost(rebirths: number, Config): number
	local r = Config.Game.Rebirth
	return r.BaseCost * r.CostGrowth ^ rebirths
end

-- Сколько звёзд даст Rebirth с номером n (1, 2, 3...)
function Economy.rebirthStars(n: number, Config): number
	local r = Config.Game.Rebirth
	if r.Stars[n] then
		return r.Stars[n]
	end
	local last = r.Stars[#r.Stars]
	return math.floor(last * r.StarsGrowth ^ (n - #r.Stars))
end

function Economy.discount(profile, Config): number
	return math.clamp(starValue(profile, Config, "discount"), 0, 0.9)
end

function Economy.itemCost(item, profile, Config): number
	return math.floor(item.cost * (1 - Economy.discount(profile, Config)))
end

function Economy.varietyCost(variety, profile, Config): number
	return math.floor(variety.cost * (1 - Economy.discount(profile, Config)))
end

function Economy.staffCost(staff, profile, Config): number
	local owned = (profile.staff and profile.staff[staff.id]) or 0
	return math.floor(Config.Staff.CostOf(staff, owned) * (1 - Economy.discount(profile, Config)))
end

-- Сорт, который сейчас растёт на полях: выбранный игроком или самый выгодный из открытых
function Economy.activeVariety(profile, Config)
	local chosen = profile.activeVariety
	if chosen and profile.varieties[chosen] then
		for _, v in ipairs(Config.Varieties) do
			if v.id == chosen then
				return v
			end
		end
	end
	local best = Config.Varieties[1]
	for _, v in ipairs(Config.Varieties) do
		if profile.varieties[v.id] and v.price * v.growth > best.price * best.growth then
			best = v
		end
	end
	return best
end

function Economy.compute(profile, ctx: Context?, Config)
	local passes: Passes = (ctx and ctx.passes) or {}
	local boom = (ctx and ctx.boom) == true
	local manual = Economy.isManual(profile)

	local baseYield = 0
	local yieldBoost = 0
	local multSum = 0
	local factoryBoost = 0
	local gen = 0
	local use = 0
	local powerBoost = 0
	local incomeBoost = 0
	local priceBoost = 0
	local bugBoost = 0
	local plots = 0

	for _, item in ipairs(Config.Items.List) do
		if profile.owned[item.id] then
			if item.yield and not manual then
				baseYield += item.yield
				plots += 1
			end
			yieldBoost += item.boost or 0
			multSum += item.mult or 0
			local power = item.power or 0
			if power > 0 then
				gen += power
			else
				use -= power
			end
			powerBoost += item.powerBoost or 0
			incomeBoost += item.incomeBoost or 0
		end
	end

	for _, s in ipairs(Config.Staff.List) do
		local count = (profile.staff and profile.staff[s.id]) or 0
		if count > 0 then
			yieldBoost += (s.yieldBoost or 0) * count
			multSum += (s.factoryAdd or 0) * count
			factoryBoost += (s.factoryBoost or 0) * count
			gen += (s.powerGen or 0) * count
			powerBoost += (s.powerBoost or 0) * count
			incomeBoost += (s.incomeBoost or 0) * count
			priceBoost += (s.priceBoost or 0) * count
			bugBoost += (s.bugBoost or 0) * count
		end
	end

	local variety = Economy.activeVariety(profile, Config)
	local energyGen = gen * (1 + powerBoost)
	local energyUse = use * (1 - math.clamp(starValue(profile, Config, "energy_saver"), 0, 0.9))
	local overloaded = energyUse > energyGen + 1e-6 and not passes.infiniteEnergy
	local energyFactor = if overloaded then Config.Game.Energy.OverloadFactor else 1

	local factoryMult = math.max(1, multSum) * (1 + factoryBoost)
	local rebirthMult = Economy.rebirthMultiplier(profile.rebirths or 0, Config)

	local bonusNoEvent = (1 + incomeBoost)
		* (1 + starValue(profile, Config, "star_income"))
		* (if passes.x2cash then 2 else 1)
		* (if passes.vip then 1.25 else 1)
	local eventMult = if boom then Config.Game.Events.Boom.Multiplier else 1

	local yieldKg = baseYield * (1 + yieldBoost) * variety.growth
	local price = variety.price * (1 + priceBoost)
	local incomeNoEvent = yieldKg * price * factoryMult * energyFactor * rebirthMult * bonusNoEvent

	local m = Config.Game.Manual
	local ripen = if profile.owned.upg_watering_can then m.RipenTimeWatered else m.RipenTime
	ripen *= 1 - math.clamp(starValue(profile, Config, "quick_hands"), 0, 0.9)
	if passes.vip then
		ripen /= 1.25
	end

	return {
		stage = Economy.stage(profile, Config),
		manual = manual,
		plots = plots,
		baseYield = baseYield,
		yieldBoost = yieldBoost,
		yieldKg = yieldKg,
		variety = variety,
		price = price,
		factoryMult = factoryMult,
		energyGen = energyGen,
		energyUse = energyUse,
		overloaded = overloaded,
		energyFactor = energyFactor,
		rebirthMult = rebirthMult,
		bonusMult = bonusNoEvent * eventMult,
		bugBoost = bugBoost,
		incomePerSec = incomeNoEvent * eventMult,
		incomeNoEvent = incomeNoEvent,
		manualPrice = m.PricePerPotato * rebirthMult * bonusNoEvent * eventMult,
		ripenTime = ripen,
		bagCapacity = if profile.owned.upg_bag_xl then m.BagCapacityXL else m.BagCapacity,
		offlineRate = math.min(1, Config.Game.Offline.BaseRate + starValue(profile, Config, "offline_rate")),
		offlineHours = Config.Game.Offline.BaseHours + starValue(profile, Config, "offline_hours"),
	}
end

-- Можно ли купить постройку (без учёта денег)
function Economy.requirementsMet(item, profile): boolean
	if item.requires then
		for _, req in ipairs(item.requires) do
			if not profile.owned[req] then
				return false
			end
		end
	end
	return true
end

function Economy.newProfile(Config)
	local profile = {
		version = 1,
		cash = Config.Game.StartCash,
		stars = 0,
		rebirths = 0,
		owned = {},
		varieties = { wild = true },
		activeVariety = nil,
		staff = {},
		starTech = {},
		bag = 0,
		totalEarned = 0,
		totalKg = 0,
		lastOnline = 0,
		lastIncome = 0,
		bugEventsWon = 0,
	}
	Economy.applyPrebuilt(profile, Config)
	return profile
end

function Economy.applyPrebuilt(profile, Config)
	for _, item in ipairs(Config.Items.List) do
		if item.prebuilt and (profile.rebirths or 0) >= (item.minRebirths or 0) then
			profile.owned[item.id] = true
		end
	end
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Форматирование чисел и времени для интерфейса

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local text
	if i == 1 then
		text = if n >= 100 or n == math.floor(n) then string.format("%d", math.floor(n)) else string.format("%.1f", n)
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[i])
	elseif n >= 10 then
		text = string.format("%.1f%s", math.floor(n * 10) / 10, SUFFIXES[i])
	else
		text = string.format("%.2f%s", math.floor(n * 100) / 100, SUFFIXES[i])
	end
	return (if negative then "-" else "") .. text
end

function Format.money(n: number): string
	return "$" .. Format.number(n)
end

-- Масса: граммы, килограммы, тонны
function Format.mass(kg: number): string
	if kg < 1 then
		return string.format("%d г", math.floor(kg * 1000 + 0.5))
	elseif kg < 1000 then
		return string.format("%.1f кг", kg)
	end
	return Format.number(kg / 1000) .. " т"
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Format.percent(x: number): string
	local p = x * 100
	if p >= 10 then
		return string.format("%d%%", math.floor(p + 0.5))
	elseif p >= 1 then
		return string.format("%.1f%%", p)
	elseif p >= 0.1 then
		return string.format("%.2f%%", p)
	end
	return string.format("%.3f%%", p)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Сетевые события. Сервер создаёт их, клиент ждёт.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	-- сервер → клиент
	"Sync", -- полное состояние игрока (постройки, сорта, персонал, технологии)
	"Notify", -- всплывающее сообщение
	"Effect", -- визуальные/звуковые эффекты
	"Offline", -- отчёт об офлайн-доходе
	-- клиент → сервер
	"Dig", -- копнуть грядку лопатой
	"ClickBug", -- клик по жуку
	"BuyResearch",
	"SelectVariety",
	"HireStaff",
	"BuyStarTech",
	"Rebirth",
	"GoHome",
	"BuyPass",
	"Ready", -- клиент загрузил интерфейс
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.get(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Potato Tycoon — точка входа сервера: мир, сервисы, жизненный цикл игроков, сохранения

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- общее состояние событий (таймеры) для клиентов
local gameState = Instance.new("Folder")
gameState.Name = "GameState"
gameState.Parent = ReplicatedStorage

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local World = require(script.Parent.World.WorldBuilder)
local Services = script.Parent.Services
local DataService = require(Services.DataService)
local Sessions = require(Services.Sessions)
local PlotService = require(Services.PlotService)
local ManualFarm = require(Services.ManualFarm)
local PurchaseService = require(Services.PurchaseService)
local IncomeService = require(Services.IncomeService)
local EventService = require(Services.EventService)
local RebirthService = require(Services.RebirthService)
local PassService = require(Services.PassService)

type Session = Sessions.Session

World.build()
ManualFarm.init()
PurchaseService.init()
IncomeService.init()
EventService.init()
RebirthService.init()
PassService.init()

local function save(session: Session)
	local profile = session.profile
	profile.lastOnline = os.time()
	if session.stats then
		profile.lastIncome = if session.stats.manual then 0 else session.stats.incomeNoEvent
	end
	DataService.save(session.player, profile, session.persistent)
end

RebirthService.onRebirth = function(session)
	task.spawn(save, session)
end

local function createLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Деньги"
	cash.Value = "$0"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirth"
	rebirths.Parent = stats
	stats.Parent = player
end

-- Офлайн-прогресс: 50% дохода до 3 часов (прокачивается звёздами до 100% и 8 часов)
local function applyOffline(session: Session)
	local profile = session.profile
	if profile.lastOnline <= 0 or profile.lastIncome <= 0 then
		return
	end
	local stats = session.stats
	local elapsed = math.clamp(os.time() - profile.lastOnline, 0, stats.offlineHours * 3600)
	if elapsed < Config.Game.Offline.MinSeconds then
		return
	end
	local amount = elapsed * profile.lastIncome * stats.offlineRate
	Sessions.addCash(session, amount)
	session.pendingOffline = { seconds = elapsed, amount = amount }
end

local function onCharacter(session: Session, character: Model)
	task.defer(function()
		if session.plot and character.Parent then
			character:WaitForChild("HumanoidRootPart", 10)
			character:PivotTo(session.plot.spawn)
		end
		PassService.applyCharacter(session, character)
	end)
end

local readyPlayers: { [Player]: boolean } = {}
local deliver: (Session) -> ()

local function onPlayerAdded(player: Player)
	createLeaderstats(player)
	local profile, persistent = DataService.load(player)
	if player.Parent == nil then
		return
	end
	if RunService:IsStudio() and Config.Game.Debug.StartCash > 0 then
		profile.cash = math.max(profile.cash, Config.Game.Debug.StartCash)
	end
	local session = Sessions.create(player, profile, persistent)
	PassService.load(session)
	if not persistent then
		Sessions.notify(
			player,
			"Сохранения недоступны — прогресс этой сессии не сохранится",
			"error"
		)
	end

	Sessions.recompute(session)
	applyOffline(session)
	if PlotService.assign(session) then
		PlotService.buildAll(session)
		ManualFarm.setupBeds(session)
	else
		Sessions.notify(
			player,
			"Все базы заняты — подожди, пока освободится место",
			"error"
		)
	end
	Sessions.recompute(session)
	session.loaded = true

	player.CharacterAdded:Connect(function(character)
		onCharacter(session, character)
		-- лопата из StarterGear выдаётся автоматически при возрождении
	end)
	if player.Character then
		onCharacter(session, player.Character)
	end
	ManualFarm.giveShovel(session)
	-- клиент мог прислать Ready раньше, чем загрузился профиль
	if readyPlayers[player] then
		session.clientReady = true
		deliver(session)
	end
end

-- клиент построил интерфейс: отправляем состояние и отчёт об офлайн-доходе
function deliver(session: Session)
	Sessions.sync(session)
	if session.pendingOffline then
		Remotes.get("Offline"):FireClient(session.player, session.pendingOffline)
		session.pendingOffline = nil
	end
end

local function onReady(player: Player)
	readyPlayers[player] = true
	local session = Sessions.get(player)
	if session then
		session.clientReady = true
		if session.loaded then
			deliver(session)
		end
	end
end

local function onPlayerRemoving(player: Player)
	readyPlayers[player] = nil
	local session = Sessions.get(player)
	if not session then
		return
	end
	Sessions.remove(player)
	if session.loaded then
		save(session)
	end
	PlotService.release(session)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Remotes.get("Ready").OnServerEvent:Connect(onReady)
Remotes.get("GoHome").OnServerEvent:Connect(function(player)
	PlotService.teleportHome(player)
end)

-- автосохранение
task.spawn(function()
	while true do
		task.wait(Config.Game.AutosaveInterval)
		for _, session in pairs(Sessions.all) do
			if session.loaded then
				task.spawn(save, session)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for _, session in pairs(Sessions.all) do
		if session.loaded then
			pending += 1
			task.spawn(function()
				save(session)
				pending -= 1
			end)
		end
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.2)
	end
end)

print(
	string.format(
		"[Potato Tycoon] сервер запущен: %d баз, %d построек, стартовый капитал %s",
		#World.plots,
		#Config.Items.List,
		Format.money(Config.Game.StartCash)
	)
)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Сохранение прогресса в DataStore (с повторами). Если DataStore недоступен
-- (например, в Studio без «Enable Studio Access to API Services»), игра работает без сохранений.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)

local DataService = {}

local store: DataStore? = nil
local storeFailed = false

local function getStore(): DataStore?
	if store or storeFailed then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Game.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeFailed = true
		warn(
			"[DataService] DataStore недоступен, прогресс не будет сохраняться: "
				.. tostring(result)
		)
	end
	return store
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function retry<T>(label: string, attempts: number, fn: () -> T): (boolean, T?)
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(
			string.format(
				"[DataService] %s: попытка %d не удалась: %s",
				label,
				attempt,
				tostring(result)
			)
		)
		if attempt < attempts then
			task.wait(attempt * 1.5)
		end
	end
	return false, nil
end

-- Переносит сохранённые данные в свежий профиль, отбрасывая неизвестные ключи
local function reconcile(profile, data)
	local function num(v, default)
		return if type(v) == "number" and v == v then v else default
	end
	profile.cash = num(data.cash, profile.cash)
	profile.stars = num(data.stars, 0)
	profile.rebirths = math.floor(num(data.rebirths, 0))
	profile.bag = math.floor(num(data.bag, 0))
	profile.totalEarned = num(data.totalEarned, 0)
	profile.totalKg = num(data.totalKg, 0)
	profile.lastOnline = num(data.lastOnline, 0)
	profile.lastIncome = num(data.lastIncome, 0)
	profile.bugEventsWon = num(data.bugEventsWon, 0)

	if type(data.owned) == "table" then
		for id, v in pairs(data.owned) do
			if v == true and Config.Items.ById[id] then
				profile.owned[id] = true
			end
		end
	end
	if type(data.varieties) == "table" then
		for _, v in ipairs(Config.Varieties) do
			if data.varieties[v.id] == true then
				profile.varieties[v.id] = true
			end
		end
	end
	if type(data.activeVariety) == "string" and profile.varieties[data.activeVariety] then
		profile.activeVariety = data.activeVariety
	end
	if type(data.staff) == "table" then
		for _, s in ipairs(Config.Staff.List) do
			local count = data.staff[s.id]
			if type(count) == "number" then
				profile.staff[s.id] = math.clamp(math.floor(count), 0, s.max)
			end
		end
	end
	if type(data.starTech) == "table" then
		for _, t in ipairs(Config.StarTech.List) do
			local level = data.starTech[t.id]
			if type(level) == "number" then
				profile.starTech[t.id] = math.clamp(math.floor(level), 0, t.max)
			end
		end
	end
	Economy.applyPrebuilt(profile, Config)
end

local function serialize(profile)
	return {
		version = profile.version,
		cash = profile.cash,
		stars = profile.stars,
		rebirths = profile.rebirths,
		owned = profile.owned,
		varieties = profile.varieties,
		activeVariety = profile.activeVariety,
		staff = profile.staff,
		starTech = profile.starTech,
		bag = profile.bag,
		totalEarned = profile.totalEarned,
		totalKg = profile.totalKg,
		lastOnline = profile.lastOnline,
		lastIncome = profile.lastIncome,
		bugEventsWon = profile.bugEventsWon,
	}
end

-- Возвращает профиль и флаг persistent (можно ли его сохранять)
function DataService.load(player: Player)
	local profile = Economy.newProfile(Config)
	local s = getStore()
	if not s then
		return profile, false
	end
	-- в Studio без доступа к API не ждём повторов, сразу играем без сохранений
	local attempts = if RunService:IsStudio() then 1 else 3
	local ok, data = retry("загрузка " .. player.Name, attempts, function()
		return s:GetAsync(key(player))
	end)
	if not ok and RunService:IsStudio() then
		storeFailed = true
		store = nil
		warn(
			"[DataService] Включите Game Settings → Security → Enable Studio Access to API Services, чтобы проверить сохранения"
		)
	end
	if not ok then
		-- не перезаписываем сохранение, которое не смогли прочитать
		return profile, false
	end
	if type(data) == "table" then
		reconcile(profile, data)
	end
	return profile, true
end

function DataService.save(player: Player, profile, persistent: boolean): boolean
	if not persistent then
		return false
	end
	local s = getStore()
	if not s then
		return false
	end
	local payload = serialize(profile)
	local ok = retry("сохранение " .. player.Name, 3, function()
		return s:UpdateAsync(key(player), function()
			return payload
		end)
	end)
	return ok
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- Случайные события (ГДД, раздел 6):
--  * Нашествие жуков — каждые 20 мин: поймай 15 жуков за 45 сек → бонус = 10 минут дохода
--  * Картофельный бум на бирже — раз в 30 мин: 3 минуты чипсы и фри в цене, доход x3

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Kit = require(script.Parent.Parent.World.ModelKit)
local Misc = require(script.Parent.Parent.World.Models.Misc)
local World = require(script.Parent.Parent.World.WorldBuilder)
local Sessions = require(script.Parent.Sessions)

type Session = Sessions.Session

local GameState = ReplicatedStorage:WaitForChild("GameState")

local EventService = {}

local NEVER = 1e15
local bugsActive = false
local bugSerial = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function spawnBug(session: Session, boss: boolean)
	local info = session.plot
	if not info then
		return
	end
	-- случайная точка в агро-блоке, не на центральной дорожке
	local x = math.random(5, 37) * (if math.random() < 0.5 then -1 else 1)
	local z = math.random(16, 38)
	local cf = World.localCFrame(info, x, z, math.random(0, 359))
	bugSerial += 1
	local b = Kit.new("Bug" .. bugSerial, cf)
	Misc.Bug(b, boss)
	local health = if boss then Config.Game.Events.Bugs.BossHealth else 1
	b.model:SetAttribute("Bug", true)
	b.model:SetAttribute("Boss", boss)
	b.model:SetAttribute("Health", health)
	b.model:SetAttribute("MaxHealth", health)
	b.model:SetAttribute("Owner", session.player.UserId)
	b:tag(b.model, "Bug")
	b:finish(info.bugs)
end

local function reward(session: Session)
	local E = Config.Game.Events.Bugs
	local stats = session.stats
	local base = if stats.manual then 0 else stats.incomeNoEvent * E.RewardSeconds
	local amount = math.max(base, E.MinReward * stats.rebirthMult) * (1 + (stats.bugBoost or 0))
	Sessions.addCash(session, amount)
	Sessions.updateLeaderstats(session)
	session.profile.bugEventsWon += 1
	Sessions.notify(session.player, "🪲 Жуки побеждены! Бонус " .. Format.money(amount), "gold")
	Sessions.effect(session.player, { type = "Confetti" })
	Sessions.effect(session.player, { type = "Sound", sound = "Cash" })
end

local function clearBugs(session: Session)
	if session.plot then
		session.plot.bugs:ClearAllChildren()
	end
end

function EventService.startBugs()
	local E = Config.Game.Events.Bugs
	bugsActive = true
	GameState:SetAttribute("BugsEndsAt", now() + E.Duration)
	GameState:SetAttribute("BugsGoal", E.Goal)
	for _, session in pairs(Sessions.all) do
		if session.loaded and session.plot then
			session.bugs = { count = 0, rewarded = false }
			session.player:SetAttribute("BugsCaught", 0)
			for _ = 1, E.Count do
				spawnBug(session, false)
			end
			spawnBug(session, true)
		end
	end
	Sessions.notifyAll(
		"🪲 НАШЕСТВИЕ ЖУКОВ! Кликай по жукам на своём поле: 15 за 45 сек = 10 минут дохода!",
		"event"
	)
	Sessions.effectAll({ type = "Sound", sound = "BugBuzz" })
	task.delay(E.Duration, function()
		bugsActive = false
		for _, session in pairs(Sessions.all) do
			if session.plot and #session.plot.bugs:GetChildren() > 0 and not session.bugs.rewarded then
				Sessions.notify(
					session.player,
					"Жуки улетели... Попробуй в следующий раз!",
					"info"
				)
			end
			clearBugs(session)
			session.player:SetAttribute("BugsCaught", nil)
		end
		GameState:SetAttribute("NextBugsAt", now() + E.Interval - E.Duration)
	end)
end

function EventService.clickBug(player: Player, bug: Instance)
	local session = Sessions.get(player)
	if not (bugsActive and session and session.plot) then
		return
	end
	if typeof(bug) ~= "Instance" or not bug:IsDescendantOf(session.plot.bugs) or not bug:GetAttribute("Bug") then
		return
	end
	local E = Config.Game.Events.Bugs
	local health = (bug:GetAttribute("Health") :: number) - 1
	bug:SetAttribute("Health", health)
	Sessions.effect(player, { type = "Squash", position = (bug :: Model):GetPivot().Position, dead = health <= 0 })
	if health > 0 then
		return
	end
	local value = if bug:GetAttribute("Boss") then E.BossValue else 1
	bug:Destroy()
	session.bugs.count += value
	player:SetAttribute("BugsCaught", session.bugs.count)
	if session.bugs.count >= E.Goal and not session.bugs.rewarded then
		session.bugs.rewarded = true
		reward(session)
		clearBugs(session)
	end
end

function EventService.startBoom()
	local B = Config.Game.Events.Boom
	GameState:SetAttribute("BoomEndsAt", now() + B.Duration)
	for _, session in pairs(Sessions.all) do
		Sessions.recompute(session)
	end
	Sessions.notifyAll(
		"📈 КАРТОФЕЛЬНЫЙ БУМ НА БИРЖЕ! Чипсы и фри в цене — доход x3 на 3 минуты!",
		"event"
	)
	Sessions.effectAll({ type = "Sound", sound = "Cash" })
	task.delay(B.Duration + 0.1, function()
		GameState:SetAttribute("NextBoomAt", now() + B.Interval - B.Duration)
		for _, session in pairs(Sessions.all) do
			Sessions.recompute(session)
		end
		Sessions.notifyAll(
			"Биржевой бум закончился. Следующий — через 27 минут.",
			"info"
		)
	end)
end

function EventService.init()
	local E = Config.Game.Events
	local fast = Config.Game.Debug.FastEvents and RunService:IsStudio()
	GameState:SetAttribute("NextBugsAt", now() + (if fast then 20 else E.Bugs.FirstDelay))
	GameState:SetAttribute("NextBoomAt", now() + (if fast then 60 else E.Boom.FirstDelay))

	Remotes.get("ClickBug").OnServerEvent:Connect(function(player, bug: unknown)
		if typeof(bug) == "Instance" then
			EventService.clickBug(player, bug :: Instance)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local t = now()
			if not bugsActive and t >= (GameState:GetAttribute("NextBugsAt") or NEVER) then
				GameState:SetAttribute("NextBugsAt", NEVER)
				EventService.startBugs()
			end
			if t >= (GameState:GetAttribute("NextBoomAt") or NEVER) then
				GameState:SetAttribute("NextBoomAt", NEVER)
				EventService.startBoom()
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">IncomeService</string>
            <string name="Source"><![CDATA[-- Пассивный доход (Direct Auto-Harvest & Instant Auto-Sell), золотые клубни, табло и Зал Славы

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local Sessions = require(script.Parent.Sessions)
local PlotService = require(script.Parent.PlotService)
local World = require(script.Parent.Parent.World.WorldBuilder)

type Session = Sessions.Session

local IncomeService = {}

local function tick(dt: number)
	for _, session in pairs(Sessions.all) do
		local stats = session.stats
		if session.loaded and session.plot and stats and not stats.manual then
			local earned = stats.incomePerSec * dt
			if earned > 0 then
				Sessions.addCash(session, earned)
				session.profile.totalKg += stats.yieldKg * dt
			end
		end
	end
end

local function goldenRoll()
	local G = Config.Game.Golden
	for _, session in pairs(Sessions.all) do
		local stats = session.stats
		if session.loaded and session.plot and stats and not stats.manual and stats.incomePerSec > 0 then
			local chance = G.Chance * (if session.passes.magnateDrone then G.PassMultiplier else 1)
			if math.random() < chance then
				-- выбираем случайную грядку-источник урожая
				local sources = {}
				for _, model in ipairs(session.plot.items:GetChildren()) do
					if model:GetAttribute("Yield") then
						table.insert(sources, model)
					end
				end
				local target = if #sources > 0 then sources[math.random(1, #sources)] else nil
				local bonus = stats.incomePerSec * G.IncomeSeconds
				Sessions.addCash(session, bonus)
				Sessions.notify(
					session.player,
					"✨ Золотой клубень на поле! +" .. Format.money(bonus),
					"gold"
				)
				Sessions.effect(
					session.player,
					{ type = "Golden", target = target, amount = bonus, glow = G.GlowSeconds }
				)
			end
		end
	end
end

local function updateBoards()
	for _, session in pairs(Sessions.all) do
		Sessions.updateLeaderstats(session)
		session.player:SetAttribute("TotalKg", session.profile.totalKg)
		local board = session.plot and PlotService.findItem(session, "led_board")
		if board then
			local label = board:FindFirstChild("BoardText", true) :: TextLabel?
			if label then
				label.Text = string.format(
					"ВЫРАБОТКА: %s\n%s/сек",
					Format.mass(session.profile.totalKg),
					Format.money(session.stats and session.stats.incomePerSec or 0)
				)
			end
		end
	end
end

local function updateHallOfFame()
	local model = (World :: any).hallOfFame
	if not model then
		return
	end
	local entries = {}
	for _, session in pairs(Sessions.all) do
		table.insert(entries, {
			name = session.player.DisplayName,
			rebirths = session.profile.rebirths,
			earned = session.profile.totalEarned,
		})
	end
	table.sort(entries, function(a, b)
		if a.rebirths ~= b.rebirths then
			return a.rebirths > b.rebirths
		end
		return a.earned > b.earned
	end)
	local lines = {}
	for i = 1, math.min(5, #entries) do
		local e = entries[i]
		table.insert(lines, string.format("%d. %s — ⭐%d, %s", i, e.name, e.rebirths, Format.money(e.earned)))
	end
	local text = if #lines > 0 then table.concat(lines, "\n") else "Пока пусто"
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "List" then
			d.Text = text
		end
	end
end

function IncomeService.init()
	task.spawn(function()
		local last = os.clock()
		local goldenTimer, boardTimer, fameTimer = 0, 0, 0
		while true do
			task.wait(Config.Game.TickSeconds)
			local t = os.clock()
			local dt = math.min(t - last, 5)
			last = t
			tick(dt)
			goldenTimer += dt
			boardTimer += dt
			fameTimer += dt
			if goldenTimer >= Config.Game.Golden.Interval then
				goldenTimer = 0
				goldenRoll()
			end
			if boardTimer >= 2 then
				boardTimer = 0
				updateBoards()
			end
			if fameTimer >= 10 then
				fameTimer = 0
				updateHallOfFame()
			end
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(updateHallOfFame)
	end)
end

return IncomeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ManualFarm</string>
            <string name="Source"><![CDATA[-- Этап 1: ручной огород. Лопата, созревание кустов, мешок, сдача скупщику, советы Деда Матвея.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPack = game:GetService("StarterPack")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Misc = require(script.Parent.Parent.World.Models.Misc)

local Sessions = require(script.Parent.Sessions)
local PlotService = require(script.Parent.PlotService)

type Session = Sessions.Session

local ManualFarm = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isShovel(tool: Instance?): boolean
	return tool ~= nil and tool:IsA("Tool") and tool:GetAttribute("Shovel") == true
end

function ManualFarm.removeShovel(player: Player)
	for _, container in ipairs({
		player:FindFirstChild("Backpack"),
		player:FindFirstChild("StarterGear"),
		player.Character,
	}) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if isShovel(child) then
					child:Destroy()
				end
			end
		end
	end
end

function ManualFarm.giveShovel(session: Session)
	local player = session.player
	ManualFarm.removeShovel(player)
	if not Economy.isManual(session.profile) then
		return
	end
	local golden = session.passes.vip == true
	local gear = player:FindFirstChild("StarterGear")
	if gear then
		Misc.Shovel(golden).Parent = gear
	end
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		Misc.Shovel(golden).Parent = backpack
	end
end

-- Выставляет таймеры созревания на ручных грядках
function ManualFarm.setupBeds(session: Session)
	local info = session.plot
	if not info then
		return
	end
	local manual = Economy.isManual(session.profile)
	local stats = session.stats or Sessions.recompute(session)
	for _, item in ipairs(Config.Items.List) do
		if item.manualYield and session.profile.owned[item.id] then
			local model = info.items:FindFirstChild(item.id)
			if model then
				local ripeAt = session.ripeAt[item.id] or (now() + stats.ripenTime)
				session.ripeAt[item.id] = ripeAt
				model:SetAttribute("RipeAt", ripeAt)
				model:SetAttribute("RipenTime", stats.ripenTime)
				model:SetAttribute("Auto", not manual)
				local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then
					prompt.Enabled = manual
				end
			end
		end
	end
	local stand = info.items:FindFirstChild("stand")
	if stand then
		local prompt = stand:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt then
			prompt.Enabled = manual
		end
	end
end

function ManualFarm.dig(session: Session, itemId: string, requireShovel: boolean)
	local player = session.player
	local profile = session.profile
	if not Economy.isManual(profile) or not session.plot then
		return
	end
	local item = Config.Items.ById[itemId]
	if not (item and item.manualYield and profile.owned[itemId]) then
		return
	end
	local model = session.plot.items:FindFirstChild(itemId) :: Model?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (model and root) then
		return
	end
	if (root.Position - model:GetPivot().Position).Magnitude > Config.Game.Manual.DigDistance then
		Sessions.notify(player, "Подойди ближе к грядке", "error")
		return
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if requireShovel and not isShovel(tool) then
		return
	end
	-- защита от спама кликами
	local t = now()
	if t - session.lastDig < 0.12 then
		return
	end
	session.lastDig = t
	if t < (session.ripeAt[itemId] or 0) - 0.15 then
		return
	end
	local stats = session.stats
	local capacity = stats.bagCapacity
	if profile.bag >= capacity then
		Sessions.notify(player, "Мешок полон! Отнеси картофель скупщику 🧺", "error")
		Sessions.effect(player, { type = "Sound", sound = "Error" })
		return
	end
	local gained = math.min(item.manualYield, capacity - profile.bag)
	profile.bag += gained
	player:SetAttribute("Bag", profile.bag)
	session.ripeAt[itemId] = t + stats.ripenTime
	model:SetAttribute("RipeAt", session.ripeAt[itemId])
	model:SetAttribute("RipenTime", stats.ripenTime)

	-- анимация удара лопатой (стандартный Animate проигрывает "Slash")
	if isShovel(tool) then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		task.delay(0.5, function()
			anim:Destroy()
		end)
	end
	Sessions.effect(player, {
		type = "Dig",
		position = model:GetPivot().Position,
		amount = gained,
	})

	-- золотой клубень
	local chance = Config.Game.Manual.GoldenChance
		* (if session.passes.magnateDrone then Config.Game.Golden.PassMultiplier else 1)
	if math.random() < chance then
		local bonus = Config.Game.Manual.GoldenValue * stats.manualPrice
		Sessions.addCash(session, bonus)
		Sessions.updateLeaderstats(session)
		Sessions.notify(player, "✨ Золотой клубень! +" .. Format.money(bonus), "gold")
		Sessions.effect(player, { type = "Golden", target = model, amount = bonus })
	end
end

function ManualFarm.sell(session: Session)
	local profile = session.profile
	local player = session.player
	if profile.bag <= 0 then
		Sessions.notify(player, "Мешок пуст — накопай картофеля лопатой 🥔", "info")
		return
	end
	local amount = profile.bag * session.stats.manualPrice
	profile.totalKg += profile.bag
	profile.bag = 0
	player:SetAttribute("Bag", 0)
	Sessions.addCash(session, amount)
	Sessions.updateLeaderstats(session)
	local stand = PlotService.findItem(session, "stand")
	Sessions.effect(player, {
		type = "Sell",
		position = if stand then stand:GetPivot().Position else nil,
		amount = amount,
	})
end

-- Покупка Авто-вышки: ручной труд исчезает навсегда
function ManualFarm.onTower(session: Session)
	if session.profile.bag > 0 then
		ManualFarm.sell(session)
	end
	ManualFarm.removeShovel(session.player)
	ManualFarm.setupBeds(session)
end

local TIPS = {
	[1] = "Бери лопату, копай созревшие кусты и сдавай картошку скупщику. Копи $1,500 на Авто-вышку — и ручной труд закончится!",
	[2] = "Теперь урожай продаётся сам. Ставь авто-грядки, следи за энергией ⚡ и открывай новые сорта в меню 🧬.",
	[3] = "Каждый цех — множитель выручки. Не забывай про генераторы: при перегрузке доход падает вдвое!",
	[4] = "Нанимай дронов в меню персонала и открывай премиальные сорта. Скоро — Лаборатория ДНК!",
	[5] = "Построй шаттл и накопи на Rebirth: x3 ко всем доходам навсегда и Картофельные Звезды!",
}

function ManualFarm.talk(session: Session)
	local stage = session.stats.stage
	Sessions.notify(session.player, "👴 Дед Матвей: " .. (TIPS[stage] or TIPS[1]), "tip")
end

function ManualFarm.init()
	-- лопату раздаёт сервер, из StarterPack её убираем на всякий случай
	for _, child in ipairs(StarterPack:GetChildren()) do
		if isShovel(child) then
			child:Destroy()
		end
	end

	PlotService.promptHandlers.Dig = function(session, model)
		ManualFarm.dig(session, model.Name, false)
	end
	PlotService.promptHandlers.Sell = function(session)
		ManualFarm.sell(session)
	end
	PlotService.promptHandlers.Talk = function(session)
		ManualFarm.talk(session)
	end

	Remotes.get("Dig").OnServerEvent:Connect(function(player: Player, itemId: unknown)
		local session = Sessions.get(player)
		if session and type(itemId) == "string" then
			ManualFarm.dig(session, itemId, true)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		ManualFarm.removeShovel(player)
	end)
end

return ManualFarm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PassService</string>
            <string name="Source"><![CDATA[-- Геймпассы (ГДД, раздел 6): x2 Cash, Бесконечная Энергия, Авто-дрон Магната, VIP Фермер

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Sessions = require(script.Parent.Sessions)
local PlotService = require(script.Parent.PlotService)
local ManualFarm = require(script.Parent.ManualFarm)

type Session = Sessions.Session

local GameState = ReplicatedStorage:WaitForChild("GameState")

local PassService = {}

local byKey = {}
local byId = {}
for _, pass in ipairs(Config.GamePasses.List) do
	byKey[pass.key] = pass
	if pass.id > 0 then
		byId[pass.id] = pass
	end
end

function PassService.load(session: Session)
	local player = session.player
	for _, pass in ipairs(Config.GamePasses.List) do
		local owned = false
		if pass.id > 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			owned = ok and result == true
		end
		if Config.GamePasses.GrantAllInStudio and RunService:IsStudio() then
			owned = true
		end
		session.passes[pass.key] = owned
	end
end

-- Золотое сияние VIP-фермера
function PassService.applyCharacter(session: Session, character: Model)
	if not session.passes.vip then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and not root:FindFirstChild("VipSparkles") then
		local sparkles = Instance.new("Sparkles")
		sparkles.Name = "VipSparkles"
		sparkles.SparkleColor = Color3.fromRGB(255, 205, 50)
		sparkles.Parent = root
	end
end

function PassService.prompt(player: Player, key: string)
	local pass = byKey[key]
	if not pass then
		return
	end
	local session = Sessions.get(player)
	if session and session.passes[key] then
		Sessions.notify(player, "У тебя уже есть «" .. pass.name .. "»", "info")
		return
	end
	if pass.id <= 0 then
		Sessions.notify(
			player,
			"Геймпасс «"
				.. pass.name
				.. "» ещё не настроен (впишите ID в Config/GamePasses)",
			"error"
		)
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.id)
end

local function granted(player: Player, pass)
	local session = Sessions.get(player)
	if not session then
		return
	end
	session.passes[pass.key] = true
	Sessions.recompute(session)
	Sessions.sync(session)
	PlotService.buildVipPads(session)
	if pass.key == "vip" then
		if player.Character then
			PassService.applyCharacter(session, player.Character)
		end
		ManualFarm.giveShovel(session)
	end
	Sessions.notify(player, pass.icon .. " Спасибо за покупку «" .. pass.name .. "»!", "gold")
	Sessions.effect(player, { type = "Confetti" })
end

function PassService.init()
	PlotService.onVip = PassService.prompt

	Remotes.get("BuyPass").OnServerEvent:Connect(function(player, key: unknown)
		if type(key) == "string" then
			PassService.prompt(player, key)
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = byId[passId]
		if purchased and pass then
			granted(player, pass)
		end
	end)

	-- цены в Robux для витрины
	task.spawn(function()
		for _, pass in ipairs(Config.GamePasses.List) do
			if pass.id > 0 then
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(pass.id, Enum.InfoType.GamePass)
				end)
				if ok and info and info.PriceInRobux then
					GameState:SetAttribute("PassPrice_" .. pass.key, info.PriceInRobux)
				end
			end
		end
	end)
end

return PassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- Базы игроков: выдача базы, постройка моделей, напольные кнопки, визуал персонала

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)

local WorldFolder = script.Parent.Parent.World
local World = require(WorldFolder.WorldBuilder)
local Library = require(WorldFolder.ModelLibrary)
local Kit = require(WorldFolder.ModelKit)
local Misc = require(WorldFolder.Models.Misc)

local Sessions = require(script.Parent.Sessions)

type Session = Sessions.Session

local PlotService = {}

-- Обработчики задаются в Main: покупка по кнопке, VIP-кнопки, действия ProximityPrompt
PlotService.onBuy = function(_player: Player, _itemId: string) end
PlotService.onVip = function(_player: Player, _passKey: string) end
PlotService.promptHandlers = {} :: { [string]: (Session, Model, ProximityPrompt) -> () }

-- Места персонала на базе (x, z)
local STAFF_SPOTS: { [string]: { { number } } } = {
	robo_inspector = { { -4, 30 }, { 4, 21 } },
	robo_cleaner = { { -1.5, -8 }, { 1.5, -14 }, { -1.5, -19 } },
	agronomist = { { 3.8, 18 } },
	palletizer = { { 14.5, -16.5 }, { 21.5, -16.5 } },
	engineer = { { -3.8, -12 } },
	truck_driver = { { -3.8, 38.5 } },
	exchange_manager = { { 3.8, 6 } },
	technician = { { 3.8, 12.5 } },
	guard_dog = { { 4, 27 } },
	profit_counter = { { -3.8, 21 } },
	professor = { { -3.8, -29 } },
	holo_assistant = { { -3.8, -35 } },
	trade_agent = { { 3.8, -25 } },
	shuttle_pilot = { { 3.8, -37 } },
	vip_droid = { { 3.8, 30 } },
}

local function characterPlayer(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local player = Players:GetPlayerFromCharacter(model)
		if player then
			return player
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function PlotService.assign(session: Session): boolean
	for _, info in ipairs(World.plots) do
		if not (info :: any).owner then
			(info :: any).owner = session.player
			session.plot = info
			info.folder:SetAttribute("OwnerUserId", session.player.UserId)
			info.sign.Text = "База: " .. session.player.DisplayName
			session.player:SetAttribute("PlotIndex", info.index)
			return true
		end
	end
	return false
end

function PlotService.clear(session: Session)
	local info = session.plot
	if not info then
		return
	end
	info.items:ClearAllChildren()
	info.buttons:ClearAllChildren()
	info.staff:ClearAllChildren()
	info.bugs:ClearAllChildren()
	local vip = info.folder:FindFirstChild("Vip")
	if vip then
		vip:Destroy()
	end
end

function PlotService.release(session: Session)
	local info = session.plot
	if not info then
		return
	end
	PlotService.clear(session);
	(info :: any).owner = nil
	info.folder:SetAttribute("OwnerUserId", nil)
	info.sign.Text = "Свободная база"
	session.plot = nil
end

function PlotService.itemCFrame(info, item): CFrame
	return World.localCFrame(info, item.pos[1], item.pos[2], item.rot, item.y)
end

function PlotService.findItem(session: Session, itemId: string): Model?
	local info = session.plot
	if not info then
		return nil
	end
	return info.items:FindFirstChild(itemId) :: Model?
end

function PlotService.bindPrompts(session: Session, model: Instance)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local action = d:GetAttribute("Action")
			if action and action ~= "OpenMenu" then
				d.Triggered:Connect(function(player: Player)
					if player ~= session.player then
						return
					end
					local handler = PlotService.promptHandlers[action]
					if handler then
						handler(session, model :: Model, d)
					end
				end)
			end
		end
	end
end

function PlotService.buildItem(session: Session, item, animate: boolean): Model?
	local info = session.plot
	if not info then
		return nil
	end
	local old = info.items:FindFirstChild(item.id)
	if old then
		old:Destroy()
	end
	local model = Library.build(item, PlotService.itemCFrame(info, item), info.items)
	model:SetAttribute("Owner", session.player.UserId)
	if item.yield then
		model:SetAttribute("Yield", item.yield)
	end
	if animate then
		model:SetAttribute("BuiltAt", workspace:GetServerTimeNow())
	end
	PlotService.bindPrompts(session, model)
	return model
end

local lastWarn: { [Model]: number } = {}

function PlotService.createButton(session: Session, item)
	local info = session.plot
	local spot = item.button or item.pos
	local b = Kit.new("Button_" .. item.id, World.localCFrame(info, spot[1], spot[2]))
	local cost = Economy.itemCost(item, session.profile, Config)
	local pad = Misc.Button(b, item.name, Format.money(cost), "Item")
	b.model:SetAttribute("ItemId", item.id)
	b.model:SetAttribute("Cost", cost)
	b.model:SetAttribute("Owner", session.player.UserId)
	if item.desc then
		b.model:SetAttribute("Desc", item.desc)
	end
	b.model:AddTag("BuyButton")
	local model = b:finish(info.buttons)
	local busy = false
	pad.Touched:Connect(function(hit: BasePart)
		if busy or characterPlayer(hit) ~= session.player then
			return
		end
		busy = true
		if session.profile.cash + 1e-6 >= cost then
			PlotService.onBuy(session.player, item.id)
		elseif os.clock() - (lastWarn[model] or 0) > 3 then
			lastWarn[model] = os.clock()
			Sessions.notify(
				session.player,
				"Не хватает " .. Format.money(cost - session.profile.cash),
				"error"
			)
		end
		task.delay(0.5, function()
			busy = false
		end)
	end)
	model.Destroying:Connect(function()
		lastWarn[model] = nil
	end)
end

-- Показывает кнопки всех доступных к покупке построек
function PlotService.refreshButtons(session: Session)
	local info = session.plot
	if not info then
		return
	end
	local profile = session.profile
	local wanted = {}
	for _, item in ipairs(Config.Items.List) do
		if not item.prebuilt and not profile.owned[item.id] and Economy.requirementsMet(item, profile) then
			wanted[item.id] = item
		end
	end
	for _, child in ipairs(info.buttons:GetChildren()) do
		local id = child:GetAttribute("ItemId")
		if wanted[id] and child:GetAttribute("Cost") == Economy.itemCost(wanted[id], profile, Config) then
			wanted[id] = nil
		else
			child:Destroy()
		end
	end
	for _, item in ipairs(Config.Items.List) do
		if wanted[item.id] then
			PlotService.createButton(session, item)
		end
	end
end

function PlotService.buildVipPads(session: Session)
	local info = session.plot
	if not info then
		return
	end
	local old = info.folder:FindFirstChild("Vip")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Vip"
	folder.Parent = info.folder
	for i, pass in ipairs(Config.GamePasses.List) do
		local spot = Config.Game.VipPads[i]
		if spot then
			local b = Kit.new("Vip_" .. pass.key, World.localCFrame(info, spot[1], spot[2]))
			local owned = session.passes[pass.key] == true
			local pad =
				Misc.Button(b, pass.icon .. " " .. pass.name, if owned then "✓ Куплено" else "Robux", "Vip")
			b.model:SetAttribute("PassKey", pass.key)
			b:finish(folder)
			local busy = false
			pad.Touched:Connect(function(hit: BasePart)
				if busy or owned or characterPlayer(hit) ~= session.player then
					return
				end
				busy = true
				PlotService.onVip(session.player, pass.key)
				task.delay(4, function()
					busy = false
				end)
			end)
		end
	end
end

function PlotService.spawnStaff(session: Session, staff, n: number, animate: boolean?)
	local info = session.plot
	if not info then
		return
	end
	local color = Color3.fromRGB(staff.color[1], staff.color[2], staff.color[3])
	local b
	if staff.visual == "Drone" then
		-- дроны патрулируют над агро-блоком
		local k = staff.order * 5 + n
		local x = -32 + (k * 13) % 64
		local z = 18 + (k * 7) % 18
		b = Kit.new(staff.id .. "_" .. n, World.localCFrame(info, x, z, 0, 10 + (k % 3)))
		Misc.Drone(b, color, if staff.id == "drone_hexa" then 6 else 4)
		b:tag(b.model, "Hover", { Radius = 3 + (k % 4), Speed = 0.4 + (k % 5) * 0.08, Phase = k })
	else
		local spots = STAFF_SPOTS[staff.id] or { { 0, 0 } }
		local spot = spots[math.min(n, #spots)]
		local rot = if spot[1] < 0 then 90 else -90
		b = Kit.new(staff.id .. "_" .. n, World.localCFrame(info, spot[1], spot[2], rot))
		if staff.visual == "Robot" then
			Misc.Robot(b, color)
			b:tag(b.model, "Roam", { Radius = 1.5, Speed = 0.5 + n * 0.1 })
		else
			Misc.StaffNpc(b, color, staff.name)
		end
	end
	b.model:SetAttribute("StaffId", staff.id)
	if animate then
		b.model:SetAttribute("BuiltAt", workspace:GetServerTimeNow())
	end
	b:finish(info.staff)
end

function PlotService.buildStaff(session: Session)
	local info = session.plot
	if not info then
		return
	end
	info.staff:ClearAllChildren()
	for _, staff in ipairs(Config.Staff.List) do
		for n = 1, session.profile.staff[staff.id] or 0 do
			PlotService.spawnStaff(session, staff, n, false)
		end
	end
end

-- Полная перестройка базы по профилю (вход в игру, Rebirth)
function PlotService.buildAll(session: Session)
	if not session.plot then
		return
	end
	PlotService.clear(session)
	for _, item in ipairs(Config.Items.List) do
		if session.profile.owned[item.id] then
			PlotService.buildItem(session, item, false)
		end
	end
	PlotService.buildStaff(session)
	PlotService.refreshButtons(session)
	PlotService.buildVipPads(session)
end

function PlotService.teleportHome(player: Player)
	local session = Sessions.get(player)
	local character = player.Character
	if not (session and session.plot and character) then
		return
	end
	character:PivotTo(session.plot.spawn)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[-- Покупки: постройки (кнопки), исследования сортов, найм персонала, звёздные технологии

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Sessions = require(script.Parent.Sessions)
local PlotService = require(script.Parent.PlotService)
local ManualFarm = require(script.Parent.ManualFarm)

type Session = Sessions.Session

local PurchaseService = {}

local function afterChange(session: Session, oldStage: number?)
	local stats = Sessions.recompute(session)
	PlotService.refreshButtons(session)
	Sessions.sync(session)
	if oldStage and stats.stage > oldStage then
		local stage = Config.Game.Stages[stats.stage]
		Sessions.notify(session.player, string.format("🎉 ЭТАП %d: %s", stats.stage, stage.name), "stage")
		Sessions.effect(session.player, { type = "Stage", stage = stats.stage })
	end
	if stats.overloaded and not session.passes.infiniteEnergy then
		Sessions.notify(
			session.player,
			"⚠ Перегрузка сети! Доход -50%. Построй генератор.",
			"error"
		)
	end
end

function PurchaseService.buyItem(player: Player, itemId: string): boolean
	local session = Sessions.get(player)
	local item = Config.Items.ById[itemId]
	if not (session and session.plot and item) or item.prebuilt then
		return false
	end
	local profile = session.profile
	if profile.owned[itemId] or not Economy.requirementsMet(item, profile) then
		return false
	end
	local cost = Economy.itemCost(item, profile, Config)
	if not Sessions.trySpend(session, cost) then
		Sessions.notify(player, "Не хватает " .. Format.money(cost - profile.cash), "error")
		return false
	end
	local oldStage = Economy.stage(profile, Config)
	profile.owned[itemId] = true
	PlotService.buildItem(session, item, true)
	if item.manualYield then
		ManualFarm.setupBeds(session)
	end
	Sessions.effect(player, { type = "Purchase", itemId = itemId })
	Sessions.notify(player, "Построено: " .. item.name, "success")
	if Config.Items.HasFlag(item, "Tower") then
		Sessions.recompute(session)
		ManualFarm.onTower(session)
		Sessions.notify(
			player,
			"🤝 Контракт подписан! Урожай теперь собирается и продаётся сам.",
			"stage"
		)
	end
	afterChange(session, oldStage)
	return true
end

function PurchaseService.buyResearch(player: Player, varietyId: string)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local profile = session.profile
	local variety
	for _, v in ipairs(Config.Varieties) do
		if v.id == varietyId then
			variety = v
		end
	end
	if not variety or profile.varieties[varietyId] then
		return
	end
	if variety.requires and not profile.owned[variety.requires] then
		local req = Config.Items.ById[variety.requires]
		Sessions.notify(
			player,
			"Сначала построй: " .. (if req then req.name else variety.requires),
			"error"
		)
		return
	end
	local cost = Economy.varietyCost(variety, profile, Config)
	if not Sessions.trySpend(session, cost) then
		Sessions.notify(player, "Не хватает " .. Format.money(cost - profile.cash), "error")
		return
	end
	profile.varieties[varietyId] = true
	Sessions.notify(player, "🧬 Открыт сорт «" .. variety.name .. "»", "success")
	Sessions.effect(player, { type = "Sound", sound = "Golden" })
	afterChange(session)
end

function PurchaseService.selectVariety(player: Player, varietyId: string?)
	local session = Sessions.get(player)
	if not session then
		return
	end
	if varietyId == nil or session.profile.varieties[varietyId] then
		session.profile.activeVariety = varietyId
		afterChange(session)
	end
end

function PurchaseService.hireStaff(player: Player, staffId: string)
	local session = Sessions.get(player)
	local staff = Config.Staff.ById[staffId]
	if not (session and staff) then
		return
	end
	local profile = session.profile
	local count = profile.staff[staffId] or 0
	if count >= staff.max then
		return
	end
	if not profile.owned[staff.requires] then
		local req = Config.Items.ById[staff.requires]
		Sessions.notify(
			player,
			"Сначала построй: " .. (if req then req.name else staff.requires),
			"error"
		)
		return
	end
	if staff.requiresPass and not session.passes[staff.requiresPass] then
		Sessions.notify(player, "Доступно только с геймпассом VIP Фермер 👑", "error")
		return
	end
	local cost = Economy.staffCost(staff, profile, Config)
	if not Sessions.trySpend(session, cost) then
		Sessions.notify(player, "Не хватает " .. Format.money(cost - profile.cash), "error")
		return
	end
	profile.staff[staffId] = count + 1
	PlotService.spawnStaff(session, staff, count + 1, true)
	Sessions.notify(player, "Нанят: " .. staff.name, "success")
	Sessions.effect(player, { type = "Sound", sound = "Cash" })
	afterChange(session)
end

function PurchaseService.buyStarTech(player: Player, techId: string)
	local session = Sessions.get(player)
	local tech = Config.StarTech.ById[techId]
	if not (session and tech) then
		return
	end
	local profile = session.profile
	local level = profile.starTech[techId] or 0
	if level >= tech.max then
		return
	end
	local cost = Config.StarTech.CostOf(tech, level)
	if profile.stars < cost then
		Sessions.notify(player, "Не хватает ⭐ " .. Format.number(cost - profile.stars), "error")
		return
	end
	profile.stars -= cost
	profile.starTech[techId] = level + 1
	Sessions.notify(player, string.format("⭐ %s: уровень %d", tech.name, level + 1), "success")
	Sessions.effect(player, { type = "Sound", sound = "Golden" })
	afterChange(session)
end

function PurchaseService.init()
	PlotService.onBuy = function(player, itemId)
		PurchaseService.buyItem(player, itemId)
	end
	Remotes.get("BuyResearch").OnServerEvent:Connect(function(player, id: unknown)
		if type(id) == "string" then
			PurchaseService.buyResearch(player, id)
		end
	end)
	Remotes.get("SelectVariety").OnServerEvent:Connect(function(player, id: unknown)
		if id == nil or type(id) == "string" then
			PurchaseService.selectVariety(player, id :: string?)
		end
	end)
	Remotes.get("HireStaff").OnServerEvent:Connect(function(player, id: unknown)
		if type(id) == "string" then
			PurchaseService.hireStaff(player, id)
		end
	end)
	Remotes.get("BuyStarTech").OnServerEvent:Connect(function(player, id: unknown)
		if type(id) == "string" then
			PurchaseService.buyStarTech(player, id)
		end
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[-- Rebirth (ГДД 2.1 и этап 5): запуск шаттла, сброс базы, множитель 3^N и Картофельные Звезды

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Sessions = require(script.Parent.Sessions)
local PlotService = require(script.Parent.PlotService)
local ManualFarm = require(script.Parent.ManualFarm)

type Session = Sessions.Session

local RebirthService = {}

RebirthService.onRebirth = function(_session: Session) end

local LAUNCH_SECONDS = 5

function RebirthService.request(player: Player)
	local session = Sessions.get(player)
	if not (session and session.plot) or session.rebirthing then
		return
	end
	local profile = session.profile
	if not profile.owned.shuttle then
		Sessions.notify(player, "Для Rebirth нужен Экспортный шаттл (сектор 4)", "error")
		return
	end
	local cost = Economy.rebirthCost(profile.rebirths, Config)
	if profile.cash < cost then
		Sessions.notify(player, "Для Rebirth нужно накопить " .. Format.money(cost), "error")
		return
	end
	session.rebirthing = true

	-- старт шаттла видят все игроки на сервере
	Sessions.effectAll({ type = "Launch", plotIndex = session.plot.index })
	task.wait(LAUNCH_SECONDS)
	if player.Parent == nil or Sessions.get(player) ~= session then
		return
	end

	profile.rebirths += 1
	local stars = Economy.rebirthStars(profile.rebirths, Config)
	profile.stars += stars
	local startCash = (profile.starTech.start_cash or 0) * Config.StarTech.ById.start_cash.perLevel
	profile.cash = startCash
	profile.owned = {}
	profile.varieties = { wild = true }
	profile.activeVariety = nil
	profile.staff = {}
	profile.bag = 0
	Economy.applyPrebuilt(profile, Config)
	session.ripeAt = {}

	Sessions.recompute(session)
	PlotService.buildAll(session)
	ManualFarm.setupBeds(session)
	ManualFarm.giveShovel(session)
	Sessions.sync(session)
	PlotService.teleportHome(player)

	local mult = Economy.rebirthMultiplier(profile.rebirths, Config)
	Sessions.effect(player, { type = "Confetti", big = true })
	Sessions.notify(
		player,
		string.format(
			"🚀 REBIRTH %d! Доход x%s навсегда, +%d ⭐",
			profile.rebirths,
			Format.number(mult),
			stars
		),
		"stage"
	)
	Sessions.notifyAll(
		string.format("🚀 %s совершает Rebirth #%d!", player.DisplayName, profile.rebirths),
		"event"
	)
	session.rebirthing = false
	RebirthService.onRebirth(session)
end

function RebirthService.init()
	Remotes.get("Rebirth").OnServerEvent:Connect(function(player)
		RebirthService.request(player)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Sessions</string>
            <string name="Source"><![CDATA[-- Состояние игроков на сервере: профиль, расчёт статистики, синхронизация с клиентом

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local GameState = ReplicatedStorage:WaitForChild("GameState")

local Sessions = {}

export type Session = {
	player: Player,
	profile: any,
	persistent: boolean,
	plot: any?,
	stats: any,
	passes: { [string]: boolean },
	ripeAt: { [string]: number },
	bugs: { count: number, rewarded: boolean },
	clientReady: boolean,
	pendingOffline: { seconds: number, amount: number }?,
	lastDig: number,
	loaded: boolean,
	rebirthing: boolean,
}

Sessions.all = {} :: { [Player]: Session }

local syncRemote = Remotes.get("Sync")
local notifyRemote = Remotes.get("Notify")
local effectRemote = Remotes.get("Effect")

function Sessions.create(player: Player, profile, persistent: boolean): Session
	local session: Session = {
		player = player,
		profile = profile,
		persistent = persistent,
		plot = nil,
		stats = nil,
		passes = {},
		ripeAt = {},
		bugs = { count = 0, rewarded = false },
		clientReady = false,
		pendingOffline = nil,
		lastDig = 0,
		loaded = false,
		rebirthing = false,
	}
	Sessions.all[player] = session
	return session
end

function Sessions.get(player: Player): Session?
	return Sessions.all[player]
end

function Sessions.remove(player: Player)
	Sessions.all[player] = nil
end

function Sessions.boomActive(): boolean
	return (GameState:GetAttribute("BoomEndsAt") or 0) > workspace:GetServerTimeNow()
end

function Sessions.context(session: Session)
	return { passes = session.passes, boom = Sessions.boomActive() }
end

-- Пересчитывает доход/энергию и публикует атрибуты игрока для HUD
function Sessions.recompute(session: Session)
	local profile = session.profile
	local stats = Economy.compute(profile, Sessions.context(session), Config)
	session.stats = stats
	local p = session.player
	p:SetAttribute("Cash", profile.cash)
	p:SetAttribute("Income", if stats.manual then 0 else stats.incomePerSec)
	p:SetAttribute("Stars", profile.stars)
	p:SetAttribute("Rebirths", profile.rebirths)
	p:SetAttribute("Stage", stats.stage)
	p:SetAttribute("Manual", stats.manual)
	p:SetAttribute("EnergyGen", stats.energyGen)
	p:SetAttribute("EnergyUse", stats.energyUse)
	p:SetAttribute("Overloaded", stats.overloaded)
	p:SetAttribute("Bag", profile.bag)
	p:SetAttribute("BagCapacity", stats.bagCapacity)
	p:SetAttribute("YieldKg", stats.yieldKg)
	p:SetAttribute("Price", stats.price)
	p:SetAttribute("FactoryMult", stats.factoryMult)
	p:SetAttribute("RebirthMult", stats.rebirthMult)
	p:SetAttribute("BonusMult", stats.bonusMult)
	p:SetAttribute("Variety", stats.variety.id)
	p:SetAttribute("ManualPrice", stats.manualPrice)
	p:SetAttribute("TotalKg", profile.totalKg)
	p:SetAttribute("VIP", session.passes.vip == true)
	Sessions.updateLeaderstats(session)
	return stats
end

function Sessions.updateLeaderstats(session: Session)
	local stats = session.player:FindFirstChild("leaderstats")
	if not stats then
		return
	end
	local cash = stats:FindFirstChild("Деньги") :: StringValue?
	if cash then
		cash.Value = Format.money(session.profile.cash)
	end
	local rebirths = stats:FindFirstChild("Rebirth") :: IntValue?
	if rebirths then
		rebirths.Value = session.profile.rebirths
	end
end

-- Полное состояние для меню клиента
function Sessions.sync(session: Session)
	if not session.clientReady then
		return
	end
	local profile = session.profile
	local stats = session.stats or Sessions.recompute(session)
	syncRemote:FireClient(session.player, {
		owned = profile.owned,
		varieties = profile.varieties,
		activeVariety = profile.activeVariety,
		staff = profile.staff,
		starTech = profile.starTech,
		passes = session.passes,
		rebirths = profile.rebirths,
		stars = profile.stars,
		totalEarned = profile.totalEarned,
		rebirthCost = Economy.rebirthCost(profile.rebirths, Config),
		nextStars = Economy.rebirthStars(profile.rebirths + 1, Config),
		nextMult = Economy.rebirthMultiplier(profile.rebirths + 1, Config),
		plotIndex = session.plot and session.plot.index,
		stats = {
			baseYield = stats.baseYield,
			yieldBoost = stats.yieldBoost,
			plots = stats.plots,
			bugBoost = stats.bugBoost,
			offlineRate = stats.offlineRate,
			offlineHours = stats.offlineHours,
			ripenTime = stats.ripenTime,
		},
	})
end

function Sessions.setCash(session: Session, value: number)
	session.profile.cash = value
	session.player:SetAttribute("Cash", value)
	Sessions.updateLeaderstats(session)
end

function Sessions.addCash(session: Session, amount: number)
	if amount ~= amount or amount <= 0 then
		return
	end
	session.profile.cash += amount
	session.profile.totalEarned += amount
	session.player:SetAttribute("Cash", session.profile.cash)
end

function Sessions.trySpend(session: Session, amount: number): boolean
	if session.profile.cash + 1e-6 < amount then
		return false
	end
	Sessions.setCash(session, math.max(0, session.profile.cash - amount))
	return true
end

function Sessions.notify(player: Player, text: string, kind: string?)
	notifyRemote:FireClient(player, text, kind or "info")
end

function Sessions.notifyAll(text: string, kind: string?)
	notifyRemote:FireAllClients(text, kind or "info")
end

function Sessions.effect(player: Player, data)
	effectRemote:FireClient(player, data)
end

function Sessions.effectAll(data)
	effectRemote:FireAllClients(data)
end

function Sessions.ofUserId(userId: number): Session?
	local player = Players:GetPlayerByUserId(userId)
	return player and Sessions.all[player]
end

return Sessions
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ModelKit</string>
            <string name="Source"><![CDATA[-- Конструктор моделей из деталей (Part). Все координаты — в локальной системе модели:
-- начало координат = центр пятна застройки на уровне пола, +Z смотрит к входу на базу.

local Kit = {}
Kit.__index = Kit

export type Opts = {
	rot: Vector3?, -- градусы (X, Y, Z)
	transparency: number?,
	collide: boolean?,
	name: string?,
	reflectance: number?,
	shadow: boolean?,
	parent: Instance?,
}

export type Builder = typeof(setmetatable(
	{} :: {
		model: Model,
		origin: CFrame,
		target: Instance,
	},
	Kit
))

-- Палитра
Kit.C = {
	wood = Color3.fromRGB(140, 95, 55),
	woodDark = Color3.fromRGB(95, 62, 35),
	woodLight = Color3.fromRGB(190, 145, 95),
	soil = Color3.fromRGB(92, 64, 42),
	soilDark = Color3.fromRGB(64, 44, 30),
	leaf = Color3.fromRGB(70, 150, 60),
	leafDark = Color3.fromRGB(45, 110, 45),
	stone = Color3.fromRGB(130, 130, 125),
	stoneDark = Color3.fromRGB(95, 95, 92),
	metal = Color3.fromRGB(165, 170, 178),
	metalDark = Color3.fromRGB(85, 90, 98),
	steel = Color3.fromRGB(120, 126, 136),
	white = Color3.fromRGB(235, 236, 238),
	black = Color3.fromRGB(28, 30, 34),
	yellow = Color3.fromRGB(245, 195, 40),
	orange = Color3.fromRGB(240, 130, 30),
	red = Color3.fromRGB(205, 50, 45),
	green = Color3.fromRGB(60, 190, 80),
	blue = Color3.fromRGB(45, 120, 220),
	cyan = Color3.fromRGB(60, 220, 240),
	purple = Color3.fromRGB(140, 70, 210),
	glass = Color3.fromRGB(170, 215, 235),
	potato = Color3.fromRGB(190, 145, 85),
	concrete = Color3.fromRGB(175, 172, 165),
	asphalt = Color3.fromRGB(60, 62, 66),
	skin = Color3.fromRGB(234, 184, 146),
	gold = Color3.fromRGB(255, 200, 40),
}

local M = Enum.Material

function Kit.new(name: string, origin: CFrame): Builder
	local model = Instance.new("Model")
	model.Name = name
	model.WorldPivot = origin
	return setmetatable({ model = model, origin = origin, target = model :: Instance }, Kit)
end

-- Вложенная группа (например, вращающиеся лопасти). Пишет детали в под-модель.
function Kit.group(self: Builder, name: string, pivot: Vector3?): Builder
	local sub = Instance.new("Model")
	sub.Name = name
	sub.WorldPivot = self.origin * CFrame.new(pivot or Vector3.zero)
	sub.Parent = self.target
	return setmetatable({ model = self.model, origin = self.origin, target = sub :: Instance }, Kit)
end

function Kit.groupModel(self: Builder): Model
	return self.target :: Model
end

local function rotation(rot: Vector3?): CFrame
	if not rot then
		return CFrame.identity
	end
	return CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
end

function Kit.place(self: Builder, part: BasePart, pos: Vector3, opts: Opts?)
	local o: Opts = opts or {}
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = self.origin * CFrame.new(pos) * rotation(o.rot)
	part.CanCollide = if o.collide == nil then true else o.collide
	part.CanTouch = false
	part.Transparency = o.transparency or 0
	part.Reflectance = o.reflectance or 0
	part.CastShadow = if o.shadow == nil then true else o.shadow
	if o.name then
		part.Name = o.name
	end
	part.Parent = o.parent or self.target
end

function Kit.box(self: Builder, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material?, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or M.SmoothPlastic
	self:place(p, pos, opts)
	return p
end

-- Вертикальный цилиндр
function Kit.cyl(
	self: Builder,
	height: number,
	diameter: number,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): Part
	local o: Opts = table.clone(opts or {})
	local r = o.rot or Vector3.zero
	o.rot = Vector3.new(r.X, r.Y, r.Z + 90)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.Color = color
	p.Material = material or M.SmoothPlastic
	self:place(p, pos, o)
	return p
end

-- Горизонтальный цилиндр вдоль X (rot позволяет развернуть)
function Kit.cylX(
	self: Builder,
	length: number,
	diameter: number,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.Color = color
	p.Material = material or M.SmoothPlastic
	self:place(p, pos, opts)
	return p
end

-- Горизонтальный цилиндр вдоль Z
function Kit.cylZ(
	self: Builder,
	length: number,
	diameter: number,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): Part
	local o: Opts = table.clone(opts or {})
	local r = o.rot or Vector3.zero
	o.rot = Vector3.new(r.X, r.Y + 90, r.Z)
	return self:cylX(length, diameter, pos, color, material, o)
end

function Kit.ball(
	self: Builder,
	diameter: number,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.Color = color
	p.Material = material or M.SmoothPlastic
	self:place(p, pos, opts)
	return p
end

-- Эллипсоид (клубень, крона, купол)
function Kit.ellipsoid(
	self: Builder,
	size: Vector3,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): Part
	local p = self:box(size, pos, color, material, opts)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

function Kit.wedge(
	self: Builder,
	size: Vector3,
	pos: Vector3,
	color: Color3,
	material: Enum.Material?,
	opts: Opts?
): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.Color = color
	p.Material = material or M.SmoothPlastic
	self:place(p, pos, opts)
	return p
end

-- Труба между двумя точками
function Kit.pipe(
	self: Builder,
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): Part
	local length = (b - a).Magnitude
	if math.abs((b - a).Unit.Y) > 0.999 then
		return self:cyl(length, diameter, (a + b) / 2, color, material or M.Metal, { collide = false })
	end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.Color = color
	p.Material = material or M.Metal
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
	p.CFrame = self.origin * cf
	p.Parent = self.target
	return p
end

function Kit.light(_self: Builder, part: BasePart, color: Color3, range: number?, brightness: number?, spot: boolean?)
	if spot then
		local s = Instance.new("SpotLight")
		s.Face = Enum.NormalId.Bottom
		s.Angle = 80
		s.Color = color
		s.Range = range or 10
		s.Brightness = brightness or 1.5
		s.Parent = part
	else
		local p = Instance.new("PointLight")
		p.Color = color
		p.Range = range or 10
		p.Brightness = brightness or 1.5
		p.Shadows = false
		p.Parent = part
	end
end

-- Надпись на грани детали
function Kit.label(
	_self: Builder,
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	opts: {
		color: Color3?,
		background: Color3?,
		font: Enum.Font?,
		scale: number?,
		name: string?,
	}?
): TextLabel
	local o = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = o.name or "Label"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if o.background then 0 else 1
	label.BackgroundColor3 = o.background or Color3.new()
	label.TextColor3 = o.color or Color3.new(1, 1, 1)
	label.Font = o.font or Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	local s = UDim.new(0.06 * (o.scale or 1), 0)
	pad.PaddingLeft = s
	pad.PaddingRight = s
	pad.PaddingTop = s
	pad.PaddingBottom = s
	pad.Parent = label
	return label
end

-- Надпись над объектом
function Kit.billboard(
	_self: Builder,
	part: BasePart,
	text: string,
	offset: number,
	color: Color3?,
	maxDistance: number?
)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, offset, 0)
	gui.MaxDistance = maxDistance or 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	return label
end

function Kit.tag(_self: Builder, instance: Instance, tag: string, attributes: { [string]: any }?)
	if attributes then
		for k, v in pairs(attributes) do
			instance:SetAttribute(k, v)
		end
	end
	instance:AddTag(tag)
end

-- Клубень картофеля
function Kit.potato(self: Builder, pos: Vector3, scale: number, color: Color3?, opts: Opts?): Part
	return self:ellipsoid(Vector3.new(0.9, 0.6, 0.65) * scale, pos, color or Kit.C.potato, M.SmoothPlastic, opts)
end

-- Блочная фигурка человека (NPC без Humanoid). pos — точка на полу.
function Kit.figure(
	self: Builder,
	pos: Vector3,
	colors: {
		shirt: Color3,
		pants: Color3,
		skin: Color3?,
		hat: Color3?,
	},
	facing: number?,
	scale: number?
): Model
	local s = scale or 1
	local g = self:group("Figure", pos)
	local yaw = facing or 0
	local function at(v: Vector3): Vector3
		local r = CFrame.Angles(0, math.rad(yaw), 0) * (v * s)
		return pos + r
	end
	local rot = Vector3.new(0, yaw, 0)
	local skin = colors.skin or Kit.C.skin
	local o = { rot = rot, collide = false }
	g:box(Vector3.new(0.9, 1.9, 0.9) * s, at(Vector3.new(-0.5, 0.95, 0)), colors.pants, M.SmoothPlastic, o)
	g:box(Vector3.new(0.9, 1.9, 0.9) * s, at(Vector3.new(0.5, 0.95, 0)), colors.pants, M.SmoothPlastic, o)
	g:box(Vector3.new(2, 1.9, 1) * s, at(Vector3.new(0, 2.85, 0)), colors.shirt, M.SmoothPlastic, o)
	g:box(Vector3.new(0.85, 1.9, 0.85) * s, at(Vector3.new(-1.45, 2.85, 0)), colors.shirt, M.SmoothPlastic, o)
	g:box(Vector3.new(0.85, 1.9, 0.85) * s, at(Vector3.new(1.45, 2.85, 0)), colors.shirt, M.SmoothPlastic, o)
	local head = g:box(Vector3.new(1.15, 1.15, 1.15) * s, at(Vector3.new(0, 4.4, 0)), skin, M.SmoothPlastic, o)
	head.Name = "Head"
	-- глаза
	g:box(Vector3.new(0.18, 0.22, 0.05) * s, at(Vector3.new(-0.25, 4.5, 0.58)), Kit.C.black, M.SmoothPlastic, o)
	g:box(Vector3.new(0.18, 0.22, 0.05) * s, at(Vector3.new(0.25, 4.5, 0.58)), Kit.C.black, M.SmoothPlastic, o)
	if colors.hat then
		g:box(Vector3.new(1.35, 0.35, 1.35) * s, at(Vector3.new(0, 5.1, 0)), colors.hat, M.SmoothPlastic, o)
		g:box(Vector3.new(1.35, 0.12, 0.5) * s, at(Vector3.new(0, 4.98, 0.85)), colors.hat, M.SmoothPlastic, o)
	end
	return g:groupModel()
end

-- Общая станина промышленного модуля: рама, корпус, панель управления, ножки
function Kit.machine(self: Builder, w: number, d: number, h: number, body: Color3, accent: Color3): Part
	local C = Kit.C
	self:box(Vector3.new(w, 0.4, d), Vector3.new(0, 0.2, 0), C.metalDark, M.DiamondPlate)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			self:box(
				Vector3.new(0.4, 1, 0.4),
				Vector3.new(sx * (w / 2 - 0.5), 0.9, sz * (d / 2 - 0.5)),
				C.black,
				M.Metal
			)
		end
	end
	local main = self:box(Vector3.new(w - 0.6, h, d - 1.2), Vector3.new(0, 1.4 + h / 2, -0.2), body, M.Metal)
	self:box(Vector3.new(w - 0.4, 0.3, d - 1), Vector3.new(0, 1.4 + h + 0.15, -0.2), accent, M.SmoothPlastic)
	-- полоса предупреждения
	self:box(
		Vector3.new(w - 0.55, 0.25, 0.05),
		Vector3.new(0, 1.7, d / 2 - 0.78),
		C.yellow,
		M.SmoothPlastic,
		{ collide = false }
	)
	-- пульт
	local panel = self:box(
		Vector3.new(1.2, 1.4, 0.3),
		Vector3.new(w / 2 - 1, 2.4, d / 2 - 0.45),
		C.black,
		M.SmoothPlastic,
		{ rot = Vector3.new(-15, 0, 0), collide = false }
	)
	self:box(
		Vector3.new(0.25, 0.25, 0.05),
		Vector3.new(w / 2 - 1.3, 2.6, d / 2 - 0.25),
		C.green,
		M.Neon,
		{ collide = false }
	)
	self:box(
		Vector3.new(0.25, 0.25, 0.05),
		Vector3.new(w / 2 - 0.7, 2.6, d / 2 - 0.25),
		C.red,
		M.Neon,
		{ collide = false }
	)
	self:label(panel, Enum.NormalId.Back, "ON", { color = accent, scale = 0.5 })
	return main
end

function Kit.finish(self: Builder, parent: Instance): Model
	self.model.Parent = parent
	return self.model
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ModelLibrary</string>
            <string name="Source"><![CDATA[-- Реестр всех моделей построек: ключ из Config.Items[...].model → функция-строитель

local Kit = require(script.Parent.ModelKit)

local Library = {}

local builders: { [string]: (Kit.Builder, any) -> () } = {}
for _, moduleScript in ipairs(script.Parent.Models:GetChildren()) do
	if moduleScript:IsA("ModuleScript") and moduleScript.Name ~= "Misc" then
		for key, fn in pairs(require(moduleScript) :: any) do
			if type(fn) == "function" and string.match(key, "^%u") then
				builders[key] = fn
			end
		end
	end
end

function Library.has(key: string): boolean
	return builders[key] ~= nil
end

-- Строит модель постройки. origin — CFrame пятна на полу базы.
function Library.build(item, origin: CFrame, parent: Instance): Model
	local b = Kit.new(item.id, origin)
	local builder = builders[item.model]
	if builder then
		builder(b, item)
	else
		warn("[ModelLibrary] нет модели " .. tostring(item.model) .. ", ставлю заглушку")
		b:box(Vector3.new(item.size[1], 2, item.size[2]), Vector3.new(0, 1, 0), Kit.C.metal, Enum.Material.Metal)
	end
	b.model:SetAttribute("ItemId", item.id)
	return b:finish(parent)
end

return Library
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="34">
          <Properties>
            <string name="Name">Models</string>
          </Properties>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Agro</string>
              <string name="Source"><![CDATA[-- Модели агро-блока (сектор 1). Каждая функция строит модель в своей локальной системе:
-- (0, 0, 0) — центр пятна на уровне пола, +Z — к входу на базу.

local Kit = require(script.Parent.Parent.ModelKit)

type Builder = Kit.Builder

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local Models = {}

local function prompt(parent: BasePart, action: string, text: string, object: string?, hold: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "Prompt"
	p.ActionText = text
	p.ObjectText = object or ""
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = 10
	p.RequiresLineOfSight = false
	p:SetAttribute("Action", action)
	p.Parent = parent
	return p
end
Models.prompt = prompt

-- Кусты картофеля: 3 куста вдоль грядки (клиент анимирует рост) и клубни на почве
local function bushes(b: Builder, soilTop: number, length: number)
	local bush = b:group("Bush", V(0, soilTop, 0))
	for i = -1, 1 do
		local z = i * length / 3
		bush:cyl(0.8, 0.25, V(0, soilTop + 0.4, z), C.leafDark, M.Grass, { collide = false })
		bush:ellipsoid(V(1.9, 1.3, 1.6), V(0, soilTop + 1.0, z), C.leaf, M.Grass, { collide = false })
		bush:ellipsoid(V(1.1, 0.9, 1.1), V(0.45, soilTop + 1.45, z + 0.3), C.leafDark, M.Grass, { collide = false })
	end
	local tubers = b:group("Tubers", V(0, soilTop, 0))
	for i = -1, 1 do
		local z = i * length / 3
		tubers:potato(V(-0.9, soilTop + 0.15, z + 0.6), 0.9, nil, { collide = false, rot = V(0, 30, 0) })
		tubers:potato(V(0.95, soilTop + 0.15, z - 0.5), 0.8, nil, { collide = false, rot = V(0, -20, 0) })
	end
end

local function soil(b: Builder, w: number, d: number, y: number): Part
	local s = b:box(V(w, 0.3, d), V(0, y, 0), C.soil, M.Ground, { name = "Soil" })
	-- борозды
	for i = -1, 1, 2 do
		b:box(V(0.25, 0.08, d - 0.3), V(i * w / 4, y + 0.17, 0), C.soilDark, M.Ground, { collide = false })
	end
	return s
end

local function manualBed(b: Builder, item)
	b.model:SetAttribute("ManualBed", true)
	local s = b.model:FindFirstChild("Soil") :: BasePart
	prompt(s, "Dig", "Выкопать", item.name)
end

function Models.BedWood(b: Builder, item)
	b:box(V(0.4, 0.9, 6), V(-1.8, 0.45, 0), C.wood, M.WoodPlanks)
	b:box(V(0.4, 0.9, 6), V(1.8, 0.45, 0), C.wood, M.WoodPlanks)
	b:box(V(3.2, 0.9, 0.4), V(0, 0.45, 2.8), C.wood, M.WoodPlanks)
	b:box(V(3.2, 0.9, 0.4), V(0, 0.45, -2.8), C.wood, M.WoodPlanks)
	soil(b, 3.2, 5.2, 0.6)
	bushes(b, 0.75, 5.2)
	manualBed(b, item)
end

function Models.BedStone(b: Builder, item)
	for z = -2.5, 2.5, 1.25 do
		b:box(V(0.5, 1.0, 1.2), V(-1.75, 0.5, z), if z % 2.5 == 0 then C.stone else C.stoneDark, M.Slate)
		b:box(V(0.5, 1.0, 1.2), V(1.75, 0.5, z), if z % 2.5 == 0 then C.stoneDark else C.stone, M.Slate)
	end
	b:box(V(3, 1.0, 0.5), V(0, 0.5, 2.75), C.stone, M.Slate)
	b:box(V(3, 1.0, 0.5), V(0, 0.5, -2.75), C.stone, M.Slate)
	soil(b, 3, 5, 0.75)
	bushes(b, 0.9, 5)
	manualBed(b, item)
end

function Models.BedMetal(b: Builder, item)
	b:box(V(0.35, 1.1, 6), V(-1.82, 0.55, 0), C.metal, M.DiamondPlate)
	b:box(V(0.35, 1.1, 6), V(1.82, 0.55, 0), C.metal, M.DiamondPlate)
	b:box(V(3.3, 1.1, 0.35), V(0, 0.55, 2.82), C.metal, M.DiamondPlate)
	b:box(V(3.3, 1.1, 0.35), V(0, 0.55, -2.82), C.metal, M.DiamondPlate)
	-- нагревательные полосы
	b:box(V(0.06, 0.18, 5.4), V(-2.02, 0.75, 0), C.orange, M.Neon, { collide = false })
	b:box(V(0.06, 0.18, 5.4), V(2.02, 0.75, 0), C.orange, M.Neon, { collide = false })
	b:box(V(0.8, 0.6, 0.6), V(1.2, 0.3, 3.3), C.metalDark, M.Metal)
	soil(b, 3.3, 5.3, 0.85)
	bushes(b, 1.0, 5.3)
	manualBed(b, item)
end

function Models.WateringCan(b: Builder)
	b:box(V(1.6, 0.7, 1.6), V(0, 0.35, 0), C.woodDark, M.WoodPlanks)
	b:cyl(1.0, 0.9, V(0, 1.2, 0), C.green, M.Metal)
	b:box(V(0.15, 0.6, 0.15), V(0, 1.9, 0), C.green, M.Metal)
	b:box(V(0.7, 0.12, 0.15), V(0, 2.2, 0), C.green, M.Metal)
	b:pipe(V(0.3, 1.0, 0), V(1.0, 1.6, 0), 0.18, C.green, M.Metal)
	b:cyl(0.15, 0.35, V(1.05, 1.65, 0), C.metal, M.Metal, { rot = V(0, 0, -50) })
	-- таймер авто-полива
	b:box(V(0.5, 0.4, 0.2), V(0, 1.2, 0.5), C.white, M.SmoothPlastic, { collide = false })
	local led = b:box(V(0.15, 0.15, 0.05), V(0.1, 1.25, 0.62), C.cyan, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 3 })
end

function Models.BigSack(b: Builder)
	b:ellipsoid(V(1.7, 2.2, 1.5), V(0, 1.1, 0), Color3.fromRGB(176, 150, 105), M.Fabric)
	b:cyl(0.3, 0.8, V(0, 2.25, 0), Color3.fromRGB(150, 125, 85), M.Fabric)
	for i = 1, 4 do
		local a = math.rad(i * 90)
		b:potato(V(math.cos(a) * 0.35, 2.45, math.sin(a) * 0.35), 0.7, nil, { collide = false })
	end
	local tag = b:box(V(0.9, 0.6, 0.05), V(0, 1.2, 0.76), C.white, M.SmoothPlastic, { collide = false })
	b:label(tag, Enum.NormalId.Back, "XL", { color = C.red })
end

function Models.SellStand(b: Builder)
	-- прилавок
	local counter = b:box(V(6.6, 1.6, 1.4), V(0, 0.8, 2.2), C.wood, M.WoodPlanks, { name = "Counter" })
	b:box(V(6.8, 0.2, 1.6), V(0, 1.7, 2.2), C.woodLight, M.Wood)
	b:label(
		counter,
		Enum.NormalId.Back,
		"СКУПКА КАРТОФЕЛЯ",
		{ color = C.yellow, background = C.woodDark }
	)
	-- столбы и навес
	for _, x in ipairs({ -3.1, 3.1 }) do
		b:box(V(0.35, 5, 0.35), V(x, 2.5, 2.7), C.woodDark, M.Wood)
		b:box(V(0.35, 5.6, 0.35), V(x, 2.8, -2.5), C.woodDark, M.Wood)
	end
	for i = 0, 5 do
		local color = if i % 2 == 0 then C.red else C.white
		b:box(V(1.1, 0.15, 6.2), V(-2.75 + i * 1.1, 5.55, 0.1), color, M.Fabric, { rot = V(-6, 0, 0) })
	end
	-- ящики с картошкой
	for _, x in ipairs({ -2.2, 0, 2.2 }) do
		b:box(V(1.5, 0.8, 1.1), V(x, 0.4, -1.4), C.woodLight, M.WoodPlanks)
		for k = 1, 3 do
			b:potato(V(x - 0.45 + k * 0.3, 0.9, -1.4 + (k % 2) * 0.2), 0.7, nil, { collide = false })
		end
	end
	-- весы
	b:box(V(0.8, 0.25, 0.6), V(-2.2, 1.95, 2.2), C.metal, M.Metal, { collide = false })
	b:box(V(0.9, 0.05, 0.7), V(-2.2, 2.2, 2.2), C.metalDark, M.Metal, { collide = false })
	-- табличка цены
	local sign = b:box(V(2.4, 1, 0.15), V(1.6, 2.4, 2.9), C.white, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "$1 / шт", { color = C.green })
	-- скупщик (ГДД 114)
	b:figure(
		V(0, 0, 0.6),
		{ shirt = Color3.fromRGB(70, 110, 160), pants = Color3.fromRGB(60, 60, 70), hat = C.woodDark },
		0
	)
	b:billboard(counter, "Деревенский скупщик", 6, C.yellow)
	prompt(counter, "Sell", "Сдать картофель", "Скупщик", 0.2)
end

function Models.NpcMatvey(b: Builder)
	local fig = b:figure(V(0, 0, 0), {
		shirt = Color3.fromRGB(150, 60, 50),
		pants = Color3.fromRGB(70, 80, 120),
		hat = Color3.fromRGB(215, 185, 110),
	}, 0, 0.95)
	local head = fig:FindFirstChild("Head") :: BasePart
	-- борода
	local headLocal = b.origin:PointToObjectSpace(head.CFrame.Position)
	b:box(V(0.9, 0.55, 0.25), headLocal + V(0, -0.45, 0.55), C.white, M.SmoothPlastic, { collide = false })
	b:billboard(head, "Дед Матвей", 2.2, C.yellow)
	prompt(head, "Talk", "Поговорить", "Дед Матвей")
end

function Models.FenceWood(b: Builder)
	-- периметр агро-блока: z от -13 до +13 локально, x от -40 до 40
	local function rail(a: Vector3, c: Vector3)
		local len = (c - a).Magnitude
		local mid = (a + c) / 2
		local alongX = math.abs(c.X - a.X) > 0.1
		local size = if alongX then V(len, 0.3, 0.2) else V(0.2, 0.3, len)
		b:box(size, mid + V(0, 1.6, 0), C.woodLight, M.WoodPlanks)
		b:box(size, mid + V(0, 0.8, 0), C.woodLight, M.WoodPlanks)
	end
	local function posts(a: Vector3, c: Vector3)
		local n = math.floor((c - a).Magnitude / 4)
		for i = 0, n do
			local p = a:Lerp(c, i / n)
			b:box(V(0.4, 2.2, 0.4), p + V(0, 1.1, 0), C.woodDark, M.Wood)
		end
		rail(a, c)
	end
	posts(V(-39.8, 0, 12.8), V(-3.6, 0, 12.8))
	posts(V(3.6, 0, 12.8), V(39.8, 0, 12.8))
	posts(V(-39.8, 0, -13), V(-39.8, 0, 12.8))
	posts(V(39.8, 0, -13), V(39.8, 0, 12.8))
end

function Models.HarvestTower(b: Builder)
	local h = 11
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b:pipe(V(sx * 2.6, 0, sz * 2.6), V(sx * 1.2, h, sz * 1.2), 0.35, C.red, M.Metal)
		end
	end
	for y = 2, h - 1, 3 do
		local k = 2.6 - (y / h) * 1.4
		b:box(V(k * 2, 0.2, 0.2), V(0, y, k), C.white, M.Metal, { collide = false })
		b:box(V(k * 2, 0.2, 0.2), V(0, y, -k), C.white, M.Metal, { collide = false })
		b:box(V(0.2, 0.2, k * 2), V(k, y, 0), C.white, M.Metal, { collide = false })
		b:box(V(0.2, 0.2, k * 2), V(-k, y, 0), C.white, M.Metal, { collide = false })
	end
	b:box(V(3.4, 0.4, 3.4), V(0, h, 0), C.metalDark, M.DiamondPlate)
	b:box(V(2, 1.6, 2), V(0, h + 1, 0), C.white, M.SmoothPlastic)
	local beacon = b:ball(0.8, V(0, h + 2.3, 0), C.yellow, M.Neon, { collide = false })
	b:light(beacon, C.yellow, 14, 2)
	b:tag(beacon, "Pulse", { Speed = 3 })
	-- радар-сканер урожая
	local dish = b:group("Dish", V(0, h + 1.9, 0))
	dish:cyl(0.6, 0.25, V(0, h + 2, 0), C.metal, M.Metal, { collide = false })
	dish:ellipsoid(
		V(2.6, 0.5, 1.4),
		V(0, h + 2.5, 0.4),
		C.white,
		M.SmoothPlastic,
		{ rot = V(-30, 0, 0), collide = false }
	)
	b:tag(dish:groupModel(), "Spin", { Axis = "Y", Speed = 60 })
	-- табличка контракта
	local board = b:box(V(4.4, 1.6, 0.2), V(0, 3, 2.9), C.blue, M.SmoothPlastic, { collide = false })
	b:label(board, Enum.NormalId.Back, "КОНТРАКТ: АВТО-ПРОДАЖА", { color = C.white })
end

local function autoBedBase(b: Builder, frame: Color3, mat: Enum.Material)
	b:box(V(0.4, 1.1, 6), V(-1.8, 0.55, 0), frame, mat)
	b:box(V(0.4, 1.1, 6), V(1.8, 0.55, 0), frame, mat)
	b:box(V(3.2, 1.1, 0.4), V(0, 0.55, 2.8), frame, mat)
	b:box(V(3.2, 1.1, 0.4), V(0, 0.55, -2.8), frame, mat)
	soil(b, 3.2, 5.2, 0.85)
	bushes(b, 1.0, 5.2)
end

function Models.AutoBedT1(b: Builder)
	autoBedBase(b, C.metal, M.Metal)
	-- шнек авто-сбора
	local auger = b:group("Auger", V(-2.25, 0.7, 0))
	auger:cylZ(5.6, 0.5, V(-2.25, 0.7, 0), C.yellow, M.Metal, { collide = false })
	for z = -2.4, 2.4, 0.6 do
		auger:box(V(0.7, 0.1, 0.12), V(-2.25, 0.7, z), C.orange, M.Metal, { rot = V(0, 0, z * 60), collide = false })
	end
	b:tag(auger:groupModel(), "Spin", { Axis = "Z", Speed = 180 })
	b:box(V(1.2, 1.2, 0.9), V(-1.5, 0.6, 3.4), C.yellow, M.Metal)
end

function Models.AutoBedT2(b: Builder)
	autoBedBase(b, C.steel, M.DiamondPlate)
	-- вакуумный сборщик
	b:cyl(1.6, 1.2, V(0, 0.8, 3.45), C.blue, M.Metal)
	b:cyl(0.2, 1.3, V(0, 1.65, 3.45), C.black, M.Metal)
	b:pipe(V(0, 1.6, 3.2), V(0, 2.6, 1.5), 0.35, C.black, M.Fabric)
	b:pipe(V(0, 2.6, 1.5), V(0, 2.6, -2.5), 0.35, C.black, M.Fabric)
	local nozzle = b:box(V(2.8, 0.25, 0.5), V(0, 2.3, -1), C.blue, M.Metal, { collide = false })
	b:tag(nozzle, "Slide", { Axis = "Z", Amplitude = 1.8, Speed = 1.2 })
end

function Models.AutoBedT3(b: Builder)
	autoBedBase(b, C.black, M.Metal)
	-- портал лазерного среза ботвы
	for _, x in ipairs({ -1.9, 1.9 }) do
		b:box(V(0.25, 3, 0.25), V(x, 1.5, -2.9), C.metalDark, M.Metal)
		b:box(V(0.25, 3, 0.25), V(x, 1.5, 2.9), C.metalDark, M.Metal)
		b:box(V(0.2, 0.2, 6), V(x, 3, 0), C.metalDark, M.Metal, { collide = false })
	end
	local carriage = b:group("Laser", V(0, 3, 0))
	carriage:box(V(4, 0.35, 0.5), V(0, 3, 0), C.white, M.SmoothPlastic, { collide = false })
	local beam = carriage:box(V(3.4, 1.4, 0.05), V(0, 2.2, 0), C.red, M.Neon, { collide = false, transparency = 0.4 })
	b:light(beam, C.red, 6, 1)
	b:tag(carriage:groupModel(), "Slide", { Axis = "Z", Amplitude = 2.3, Speed = 0.8 })
end

function Models.Sprinkler(b: Builder)
	b:cyl(0.3, 1.4, V(0, 0.15, 0), C.metalDark, M.Metal)
	b:cyl(2.4, 0.3, V(0, 1.5, 0), C.metal, M.Metal)
	local head = b:group("Head", V(0, 2.8, 0))
	head:cyl(0.4, 0.5, V(0, 2.8, 0), C.yellow, M.Metal, { collide = false })
	head:box(V(2.4, 0.15, 0.15), V(0, 2.95, 0), C.metal, M.Metal, { collide = false })
	local nozzle = head:box(V(0.2, 0.2, 0.2), V(1.2, 2.95, 0), C.metal, M.Metal, { collide = false })
	local water = Instance.new("ParticleEmitter")
	water.Color = ColorSequence.new(Color3.fromRGB(150, 210, 255))
	water.Size = NumberSequence.new(0.25, 0.05)
	water.Transparency = NumberSequence.new(0.3, 1)
	water.Lifetime = NumberRange.new(0.6, 0.9)
	water.Rate = 40
	water.Speed = NumberRange.new(8, 11)
	water.SpreadAngle = Vector2.new(10, 10)
	water.EmissionDirection = Enum.NormalId.Right
	water.Acceleration = V(0, -25, 0)
	water.Parent = nozzle
	b:tag(head:groupModel(), "Spin", { Axis = "Y", Speed = 120 })
end

-- Столб с двумя светильниками над рядами грядок (±5 по Z)
local function lampPost(b: Builder, headColor: Color3, headMat: Enum.Material, lightColor: Color3, kind: string)
	b:box(V(1.2, 0.3, 1.2), V(0, 0.15, 0), C.metalDark, M.Metal)
	b:box(V(0.35, 6.4, 0.35), V(0, 3.2, 0), C.metalDark, M.Metal)
	b:box(V(0.25, 0.25, 10.5), V(0, 6.3, 0), C.metalDark, M.Metal, { collide = false })
	for _, z in ipairs({ -5, 5 }) do
		b:box(V(0.1, 0.8, 0.1), V(0, 5.9, z), C.black, M.Metal, { collide = false })
		local head
		if kind == "basic" then
			b:cyl(0.4, 1.2, V(0, 5.4, z), C.metalDark, M.Metal, { collide = false })
			head = b:ball(0.8, V(0, 5.05, z), headColor, headMat, { collide = false })
		elseif kind == "led" then
			head = b:box(V(3.2, 0.2, 4.6), V(0, 5.4, z), headColor, headMat, { collide = false })
			b:box(V(3.4, 0.25, 4.8), V(0, 5.6, z), C.black, M.Metal, { collide = false })
		else
			head = b:box(V(3.4, 0.25, 5), V(0, 5.4, z), headColor, headMat, { collide = false })
			local ring = b:group("Ring" .. z, V(0, 5.9, z))
			ring:cyl(0.1, 2.2, V(0, 6.1, z), C.cyan, M.Neon, { collide = false, transparency = 0.2 })
			b:tag(ring:groupModel(), "Spin", { Axis = "Y", Speed = 90 })
		end
		b:light(head, lightColor, 12, 2, true)
	end
end

function Models.LampBasic(b: Builder)
	lampPost(b, Color3.fromRGB(255, 220, 140), M.Neon, Color3.fromRGB(255, 210, 140), "basic")
end

function Models.LampLed(b: Builder)
	lampPost(b, Color3.fromRGB(255, 80, 200), M.Neon, Color3.fromRGB(255, 120, 220), "led")
end

function Models.LampQuantum(b: Builder)
	lampPost(b, Color3.fromRGB(80, 230, 255), M.Neon, Color3.fromRGB(120, 200, 255), "quantum")
end

function Models.NeonSign(b: Builder)
	for _, x in ipairs({ -4.3, 4.3 }) do
		b:box(V(0.7, 10, 0.7), V(x, 5, 0), C.black, M.Metal)
	end
	local board = b:box(V(9.6, 2.6, 0.4), V(0, 9, 0), C.black, M.SmoothPlastic, { collide = false })
	b:label(board, Enum.NormalId.Back, "POTATO TYCOON", { color = Color3.fromRGB(255, 220, 60) })
	b:label(board, Enum.NormalId.Front, "POTATO TYCOON", { color = Color3.fromRGB(255, 220, 60) })
	local trim = b:box(V(9.9, 0.15, 0.5), V(0, 10.35, 0), Color3.fromRGB(255, 90, 200), M.Neon, { collide = false })
	b:box(V(9.9, 0.15, 0.5), V(0, 7.65, 0), Color3.fromRGB(255, 90, 200), M.Neon, { collide = false })
	b:light(trim, Color3.fromRGB(255, 120, 200), 16, 2)
end

function Models.LedBoard(b: Builder)
	b:box(V(0.3, 3, 0.3), V(-2.2, 1.5, 0), C.metalDark, M.Metal)
	b:box(V(0.3, 3, 0.3), V(2.2, 1.5, 0), C.metalDark, M.Metal)
	local board = b:box(V(5, 2.4, 0.35), V(0, 3.9, 0), C.black, M.SmoothPlastic, { name = "Board" })
	local label = b:label(board, Enum.NormalId.Back, "ВЫРАБОТКА: 0 кг", {
		color = Color3.fromRGB(255, 80, 60),
		font = Enum.Font.Arcade,
		name = "BoardGui",
	})
	label.Name = "BoardText"
	b:box(V(5.2, 0.15, 0.45), V(0, 5.15, 0), C.metal, M.Metal, { collide = false })
end

function Models.MoleTrap(b: Builder)
	b:cyl(1.6, 0.2, V(0, 0.8, 0), C.green, M.Metal)
	b:cyl(0.5, 0.9, V(0, 1.75, 0), C.green, M.SmoothPlastic)
	local ring = b:cyl(0.08, 1.4, V(0, 0.05, 0), C.cyan, M.Neon, { collide = false, transparency = 0.3 })
	b:tag(ring, "Pulse", { Speed = 2 })
	b:box(V(0.5, 0.05, 0.3), V(0, 1.9, 0.46), C.black, M.SmoothPlastic, { collide = false })
end

function Models.DripSystem(b: Builder)
	b:cyl(2.2, 2.2, V(0, 1.1, -0.2), C.blue, M.SmoothPlastic)
	b:cyl(0.2, 2.3, V(0, 2.25, -0.2), C.white, M.SmoothPlastic)
	b:box(V(0.8, 0.8, 0.6), V(0.8, 0.4, 1.1), C.black, M.Metal)
	b:pipe(V(0.8, 0.2, 1.4), V(0.8, 0.2, 3.2), 0.18, C.black, M.Rubber)
	b:pipe(V(-10, 0.15, 3.2), V(10, 0.15, 3.2), 0.18, C.black, M.Rubber)
	b:cyl(0.12, 0.5, V(0.8, 0.95, 1.1), C.red, M.Metal, { collide = false })
end

local function plants(b: Builder, y: number, w: number, d: number, color: Color3?)
	for x = -w / 2 + 0.5, w / 2 - 0.4, 0.9 do
		for z = -d / 2 + 0.5, d / 2 - 0.4, 1 do
			b:ellipsoid(V(0.7, 0.6, 0.7), V(x, y + 0.3, z), color or C.leaf, M.Grass, { collide = false })
		end
	end
end

local function tray(b: Builder, y: number, w: number, d: number)
	b:box(V(w, 0.3, d), V(0, y, 0), C.white, M.SmoothPlastic)
	b:box(
		V(w - 0.3, 0.05, d - 0.3),
		V(0, y + 0.16, 0),
		Color3.fromRGB(110, 180, 220),
		M.Glass,
		{ collide = false, transparency = 0.3 }
	)
	plants(b, y + 0.15, w - 0.6, d - 0.6)
end

function Models.HydroTray(b: Builder)
	for _, x in ipairs({ -1.6, 1.6 }) do
		for _, z in ipairs({ -2.6, 2.6 }) do
			b:box(V(0.2, 1.4, 0.2), V(x, 0.7, z), C.metal, M.Metal)
		end
	end
	tray(b, 1.5, 3.6, 5.6)
	b:pipe(V(1.8, 1.2, 2.8), V(1.8, 0.2, 3.3), 0.15, C.white, M.SmoothPlastic)
end

local function rack(b: Builder, tiers: number)
	for _, x in ipairs({ -2.2, 2.2 }) do
		for _, z in ipairs({ -2.7, 2.7 }) do
			b:box(V(0.25, tiers * 2 + 0.6, 0.25), V(x, (tiers * 2 + 0.6) / 2, z), C.metal, M.Metal)
		end
	end
	for t = 1, tiers do
		local y = t * 2 - 0.9
		tray(b, y, 4.2, 5.6)
		local lamp =
			b:box(V(3.6, 0.12, 4.8), V(0, y + 1.75, 0), Color3.fromRGB(230, 100, 255), M.Neon, { collide = false })
		if t == tiers then
			b:light(lamp, Color3.fromRGB(230, 120, 255), 8, 1)
		end
	end
end

function Models.HydroRack2(b: Builder)
	rack(b, 2)
end

function Models.HydroRack3(b: Builder)
	rack(b, 3)
end

function Models.HydroTower(b: Builder)
	b:cyl(1.2, 3.6, V(0, 0.6, 0), C.blue, M.SmoothPlastic)
	local tower = b:group("Tower", V(0, 5, 0))
	tower:cyl(8.5, 1.4, V(0, 5.4, 0), C.white, M.SmoothPlastic)
	for i = 0, 15 do
		local a = math.rad(i * 67)
		local y = 1.8 + i * 0.48
		tower:ellipsoid(
			V(0.9, 0.8, 0.9),
			V(math.cos(a) * 0.85, y, math.sin(a) * 0.85),
			C.leaf,
			M.Grass,
			{ collide = false }
		)
	end
	b:tag(tower:groupModel(), "Spin", { Axis = "Y", Speed = 12 })
	local top = b:ball(0.6, V(0, 9.9, 0), C.cyan, M.Neon, { collide = false })
	b:light(top, C.cyan, 8, 1)
end

function Models.Aeroponic(b: Builder)
	b:box(V(4.4, 0.5, 4.4), V(0, 0.25, 0), C.metalDark, M.DiamondPlate)
	b:ellipsoid(V(4, 4.2, 4), V(0, 2.5, 0), C.white, M.SmoothPlastic)
	local window = b:ellipsoid(
		V(3.2, 1.2, 4.1),
		V(0, 2.8, 0),
		Color3.fromRGB(120, 220, 255),
		M.Glass,
		{ transparency = 0.35, collide = false }
	)
	local strip = b:cyl(0.15, 4.1, V(0, 1.8, 0), C.cyan, M.Neon, { collide = false })
	b:light(strip, C.cyan, 8, 1)
	local mist = Instance.new("ParticleEmitter")
	mist.Color = ColorSequence.new(Color3.new(1, 1, 1))
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.Size = NumberSequence.new(0.6, 1.6)
	mist.Lifetime = NumberRange.new(1, 2)
	mist.Rate = 6
	mist.Speed = NumberRange.new(0.5, 1)
	mist.Parent = window
end

local function greenhouse(b: Builder, w: number, d: number, h: number, frame: Color3, plantColor: Color3?)
	local glass = Color3.fromRGB(200, 235, 245)
	b:box(V(w, 0.3, d), V(0, 0.15, 0), C.concrete, M.Concrete)
	b:box(V(w, h, 0.1), V(0, h / 2, -d / 2), glass, M.Glass, { transparency = 0.6 })
	b:box(V(w, h, 0.1), V(0, h / 2, d / 2), glass, M.Glass, { transparency = 0.6 })
	b:box(V(0.1, h, d), V(-w / 2, h / 2, 0), glass, M.Glass, { transparency = 0.6 })
	b:box(V(0.1, h, d), V(w / 2, h / 2, 0), glass, M.Glass, { transparency = 0.6 })
	local roofW = w / 2 / math.cos(math.rad(25))
	b:box(
		V(roofW, 0.1, d),
		V(-w / 4, h + w / 4 * math.tan(math.rad(25)), 0),
		glass,
		M.Glass,
		{ transparency = 0.55, rot = V(0, 0, 25), collide = false }
	)
	b:box(
		V(roofW, 0.1, d),
		V(w / 4, h + w / 4 * math.tan(math.rad(25)), 0),
		glass,
		M.Glass,
		{ transparency = 0.55, rot = V(0, 0, -25), collide = false }
	)
	for _, x in ipairs({ -w / 2, w / 2 }) do
		for _, z in ipairs({ -d / 2, d / 2 }) do
			b:box(V(0.2, h, 0.2), V(x, h / 2, z), frame, M.Metal)
		end
	end
	b:box(V(0.2, 0.2, d), V(0, h + w / 2 * math.tan(math.rad(25)), 0), frame, M.Metal, { collide = false })
	b:box(V(w - 1, 0.6, d - 1.2), V(0, 0.6, 0), C.soil, M.Ground)
	plants(b, 0.9, w - 1.4, d - 1.6, plantColor)
end

function Models.GreenhouseSmall(b: Builder)
	greenhouse(b, 5, 6, 3, C.woodDark)
end

function Models.GreenhousePro(b: Builder)
	b:box(V(14, 0.3, 6), V(0, 0.15, 0), C.concrete, M.Concrete)
	-- арочный тоннель из поликарбоната
	b:cylX(13.6, 6, V(0, 0, 0), Color3.fromRGB(220, 245, 230), M.Glass, { transparency = 0.55, collide = false })
	for x = -6.5, 6.5, 2.6 do
		b:cylX(0.2, 6.15, V(x, 0, 0), C.metal, M.Metal, { transparency = 0, collide = false })
	end
	b:box(V(12.8, 0.6, 4.4), V(0, 0.5, 0), C.soil, M.Ground)
	plants(b, 0.8, 12, 3.8, Color3.fromRGB(80, 170, 70))
	-- торцевые стенки как твёрдые преграды
	b:box(V(0.2, 2.6, 5.4), V(-6.9, 1.3, 0), C.white, M.SmoothPlastic, { transparency = 0.4 })
	b:box(V(0.2, 2.6, 5.4), V(6.9, 1.3, 0), C.white, M.SmoothPlastic, { transparency = 0.4 })
end

function Models.Fertilizer(b: Builder)
	b:box(V(2.6, 0.3, 2.6), V(0, 0.15, 0), C.metalDark, M.DiamondPlate)
	b:cyl(2.2, 1.8, V(-0.3, 1.4, -0.2), C.white, M.SmoothPlastic)
	b:cyl(0.3, 1.9, V(-0.3, 2.6, -0.2), C.blue, M.SmoothPlastic)
	b:box(V(0.9, 0.9, 0.7), V(0.8, 0.75, 0.7), C.blue, M.Metal)
	b:pipe(V(0.8, 1.0, 1.05), V(0.8, 0.3, 1.6), 0.15, C.black, M.Rubber)
	local led = b:box(V(0.2, 0.2, 0.05), V(0.8, 1.0, 1.06), C.green, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 4 })
end

function Models.BiohumusTank(b: Builder)
	b:cyl(3, 2.6, V(0, 1.5, 0), Color3.fromRGB(95, 70, 45), M.Metal)
	b:cyl(0.25, 2.7, V(0, 3.1, 0), C.metalDark, M.Metal)
	b:cyl(0.1, 2.3, V(0, 3.25, 0), C.soilDark, M.Ground, { collide = false })
	for y = 0.4, 3, 0.5 do
		b:box(V(0.5, 0.08, 0.08), V(1.35, y, 0), C.metal, M.Metal, { collide = false })
	end
	b:box(V(0.08, 3.2, 0.08), V(1.35, 1.6, 0.25), C.metal, M.Metal, { collide = false })
	b:box(V(0.08, 3.2, 0.08), V(1.35, 1.6, -0.25), C.metal, M.Metal, { collide = false })
end

function Models.Fogger(b: Builder)
	b:box(V(1.4, 1, 1.4), V(0, 0.5, 0), C.white, M.SmoothPlastic)
	local nozzle = b:cyl(0.6, 0.5, V(0, 1.3, 0), C.metal, M.Metal)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(230, 240, 255)
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 1
	smoke.Size = 2
	smoke.Parent = nozzle
	b:box(V(0.4, 0.2, 0.05), V(0, 0.7, 0.71), C.cyan, M.Neon, { collide = false })
end

function Models.SoilSensor(b: Builder)
	b:cyl(1.4, 0.15, V(0, 0.7, 0), C.metal, M.Metal)
	b:box(V(0.9, 0.7, 0.25), V(0, 1.6, 0), C.white, M.SmoothPlastic)
	local screen = b:box(V(0.7, 0.45, 0.05), V(0, 1.62, 0.14), C.green, M.Neon, { collide = false })
	b:label(screen, Enum.NormalId.Back, "pH 6.5", { color = C.black })
	b:box(V(0.8, 0.05, 0.5), V(0, 2.0, 0), C.blue, M.Glass, { rot = V(20, 0, 0), collide = false })
end

function Models.Ionizer(b: Builder)
	b:cyl(0.4, 2.4, V(0, 0.2, 0), C.metalDark, M.Metal)
	b:cyl(3.2, 0.5, V(0, 2, 0), Color3.fromRGB(190, 110, 60), M.Metal)
	local rings = b:group("Rings", V(0, 2, 0))
	for y = 1, 3, 0.7 do
		rings:cyl(0.12, 1.6, V(0, y, 0), C.cyan, M.Neon, { collide = false, transparency = 0.2 })
	end
	b:tag(rings:groupModel(), "Spin", { Axis = "Y", Speed = 45 })
	local orb = b:ball(0.8, V(0, 3.8, 0), C.cyan, M.Neon, { collide = false })
	b:light(orb, C.cyan, 10, 1.5)
	b:tag(orb, "Pulse", { Speed = 2 })
end

function Models.ForceDome(b: Builder, item)
	b:cyl(0.5, 2.6, V(0, 0.25, 0), C.metalDark, M.Metal)
	b:cyl(3.4, 0.8, V(0, 2, 0), C.black, M.Metal)
	local orb = b:ball(1.3, V(0, 4.2, 0), Color3.fromRGB(120, 200, 255), M.Neon, { collide = false })
	b:light(orb, Color3.fromRGB(120, 200, 255), 16, 2)
	b:tag(orb, "Pulse", { Speed = 1.5 })
	-- купол над всем агро-блоком (центр агро-блока — x=0, z=27)
	local center = V(-item.pos[1], 0, 27 - item.pos[2])
	local dome = b:ellipsoid(
		V(84, 26, 32),
		center,
		Color3.fromRGB(110, 190, 255),
		M.ForceField,
		{ collide = false, shadow = false, name = "Dome" }
	)
	dome.CanQuery = false
end

function Models.Flagpole(b: Builder)
	b:cyl(0.4, 1.4, V(0, 0.2, 0), C.concrete, M.Concrete)
	b:cyl(12, 0.25, V(0, 6, 0), C.metal, M.Metal)
	b:ball(0.4, V(0, 12.1, 0), C.gold, M.Metal, { collide = false })
	local flag = b:group("Flag", V(0, 11, 0))
	local cloth = flag:box(V(0.08, 1.8, 2.8), V(0, 11, -1.5), C.yellow, M.Fabric, { collide = false })
	flag:potato(V(-0.08, 11, -1.5), 1.2, C.woodDark, { collide = false, rot = V(0, 90, 0) })
	b:label(cloth, Enum.NormalId.Right, "POTATO INC", { color = C.red, scale = 0.6 })
	b:tag(flag:groupModel(), "Sway", { Axis = "Y", Amplitude = 12, Speed = 1.5 })
end

function Models.Mascot(b: Builder)
	local body = b:group("Body", V(0, 0, 0))
	body:potato(V(0, 1.6, 0), 3.4, Color3.fromRGB(200, 155, 95), { rot = V(0, 0, 90) })
	body:ball(0.45, V(-0.4, 2.4, 0.95), C.white, M.SmoothPlastic, { collide = false })
	body:ball(0.45, V(0.4, 2.4, 0.95), C.white, M.SmoothPlastic, { collide = false })
	body:ball(0.22, V(-0.4, 2.4, 1.15), C.black, M.SmoothPlastic, { collide = false })
	body:ball(0.22, V(0.4, 2.4, 1.15), C.black, M.SmoothPlastic, { collide = false })
	body:box(V(0.7, 0.12, 0.1), V(0, 1.9, 1.05), C.red, M.SmoothPlastic, { collide = false })
	body:cyl(0.5, 1.5, V(0, 3.35, 0), C.red, M.Fabric, { collide = false })
	body:box(V(1.2, 0.12, 0.8), V(0, 3.15, 0.7), C.red, M.Fabric, { collide = false })
	b:tag(body:groupModel(), "Bob", { Amplitude = 0.25, Speed = 2 })
end

return Models
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Energy</string>
              <string name="Source"><![CDATA[-- Модели сектора 3: энергетика, дрон-сервис, офис менеджера

local Kit = require(script.Parent.Parent.ModelKit)

type Builder = Kit.Builder

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local Models = {}

local function smoke(part: BasePart, color: Color3?, opacity: number?)
	local s = Instance.new("Smoke")
	s.Color = color or Color3.fromRGB(90, 90, 90)
	s.Opacity = opacity or 0.15
	s.RiseVelocity = 4
	s.Size = 1.5
	s.Parent = part
end

local function openMenu(part: BasePart, menu: string, text: string, object: string)
	local p = Instance.new("ProximityPrompt")
	p.Name = "Prompt"
	p.ActionText = text
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p:SetAttribute("Action", "OpenMenu")
	p:SetAttribute("Menu", menu)
	p.Parent = part
end
Models.openMenu = openMenu

local function grille(b: Builder, w: number, h: number, pos: Vector3, color: Color3)
	for y = -h / 2 + 0.2, h / 2 - 0.2, 0.35 do
		b:box(V(w, 0.12, 0.08), pos + V(0, y, 0), color, M.Metal, { collide = false })
	end
end

function Models.GenPetrol(b: Builder)
	-- трубчатая рама
	for _, x in ipairs({ -1.1, 1.1 }) do
		b:pipe(V(x, 0.1, -1), V(x, 0.1, 1), 0.2, C.black)
		b:pipe(V(x, 0.1, -1), V(x, 1.9, -1), 0.2, C.black)
		b:pipe(V(x, 0.1, 1), V(x, 1.9, 1), 0.2, C.black)
		b:pipe(V(x, 1.9, -1), V(x, 1.9, 1), 0.2, C.black)
	end
	b:box(V(1.8, 1.2, 1.7), V(0, 0.9, 0), C.red, M.SmoothPlastic)
	b:box(V(1.5, 0.5, 1.2), V(0, 1.75, 0), C.red, M.SmoothPlastic)
	b:box(V(0.6, 0.6, 0.05), V(-0.3, 0.95, 0.86), C.black, M.SmoothPlastic, { collide = false })
	local exhaust = b:cylX(0.6, 0.25, V(1.25, 0.7, -0.6), C.metal, M.Metal, { collide = false })
	smoke(exhaust, nil, 0.08)
	local led = b:box(V(0.15, 0.15, 0.05), V(0.5, 1.1, 0.86), C.green, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 2 })
end

function Models.GenDiesel25(b: Builder)
	b:box(V(3.8, 0.3, 3.6), V(0, 0.15, 0), C.metalDark, M.Metal)
	b:box(V(3.4, 2.4, 3.2), V(0, 1.5, 0), Color3.fromRGB(60, 120, 70), M.Metal)
	grille(b, 2.8, 1.6, V(0, 1.5, 1.62), Color3.fromRGB(40, 80, 50))
	local stack = b:cyl(1.6, 0.4, V(1.1, 3.4, -1), C.metal, M.Metal)
	smoke(stack)
	local label = b:box(V(1.6, 0.5, 0.05), V(-0.8, 2.4, 1.63), C.white, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "25 кВт", { color = C.black })
end

function Models.GenDiesel100(b: Builder)
	b:box(V(6, 0.4, 4.8), V(0, 0.2, 0), C.metalDark, M.DiamondPlate)
	b:box(V(5.6, 3, 4.2), V(0, 1.9, 0), C.yellow, M.Metal)
	grille(b, 1.4, 2.4, V(-2.81, 1.9, 0) + V(0, 0, 0), C.black)
	b:box(V(0.1, 2.4, 3.6), V(2.81, 1.9, 0), C.black, M.Metal, { collide = false })
	for _, x in ipairs({ -1.2, 1.2 }) do
		local stack = b:cyl(2, 0.5, V(x, 4.4, -1.2), C.metal, M.Metal)
		smoke(stack, nil, 0.2)
	end
	local label = b:box(V(2.4, 0.7, 0.05), V(0, 2.6, 2.11), C.black, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "100 кВт", { color = C.yellow })
end

function Models.Biogas(b: Builder)
	b:cyl(3.4, 5.2, V(0, 1.7, 0), Color3.fromRGB(150, 150, 140), M.Concrete)
	b:ellipsoid(V(5.2, 3.2, 5.2), V(0, 3.4, 0), Color3.fromRGB(60, 140, 70), M.Fabric)
	b:pipe(V(2.4, 1, 0), V(3, 1, 0), 0.4, C.yellow)
	b:pipe(V(3, 1, 0), V(3, 1, 2.8), 0.4, C.yellow)
	local flare = b:cyl(4.5, 0.35, V(-2.6, 2.25, 2.6), C.metal, M.Metal)
	local tip = b:cyl(0.3, 0.5, V(-2.6, 4.6, 2.6), C.black, M.Metal, { collide = false })
	local fire = Instance.new("Fire")
	fire.Size = 2
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 30)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
	fire.Parent = tip
	local _ = flare
	local label = b:box(V(2.6, 0.7, 0.05), V(0, 1.6, 2.62), C.white, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "БИОГАЗ", { color = Color3.fromRGB(40, 120, 50) })
end

function Models.BiogasTurbine(b: Builder)
	b:box(V(7, 0.4, 6), V(0, 0.2, 0), C.metalDark, M.DiamondPlate)
	b:cylX(4, 2.6, V(-1, 2, 0), C.white, M.Metal)
	b:cylX(0.4, 2.9, V(1.1, 2, 0), C.blue, M.Metal)
	b:box(V(2.2, 2.6, 2.6), V(2.4, 1.7, 0), C.blue, M.Metal)
	b:cylX(1.2, 1.4, V(-3.4, 2, 0), C.metalDark, M.Metal)
	local stack = b:cyl(3.4, 0.7, V(-1.5, 4.6, -1.8), C.metal, M.Metal)
	smoke(stack, Color3.fromRGB(200, 200, 200), 0.1)
	local label = b:box(V(2, 0.6, 0.05), V(2.4, 2.4, 1.31), C.white, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "250 кВт", { color = C.blue })
end

local function panel(b: Builder, w: number, d: number, pos: Vector3, tilt: number)
	local p =
		b:box(V(w, 0.12, d), pos, Color3.fromRGB(25, 45, 110), M.Glass, { rot = V(tilt, 0, 0), reflectance = 0.2 })
	b:box(V(w + 0.15, 0.08, d + 0.15), pos - V(0, 0.07, 0), C.metal, M.Metal, { rot = V(tilt, 0, 0), collide = false })
	for i = 1, 2 do
		b:box(
			V(0.04, 0.13, d),
			pos + V(-w / 2 + i * w / 3, 0.01, 0),
			C.metal,
			M.Metal,
			{ rot = V(tilt, 0, 0), collide = false }
		)
	end
	return p
end

function Models.SolarSmall(b: Builder)
	-- скатная «крыша» с панелями
	b:box(V(3.8, 1, 3.8), V(0, 0.5, 0), C.woodDark, M.WoodPlanks)
	b:wedge(V(3.8, 1.6, 3.8), V(0, 1.8, 0), Color3.fromRGB(150, 70, 50), M.Slate)
	panel(b, 3.4, 1.7, V(0, 2.05, 0.8), 22)
	panel(b, 3.4, 1.7, V(0, 1.4, -0.75), 22)
end

function Models.SolarMono(b: Builder)
	b:cyl(0.4, 1.4, V(0, 0.2, 0), C.concrete, M.Concrete)
	b:cyl(2.2, 0.35, V(0, 1.3, 0), C.metal, M.Metal)
	local array = b:group("Array", V(0, 2.5, 0))
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -0.85, 0.85 }) do
			array:box(
				V(1.9, 0.1, 1.6),
				V(x, 2.5 + z * 0.4, z),
				Color3.fromRGB(20, 30, 80),
				M.Glass,
				{ rot = V(25, 0, 0), reflectance = 0.3 }
			)
		end
	end
	array:box(V(4.1, 0.08, 3.6), V(0, 2.42, 0), C.metal, M.Metal, { rot = V(25, 0, 0), collide = false })
	b:tag(array:groupModel(), "Sway", { Axis = "Y", Amplitude = 20, Speed = 0.2 })
end

local function rotor(b: Builder, hub: Vector3, length: number, width: number, color: Color3, speed: number)
	local g = b:group("Rotor", hub)
	g:cylZ(0.6, 0.7, hub + V(0, 0, 0.2), C.white, M.SmoothPlastic, { collide = false })
	for i = 0, 2 do
		local a = i * 120
		local dir = V(math.cos(math.rad(a + 90)), math.sin(math.rad(a + 90)), 0)
		g:box(
			V(width, length, 0.15),
			hub + dir * (length / 2 + 0.3) + V(0, 0, 0.35),
			color,
			M.SmoothPlastic,
			{ rot = V(0, 0, a), collide = false }
		)
	end
	b:tag(g:groupModel(), "Spin", { Axis = "Z", Speed = speed })
end

function Models.WindSmall(b: Builder)
	b:box(V(2, 0.3, 2), V(0, 0.15, 0), C.concrete, M.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b:pipe(V(sx * 0.9, 0.3, sz * 0.9), V(sx * 0.2, 9, sz * 0.2), 0.18, C.metal, M.Metal)
		end
	end
	b:box(V(0.7, 0.6, 1.4), V(0, 9.3, 0), C.white, M.SmoothPlastic)
	b:box(V(0.1, 1, 1.4), V(0, 9.5, -1.3), C.red, M.SmoothPlastic, { collide = false })
	rotor(b, V(0, 9.3, 0.8), 3.2, 0.5, C.white, 160)
end

function Models.Wind50(b: Builder)
	b:cyl(0.5, 3, V(0, 0.25, 0), C.concrete, M.Concrete)
	b:cyl(17, 0.9, V(0, 8.9, 0), C.white, M.SmoothPlastic)
	b:box(V(1.4, 1.3, 3), V(0, 17.9, 0), C.white, M.SmoothPlastic)
	rotor(b, V(0, 17.9, 1.8), 7.5, 0.9, C.white, 70)
	local blink = b:ball(0.35, V(0, 18.7, -0.8), C.red, M.Neon, { collide = false })
	b:tag(blink, "Pulse", { Speed = 1 })
end

function Models.Geothermal(b: Builder)
	b:box(V(5.6, 0.3, 5.6), V(0, 0.15, 0), C.concrete, M.Concrete)
	b:box(V(3.4, 3.2, 3), V(-0.8, 1.9, -0.8), C.white, M.Metal)
	b:box(V(3.6, 0.3, 3.2), V(-0.8, 3.65, -0.8), C.red, M.Metal)
	-- скважины и трубы горячего пара
	for i, x in ipairs({ 1.4, 2.2 }) do
		b:cyl(0.6, 0.9, V(x, 0.3, 1.8), C.metalDark, M.Metal)
		b:pipe(V(x, 0.5, 1.8), V(x, 2.6, 1.8), 0.4, if i == 1 then C.red else C.blue)
		b:pipe(V(x, 2.6, 1.8), V(0.9, 2.6, 0), 0.4, if i == 1 then C.red else C.blue)
	end
	local vent = b:cyl(1.2, 0.8, V(-1.8, 4.3, -1.6), C.metal, M.Metal)
	smoke(vent, Color3.fromRGB(240, 240, 240), 0.2)
	local label = b:box(V(2.6, 0.6, 0.05), V(-0.8, 2.6, 0.71), C.white, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "ГЕОТЕРМ 300 кВт", { color = C.red })
end

function Models.Substation(b: Builder)
	b:box(V(6, 0.3, 5), V(0, 0.15, 0), C.concrete, M.Concrete)
	for _, x in ipairs({ -1.5, 1.5 }) do
		b:box(V(2, 2.4, 2), V(x, 1.5, -0.5), C.metalDark, M.Metal, { name = "Transformer" })
		for k = -2, 2 do
			b:box(V(0.1, 2, 2.2), V(x + k * 0.22, 1.4, -0.5), C.metal, M.Metal, { collide = false })
		end
		for k = -1, 1 do
			local ix = x + k * 0.6
			for y = 0, 3 do
				b:cyl(0.18, 0.4 - y * 0.03, V(ix, 2.85 + y * 0.22, -0.5), C.white, M.SmoothPlastic, { collide = false })
			end
		end
	end
	b:pipe(V(-2.1, 3.7, -0.5), V(2.1, 3.7, -0.5), 0.08, C.black)
	-- ограждение
	for _, x in ipairs({ -2.9, 2.9 }) do
		b:box(V(0.1, 2, 4.8), V(x, 1, 0), C.metal, M.DiamondPlate, { transparency = 0.5, collide = false })
	end
	local sign = b:box(V(1.4, 1, 0.05), V(0, 1.3, 2.4), C.yellow, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "⚡ ОПАСНО", { color = C.black })
	b.model:SetAttribute("Sparks", true)
end

function Models.Battery(b: Builder)
	b:box(V(4, 0.3, 4), V(0, 0.15, 0), C.concrete, M.Concrete)
	for _, x in ipairs({ -1, 1 }) do
		b:box(V(1.6, 2.6, 3.4), V(x, 1.6, 0), C.white, M.SmoothPlastic)
		for z = -1.2, 1.2, 0.6 do
			local led = b:box(V(0.05, 0.15, 0.3), V(x + 0.82 * x, 2.4, z), C.green, M.Neon, { collide = false })
			b:tag(led, "Pulse", { Speed = 1 + z })
		end
	end
	local sign = b:box(V(1.8, 0.5, 0.05), V(0, 3.1, 1.71), C.white, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "50 кВт*ч", { color = C.green })
end

function Models.Megapack(b: Builder)
	b:box(V(6, 0.3, 3.8), V(0, 0.15, 0), C.concrete, M.Concrete)
	local body = b:box(V(5.8, 2.8, 3.2), V(0, 1.7, 0), Color3.fromRGB(215, 218, 222), M.Metal)
	for x = -2.2, 2.2, 1.1 do
		b:box(V(0.05, 2.4, 3.3), V(x, 1.7, 0), C.metal, M.Metal, { collide = false })
	end
	b:label(body, Enum.NormalId.Back, "MEGAPACK", { color = C.red, background = Color3.fromRGB(215, 218, 222) })
	local led = b:box(V(5, 0.12, 0.05), V(0, 3.0, 1.62), C.cyan, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 0.7 })
end

function Models.PotatoReactor(b: Builder)
	b:cyl(0.6, 4.4, V(0, 0.3, 0), C.metalDark, M.Metal)
	b:cyl(3.6, 3.6, V(0, 2.4, 0), Color3.fromRGB(150, 255, 150), M.Glass, { transparency = 0.6 })
	b:cyl(2.8, 3.4, V(0, 2.0, 0), Color3.fromRGB(110, 255, 90), M.Neon, { transparency = 0.6, collide = false })
	local tuber = b:potato(V(0, 2.3, 0), 3.2, Color3.fromRGB(190, 140, 70), { collide = false, rot = V(0, 0, 20) })
	b:tag(tuber, "Bob", { Amplitude = 0.3, Speed = 1.2 })
	b:cyl(0.5, 4.2, V(0, 4.45, 0), C.metalDark, M.Metal)
	for _, x in ipairs({ -1, 1 }) do
		b:cyl(2.2, 0.25, V(x, 3.5, 0), Color3.fromRGB(200, 120, 60), M.Metal, { collide = false })
	end
	local sparks = Instance.new("Sparkles")
	sparks.SparkleColor = Color3.fromRGB(150, 255, 120)
	sparks.Parent = tuber
	b:light(tuber, Color3.fromRGB(140, 255, 120), 12, 2)
end

function Models.Fusion(b: Builder)
	b:box(V(6, 0.4, 6), V(0, 0.2, 0), C.metalDark, M.DiamondPlate)
	b:cyl(1.6, 2, V(0, 1.2, 0), C.metal, M.Metal)
	local ring = b:group("Torus", V(0, 3.2, 0))
	for i = 0, 15 do
		local a = math.rad(i * 22.5)
		ring:ball(1.3, V(math.cos(a) * 2.2, 3.2, math.sin(a) * 2.2), C.metal, M.Metal, { collide = false })
	end
	for i = 0, 7 do
		local a = math.rad(i * 45 + 11)
		ring:box(V(0.3, 1.5, 0.3), V(math.cos(a) * 2.2, 3.2, math.sin(a) * 2.2), C.orange, M.Neon, { collide = false })
	end
	b:tag(ring:groupModel(), "Spin", { Axis = "Y", Speed = 40 })
	local plasma = b:ball(1.6, V(0, 3.2, 0), Color3.fromRGB(255, 90, 220), M.Neon, { collide = false })
	b:light(plasma, Color3.fromRGB(255, 120, 230), 18, 3)
	b:tag(plasma, "Pulse", { Speed = 3 })
end

function Models.Office(b: Builder)
	local wall = Color3.fromRGB(205, 210, 215)
	b:box(V(7, 0.3, 6), V(0, 0.15, 0), C.concrete, M.Concrete)
	b:box(V(7, 4, 0.3), V(0, 2.15, -2.85), wall, M.Metal)
	b:box(V(0.3, 4, 6), V(-3.35, 2.15, 0), wall, M.Metal)
	b:box(V(0.3, 4, 6), V(3.35, 2.15, 0), wall, M.Metal)
	-- фасад с дверью и окном
	b:box(V(2.5, 4, 0.3), V(-2.25, 2.15, 2.85), wall, M.Metal)
	b:box(V(2.6, 1.2, 0.3), V(2.2, 0.75, 2.85), wall, M.Metal)
	b:box(V(2.6, 1.6, 0.15), V(2.2, 2.15, 2.85), C.glass, M.Glass, { transparency = 0.5 })
	b:box(V(2.6, 1.2, 0.3), V(2.2, 3.55, 2.85), wall, M.Metal)
	b:box(V(2, 1, 0.3), V(-0.1, 3.65, 2.85), wall, M.Metal)
	b:box(V(7.4, 0.3, 6.4), V(0, 4.3, 0), C.metalDark, M.Metal)
	local sign = b:box(V(3, 0.8, 0.1), V(0, 4.85, 3.0), C.blue, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "ОФИС", { color = C.white })
	-- интерьер: стол, кресло, мониторинг биржи, кулер, шкаф (ГДД 173–177)
	b:box(V(2.6, 0.15, 1.2), V(0.6, 1.1, -1.6), C.woodDark, M.Wood)
	b:box(V(0.15, 0.95, 1.1), V(-0.6, 0.6, -1.6), C.woodDark, M.Wood)
	b:box(V(0.15, 0.95, 1.1), V(1.8, 0.6, -1.6), C.woodDark, M.Wood)
	b:box(V(0.9, 0.2, 0.9), V(0.6, 0.75, -0.5), C.black, M.Fabric)
	b:box(V(0.9, 1.1, 0.2), V(0.6, 1.4, -0.1), C.black, M.Fabric)
	local screen = b:box(V(1.4, 0.8, 0.08), V(0.6, 1.65, -2.05), C.black, M.SmoothPlastic, { collide = false })
	b:label(screen, Enum.NormalId.Back, "📈 БИРЖА", { color = C.green, background = C.black })
	b:cyl(1.3, 0.6, V(-2.6, 0.65, -2.2), C.white, M.SmoothPlastic)
	b:cyl(0.7, 0.55, V(-2.6, 1.65, -2.2), Color3.fromRGB(120, 190, 255), M.Glass, { transparency = 0.3 })
	b:box(V(1, 2.4, 0.7), V(2.6, 1.35, -2.3), C.metal, M.Metal)
	openMenu(sign, "Staff", "Нанять персонал", "Офис менеджера")
end

function Models.DroneStation(b: Builder)
	b:box(V(8, 0.3, 6), V(0, 0.15, 0), C.asphalt, M.Concrete)
	-- арочный ангар
	b:cylZ(4, 5, V(-1.6, 0.3, -0.8), C.metal, M.CorrodedMetal)
	b:box(V(5, 0.4, 4), V(-1.6, 0, -0.8), C.asphalt, M.Concrete)
	b:box(V(3, 2.2, 0.1), V(-1.6, 1.2, 1.25), C.black, M.Metal, { collide = false })
	-- посадочные площадки
	for i, z in ipairs({ -1.6, 1.4 }) do
		local pad = b:cyl(0.12, 2.4, V(2.6, 0.36, z), C.yellow, M.SmoothPlastic)
		b:label(pad, Enum.NormalId.Top, "H", { color = C.black })
		local ring = b:cyl(0.06, 2.6, V(2.6, 0.32, z), C.cyan, M.Neon, { collide = false })
		b:tag(ring, "Pulse", { Speed = 1 + i * 0.5 })
	end
	local sign = b:box(V(3.2, 0.7, 0.1), V(-1.6, 3.2, 1.2), C.white, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "ДРОНЫ", { color = C.blue })
	openMenu(sign, "Staff", "Нанять дронов", "Станция дронов")
end

function Models.AiSorter(b: Builder)
	b:box(V(4, 0.3, 4), V(0, 0.15, 0), C.metalDark, M.DiamondPlate)
	b:box(V(2.8, 1.8, 2), V(0, 1.2, -0.6), C.white, M.SmoothPlastic)
	local eye = b:ball(0.8, V(0, 2.4, 0.4), C.black, M.SmoothPlastic, { collide = false })
	local lens = b:ball(0.35, V(0, 2.4, 0.75), C.red, M.Neon, { collide = false })
	b:tag(lens, "Pulse", { Speed = 2 })
	local _ = eye
	local arm = b:group("Arm", V(1.2, 2.1, 0))
	arm:box(V(0.3, 1.6, 0.3), V(1.2, 2.9, 0), C.orange, M.Metal, { collide = false })
	arm:box(V(1.4, 0.3, 0.3), V(0.6, 3.6, 0), C.orange, M.Metal, { collide = false })
	b:tag(arm:groupModel(), "Sway", { Axis = "Y", Amplitude = 50, Speed = 1.2 })
	for i, color in ipairs({ C.green, Color3.fromRGB(110, 80, 50) }) do
		b:box(V(1.2, 1, 1.2), V(-2 + i * 1.3, 0.8, 1.3), color, M.SmoothPlastic)
	end
	local label = b:box(V(2.2, 0.5, 0.05), V(0, 1.6, 0.41), C.black, M.SmoothPlastic, { collide = false })
	b:label(label, Enum.NormalId.Back, "ИИ-ОТК", { color = C.cyan })
end

function Models.CoolingTower(b: Builder)
	local radii = { 4.6, 4.1, 3.6, 3.2, 3.0, 3.1, 3.4 }
	for i, d in ipairs(radii) do
		b:cyl(1, d, V(0, i - 0.5, 0), Color3.fromRGB(200, 200, 195), M.Concrete)
	end
	local top = b:cyl(0.2, 3.2, V(0, #radii + 0.1, 0), C.stoneDark, M.Concrete, { collide = false })
	local steam = Instance.new("Smoke")
	steam.Color = Color3.fromRGB(245, 245, 250)
	steam.Opacity = 0.25
	steam.RiseVelocity = 5
	steam.Size = 4
	steam.Parent = top
	b:box(V(0.2, 0.6, 3.4), V(0, 0.3, 0), C.red, M.SmoothPlastic, { collide = false, transparency = 1 })
end

function Models.Breaker(b: Builder)
	b:box(V(1.6, 2.6, 0.8), V(-0.6, 1.3, -0.4), C.metal, M.Metal)
	b:box(V(1.2, 0.3, 0.05), V(-0.6, 2.2, 0.01), C.yellow, M.SmoothPlastic, { collide = false })
	-- рубильник
	local lever = b:group("Lever", V(-0.6, 1.4, 0.1))
	lever:box(V(0.15, 0.8, 0.15), V(-0.6, 1.7, 0.15), C.metalDark, M.Metal, { collide = false })
	lever:box(V(0.5, 0.2, 0.2), V(-0.6, 2.1, 0.15), C.red, M.SmoothPlastic, { collide = false })
	-- шкаф автоматики
	b:box(V(1, 1.8, 0.6), V(0.8, 0.9, -0.5), Color3.fromRGB(80, 90, 110), M.Metal)
	for i = 0, 2 do
		local led = b:box(
			V(0.15, 0.15, 0.05),
			V(0.55 + i * 0.25, 1.5, -0.19),
			if i == 2 then C.red else C.green,
			M.Neon,
			{ collide = false }
		)
		b:tag(led, "Pulse", { Speed = 1 + i })
	end
end

return Models
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Factory</string>
              <string name="Source"><![CDATA[-- Модели сектора 2: фабричный корпус и автономные модули-множители

local Kit = require(script.Parent.Parent.ModelKit)

type Builder = Kit.Builder

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local Models = {}

local function steam(part: BasePart, opacity: number?)
	local s = Instance.new("Smoke")
	s.Color = Color3.fromRGB(245, 245, 245)
	s.Opacity = opacity or 0.12
	s.RiseVelocity = 3
	s.Size = 1.2
	s.Parent = part
end

local function particles(part: BasePart, color: Color3, rate: number, speed: number, size: number)
	local p = Instance.new("ParticleEmitter")
	p.Color = ColorSequence.new(color)
	p.Size = NumberSequence.new(size, size * 0.3)
	p.Transparency = NumberSequence.new(0.2, 1)
	p.Lifetime = NumberRange.new(0.6, 1.2)
	p.Rate = rate
	p.Speed = NumberRange.new(speed * 0.6, speed)
	p.SpreadAngle = Vector2.new(30, 30)
	p.Parent = part
	return p
end

local function sign(b: Builder, text: string, color: Color3, pos: Vector3)
	local s = b:box(V(3.2, 0.6, 0.08), pos, C.black, M.SmoothPlastic, { collide = false })
	b:label(s, Enum.NormalId.Back, text, { color = color })
end

-- Корпус цеха 78x19 (overlay): стены, окна, ворота, стеклянная крыша, колонны, мостик, лампы
function Models.FactoryHall(b: Builder)
	local W, D, H = 78, 19, 9
	local wallColor = Color3.fromRGB(185, 190, 196)
	local hw, hd = W / 2, D / 2
	-- пол
	b:box(V(W, 0.2, D), V(0, 0.1, 0), Color3.fromRGB(150, 150, 150), M.Concrete, { collide = false })
	-- торцевые стены
	b:box(V(0.5, H, D), V(-hw, H / 2, 0), wallColor, M.Metal)
	b:box(V(0.5, H, D), V(hw, H / 2, 0), wallColor, M.Metal)
	-- южная (к энергоблоку) и северная стены с проёмами на дорожке x ∈ [-4, 4]
	for _, z in ipairs({ hd, -hd }) do
		for _, sx in ipairs({ -1, 1 }) do
			local len = hw - 4
			local cx = sx * (4 + len / 2)
			b:box(V(len, 3, 0.5), V(cx, 1.5, z), wallColor, M.Metal)
			-- панорамные окна (ГДД 159)
			b:box(V(len, 2.6, 0.2), V(cx, 4.3, z), C.glass, M.Glass, { transparency = 0.55 })
			b:box(V(len, H - 5.6, 0.5), V(cx, 5.6 + (H - 5.6) / 2, z), wallColor, M.Metal)
		end
		-- над воротами
		b:box(V(8, H - 6, 0.5), V(0, 6 + (H - 6) / 2, z), wallColor, M.Metal)
		-- рама ворот ангара (ГДД 160)
		b:box(V(0.6, 6, 0.7), V(-4.1, 3, z), C.yellow, M.Metal)
		b:box(V(0.6, 6, 0.7), V(4.1, 3, z), C.yellow, M.Metal)
		b:box(V(8.8, 0.6, 0.7), V(0, 6, z), C.yellow, M.Metal)
	end
	-- стеклянная крыша с фонарями верхнего света (ГДД 162–163)
	b:box(
		V(W, 0.2, D),
		V(0, H + 0.1, 0),
		Color3.fromRGB(200, 230, 245),
		M.Glass,
		{ transparency = 0.7, collide = false, shadow = false }
	)
	for x = -hw + 2, hw - 2, 6.5 do
		b:box(V(0.4, 0.5, D), V(x, H + 0.25, 0), C.metalDark, M.Metal, { collide = false })
		-- двутавровые колонны (ГДД 164)
		b:box(V(0.5, H, 0.5), V(x, H / 2, hd - 0.6), C.metalDark, M.Metal)
		b:box(V(0.5, H, 0.5), V(x, H / 2, -hd + 0.6), C.metalDark, M.Metal)
		-- цеховые лампы (ГДД 182)
		local lamp = b:box(V(0.4, 0.15, 3), V(x + 3.2, H - 0.4, 0), C.white, M.Neon, { collide = false })
		if math.floor((x + hw) / 6.5) % 2 == 0 then
			b:light(lamp, Color3.fromRGB(240, 245, 255), 16, 1, true)
		end
	end
	-- мостик инспектора вдоль северной стены и лестница (ГДД 165–166)
	b:box(V(W - 2, 0.25, 1.4), V(0, 6.4, -hd + 1.2), C.metal, M.DiamondPlate, { collide = false })
	b:box(V(W - 2, 0.1, 0.1), V(0, 7.4, -hd + 1.85), C.yellow, M.Metal, { collide = false })
	for i = 0, 8 do
		b:box(
			V(1.2, 0.2, 0.7),
			V(-hw + 1.6, 0.7 * i + 0.3, -hd + 2.4 + (8 - i) * 0.55),
			C.metal,
			M.DiamondPlate,
			{ collide = false }
		)
	end
	-- пожарный щит и аптечка (ГДД 178–179)
	local fire =
		b:box(V(1.6, 2, 0.15), V(-hw + 0.4, 2.2, 3), C.red, M.SmoothPlastic, { rot = V(0, 90, 0), collide = false })
	b:label(fire, Enum.NormalId.Back, "🧯", { color = C.white })
	local aid =
		b:box(V(0.9, 0.9, 0.2), V(hw - 0.4, 2.4, 3), C.white, M.SmoothPlastic, { rot = V(0, -90, 0), collide = false })
	b:label(aid, Enum.NormalId.Back, "✚", { color = C.red })
	-- отбойники у ворот (ГДД 169)
	for _, x in ipairs({ -5.5, 5.5 }) do
		local barrier = b:box(V(1.5, 0.9, 0.6), V(x, 0.45, hd + 1), C.yellow, M.Concrete)
		b:box(V(0.3, 0.9, 0.62), V(x - 0.4, 0.45, hd + 1), C.black, M.Concrete, { collide = false })
		b:box(V(0.3, 0.9, 0.62), V(x + 0.4, 0.45, hd + 1), C.black, M.Concrete, { collide = false })
		local _ = barrier
	end
	-- вывеска
	local s = b:box(V(12, 1.4, 0.3), V(0, H - 1.1, hd + 0.4), C.blue, M.SmoothPlastic, { collide = false })
	b:label(s, Enum.NormalId.Back, "ЗАВОД ПЕРЕРАБОТКИ", { color = C.white })
	-- декор: ящики чипсов и мешки (ГДД 183–184)
	for i = 0, 2 do
		local box = b:box(V(1.2, 0.9, 0.9), V(hw - 1.4, 0.55 + i * 0.9, -hd + 3.2), C.yellow, M.Cardboard)
		b:label(box, Enum.NormalId.Back, "CHIPS", { color = C.red })
	end
	for i = 0, 1 do
		b:ellipsoid(V(1.3, 1.6, 1.1), V(-hw + 1.2 + i * 1.3, 0.8, hd - 2.5), Color3.fromRGB(176, 150, 105), M.Fabric)
	end
end

function Models.Washer(b: Builder)
	b:machine(6, 5, 1.6, C.blue, C.cyan)
	local drum = b:group("Drum", V(-0.3, 3.9, -0.2))
	drum:cylX(4.6, 2.2, V(-0.3, 3.9, -0.2), Color3.fromRGB(80, 150, 220), M.DiamondPlate, { collide = false })
	for x = -2, 1.4, 0.8 do
		drum:cylX(0.15, 2.3, V(x, 3.9, -0.2), C.metal, M.Metal, { collide = false })
	end
	b:tag(drum:groupModel(), "Spin", { Axis = "X", Speed = 90 })
	local spray = b:box(V(4, 0.2, 0.2), V(-0.3, 5.3, -0.2), C.metal, M.Metal, { collide = false })
	local p = particles(spray, Color3.fromRGB(150, 210, 255), 25, 4, 0.3)
	p.EmissionDirection = Enum.NormalId.Bottom
	sign(b, "МОЙКА x1.5", C.cyan, V(-0.8, 2.6, 1.76))
end

function Models.Peeler(b: Builder)
	b:machine(6, 5, 1, C.metal, C.orange)
	b:cyl(2.8, 2.6, V(-0.6, 3.8, -0.4), C.steel, M.Metal)
	b:cyl(1, 1.6, V(-0.6, 5.7, -0.4), C.steel, M.Metal)
	local valve = b:cyl(0.6, 0.4, V(-0.6, 6.5, -0.4), C.red, M.Metal, { collide = false })
	steam(valve, 0.2)
	local gauge = b:cylZ(0.15, 0.8, V(0.8, 4.2, 1.0), C.white, M.SmoothPlastic, { collide = false })
	local _ = gauge
	sign(b, "ПИЛЕР +0.5", C.orange, V(-0.8, 2.6, 1.76))
end

function Models.Slicer(b: Builder)
	b:machine(6, 5, 1.4, C.yellow, C.red)
	b:wedge(V(2.4, 1.6, 2), V(-1.2, 4.1, -0.4), C.metal, M.Metal, { rot = V(0, 180, 0) })
	local blade = b:group("Blade", V(1, 3.6, -0.2))
	blade:cylX(0.2, 2.6, V(1, 3.8, -0.2), C.metal, M.Metal, { rot = V(0, 0, 90), collide = false })
	for i = 0, 3 do
		blade:box(V(0.05, 0.2, 2.4), V(1, 3.85, -0.2), C.white, M.Metal, { rot = V(0, i * 45, 0), collide = false })
	end
	b:tag(blade:groupModel(), "Spin", { Axis = "Y", Speed = 400 })
	-- готовые чипсы
	for i = 1, 6 do
		b:cyl(
			0.05,
			0.5,
			V(1.6 + (i % 3) * 0.3, 3.05, 1.2 + (i % 2) * 0.3),
			C.yellow,
			M.SmoothPlastic,
			{ collide = false }
		)
	end
	sign(b, "ЧИПСЫ x2.5", C.yellow, V(-0.8, 2.6, 1.76))
	b.model:SetAttribute("Sound", "Blade")
end

function Models.Fryer(b: Builder)
	b:machine(6, 5, 1, C.metal, C.orange)
	b:box(V(5, 1.2, 3.2), V(0, 3, -0.2), C.steel, M.Metal)
	b:box(
		V(4.6, 0.1, 2.8),
		V(0, 3.62, -0.2),
		Color3.fromRGB(240, 160, 40),
		M.Neon,
		{ collide = false, transparency = 0.2 }
	)
	b:wedge(V(5, 1.4, 1.6), V(0, 4.4, -1.1), C.metal, M.Metal, { rot = V(0, 180, 0), collide = false })
	local hood = b:box(V(5, 0.3, 1.6), V(0, 5.2, -0.9), C.metal, M.Metal, { collide = false })
	local chimney = b:cyl(1.6, 0.6, V(0, 6, -1.2), C.metal, M.Metal)
	steam(chimney, 0.18)
	local _ = hood
	sign(b, "ФРИТЮР x4", C.orange, V(-0.8, 2.6, 1.76))
	b.model:SetAttribute("Sound", "Sizzle")
end

function Models.SpiceDrum(b: Builder)
	b:machine(6, 5, 1, Color3.fromRGB(150, 70, 40), C.yellow)
	local drum = b:group("Drum", V(0, 4, -0.2))
	drum:cylX(4.4, 2.4, V(0, 4, -0.2), C.orange, M.Metal, { rot = V(0, 0, 8), collide = false })
	drum:cylX(0.2, 2.5, V(-1.5, 4.2, -0.2), C.red, M.Metal, { rot = V(0, 0, 8), collide = false })
	drum:cylX(0.2, 2.5, V(1.5, 3.8, -0.2), C.red, M.Metal, { rot = V(0, 0, 8), collide = false })
	b:tag(drum:groupModel(), "Spin", { Axis = "X", Speed = 60 })
	local hopper =
		b:wedge(V(1.2, 1.4, 1.2), V(-1.6, 5.9, -0.2), C.red, M.Metal, { rot = V(180, 0, 0), collide = false })
	particles(hopper, Color3.fromRGB(230, 120, 40), 10, 2, 0.15)
	sign(b, "СПЕЦИИ x6", C.yellow, V(-0.8, 2.6, 1.76))
end

function Models.PureeVat(b: Builder)
	b:machine(6, 5, 0.6, C.metal, C.yellow)
	b:cyl(2.6, 3.6, V(-0.4, 3.3, -0.3), C.steel, M.Metal)
	b:cyl(0.1, 3.3, V(-0.4, 4.62, -0.3), Color3.fromRGB(250, 235, 170), M.SmoothPlastic, { collide = false })
	local mixer = b:group("Mixer", V(-0.4, 5.2, -0.3))
	mixer:cyl(1.6, 0.25, V(-0.4, 5.4, -0.3), C.metal, M.Metal, { collide = false })
	mixer:box(V(2.6, 0.15, 0.3), V(-0.4, 4.8, -0.3), C.metal, M.Metal, { collide = false })
	b:tag(mixer:groupModel(), "Spin", { Axis = "Y", Speed = 70 })
	b:box(V(0.6, 1.2, 0.6), V(-0.4, 6.6, -0.3), C.blue, M.Metal, { collide = false })
	sign(b, "ПЮРЕ +1", C.yellow, V(-0.8, 2.6, 1.76))
end

function Models.Packer(b: Builder)
	b:machine(6, 5, 2.2, C.white, C.blue)
	b:box(V(1.4, 1.6, 1.4), V(-1.5, 5.2, -0.4), C.metal, M.Metal)
	-- пачки снеков
	local colors = { C.red, C.yellow, C.blue, C.green }
	for i = 0, 5 do
		b:box(
			V(0.7, 0.95, 0.3),
			V(1 + (i % 3) * 0.75, 4.15 + (i // 3) * 0.95, 0.4),
			colors[i % 4 + 1],
			M.Foil,
			{ collide = false }
		)
	end
	sign(b, "УПАКОВКА +0.5", C.blue, V(-0.8, 2.6, 1.76))
end

function Models.CryoTunnel(b: Builder)
	b:machine(6, 5, 1, C.white, C.cyan)
	b:box(V(5.4, 2.2, 3), V(0, 3.4, -0.2), Color3.fromRGB(225, 240, 250), M.Metal)
	b:box(V(5.6, 0.3, 3.2), V(0, 4.6, -0.2), Color3.fromRGB(190, 230, 250), M.Ice)
	b:box(V(1.6, 1.2, 0.1), V(0, 3.4, 1.31), C.cyan, M.Neon, { collide = false, transparency = 0.3 })
	for _, x in ipairs({ -2.2, -1.5 }) do
		b:cyl(2.6, 0.6, V(x, 6.0, -1.2), C.blue, M.Metal)
	end
	local frost = b:box(V(5, 0.2, 0.2), V(0, 2.3, 1.3), C.white, M.Ice, { collide = false })
	particles(frost, Color3.fromRGB(230, 245, 255), 15, 1, 0.6).Acceleration = V(0, -1, 0)
	sign(b, "КРИО x10", C.cyan, V(-0.8, 2.6, 1.76))
end

function Models.Sublimator(b: Builder)
	b:machine(6, 5, 0.6, C.metal, C.purple)
	b:cylX(4.6, 2.8, V(0, 3.6, -0.3), C.steel, M.Metal)
	local hatch = b:cylX(0.3, 2.2, V(2.4, 3.6, -0.3), C.metalDark, M.Metal)
	b:cylX(0.1, 1.2, V(2.6, 3.6, -0.3), C.purple, M.Neon, { collide = false, transparency = 0.2 })
	b:box(V(1.2, 1.2, 1.2), V(-1.8, 5.3, -0.3), C.purple, M.Metal)
	b:pipe(V(-1.8, 4.7, -0.3), V(-1.8, 4.9, -0.3), 0.3, C.black)
	b:light(hatch, C.purple, 8, 1)
	sign(b, "СУБЛИМАЦИЯ x18", C.purple, V(-0.8, 2.6, 1.76))
end

function Models.Autoclave(b: Builder)
	b:machine(6, 5, 0.6, C.metal, C.red)
	b:cylX(4.4, 2.8, V(-0.3, 3.6, -0.3), Color3.fromRGB(170, 170, 160), M.Metal)
	local door = b:cylX(0.4, 2.9, V(2.05, 3.6, -0.3), C.red, M.Metal)
	b:cylX(0.2, 0.8, V(2.35, 3.6, -0.3), C.yellow, M.Metal, { collide = false })
	local vent = b:cyl(0.8, 0.4, V(-1.2, 5.3, -0.3), C.metal, M.Metal)
	steam(vent, 0.2)
	local _ = door
	sign(b, "АВТОКЛАВ +1.5", C.red, V(-0.8, 2.6, 1.76))
end

function Models.StarchMill(b: Builder)
	b:machine(6, 5, 0.6, C.metal, C.white)
	local stones = b:group("Stones", V(-0.8, 3, -0.3))
	stones:cyl(0.8, 2.8, V(-0.8, 2.6, -0.3), C.stone, M.Granite, { collide = false })
	stones:cyl(0.8, 2.8, V(-0.8, 3.5, -0.3), C.stoneDark, M.Granite, { collide = false })
	b:tag(stones:groupModel(), "Spin", { Axis = "Y", Speed = 50 })
	b:box(V(1.8, 2.6, 1.8), V(1.6, 3.3, -0.3), C.steel, M.Metal)
	b:ellipsoid(V(1.6, 0.8, 1.2), V(1.6, 2.4, 1.3), C.white, M.Sand, { collide = false })
	sign(b, "КРАХМАЛ +2", C.white, V(-0.8, 2.6, 1.76))
end

function Models.Bioreactor(b: Builder)
	b:box(V(8, 0.4, 5), V(0, 0.2, 0), C.metalDark, M.DiamondPlate)
	for i, x in ipairs({ -2.6, 0 }) do
		b:cyl(5, 2.4, V(x, 2.9, -0.6), C.steel, M.Metal)
		b:ellipsoid(V(2.4, 1, 2.4), V(x, 5.4, -0.6), C.steel, M.Metal)
		local window = b:box(
			V(0.8, 2.6, 0.1),
			V(x, 2.9, 0.62),
			Color3.fromRGB(120, 255, 80),
			M.Neon,
			{ collide = false, transparency = 0.25 }
		)
		local bubbles = particles(window, Color3.fromRGB(200, 255, 180), 6, 1, 0.2)
		bubbles.EmissionDirection = Enum.NormalId.Top
		bubbles.Lifetime = NumberRange.new(1.5, 2.5)
		if i == 1 then
			b:light(window, Color3.fromRGB(120, 255, 80), 8, 1)
		end
	end
	-- ректификационная колонна биоэтанола (ГДД 76)
	b:cyl(7.5, 0.9, V(2.8, 4.15, -1), C.metal, M.Metal)
	for y = 1.2, 7.2, 1 do
		b:cyl(0.15, 1.2, V(2.8, y, -1), C.yellow, M.Metal, { collide = false })
	end
	b:pipe(V(0, 4.5, -0.6), V(2.8, 6.5, -1), 0.25, C.metal)
	sign(b, "БИОРЕАКТОР x35", Color3.fromRGB(120, 255, 80), V(-1.3, 1.6, 2.45))
end

function Models.Extruder(b: Builder)
	b:machine(6, 5, 0.6, C.metal, C.yellow)
	b:cylX(4.8, 1.2, V(-0.2, 3, -0.3), C.steel, M.Metal)
	local screw = b:group("Screw", V(-0.2, 3, -0.3))
	for x = -2, 2, 0.5 do
		screw:box(V(0.1, 1.15, 0.2), V(x, 3, -0.3), C.yellow, M.Metal, { rot = V(x * 70, 0, 0), collide = false })
	end
	b:tag(screw:groupModel(), "Spin", { Axis = "X", Speed = 200 })
	b:box(V(1.4, 2, 1.4), V(-2.2, 4.4, -0.3), C.yellow, M.Metal)
	for i = 0, 4 do
		b:cylX(1.6, 0.15, V(2.8, 2.5 + i * 0.15, 0.2 + (i % 2) * 0.2), C.potato, M.SmoothPlastic, { collide = false })
	end
	sign(b, "ПАЛОЧКИ +1", C.yellow, V(-0.8, 2.6, 1.76))
end

function Models.QuantumConverter(b: Builder)
	b:cyl(0.6, 9.4, V(0, 0.3, 0), C.metalDark, M.DiamondPlate)
	b:cyl(0.2, 8, V(0, 0.65, 0), C.purple, M.Neon, { collide = false, transparency = 0.4 })
	local ring = b:group("Ring", V(0, 4.3, 0))
	for i = 0, 19 do
		local a = math.rad(i * 18)
		ring:box(
			V(0.9, 0.9, 0.9),
			V(math.cos(a) * 3.4, 4.3 + math.sin(a) * 3.4, 0),
			if i % 2 == 0 then C.purple else C.cyan,
			M.Neon,
			{ rot = V(0, 0, i * 18), collide = false }
		)
	end
	b:tag(ring:groupModel(), "Spin", { Axis = "Z", Speed = 50 })
	for _, x in ipairs({ -3.8, 3.8 }) do
		b:box(V(0.8, 4.6, 1.4), V(x, 2.6, 0), C.black, M.Metal)
	end
	local core = b:potato(V(0, 4.3, 0), 2.2, C.gold, { collide = false })
	core.Material = M.Neon
	b:tag(core, "Bob", { Amplitude = 0.35, Speed = 1.5 })
	b:light(core, C.purple, 20, 3)
	local sparks = Instance.new("Sparkles")
	sparks.SparkleColor = C.purple
	sparks.Parent = core
	local s = b:box(V(4, 0.7, 0.1), V(0, 1.3, 4.3), C.black, M.SmoothPlastic, { collide = false })
	b:label(s, Enum.NormalId.Back, "КВАНТ x100", { color = C.purple })
end

return Models
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Misc</string>
              <string name="Source"><![CDATA[-- Кнопки покупки, вредители, персонал, лопата и объекты центральной площади

local Kit = require(script.Parent.Parent.ModelKit)

type Builder = Kit.Builder

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local Models = {}

local BUTTON_COLORS = {
	Buy = Color3.fromRGB(60, 210, 90), -- ГДД 189: зелёная «Купить»
	Locked = Color3.fromRGB(215, 60, 55), -- ГДД 191: красная «Закрыто»
	Vip = Color3.fromRGB(255, 200, 40), -- ГДД 190: жёлтая VIP за робуксы
}
Models.ButtonColors = BUTTON_COLORS

-- Напольная кнопка покупки
function Models.Button(b: Builder, title: string, price: string, kind: string)
	b:box(V(3.6, 0.2, 3.6), V(0, 0.1, 0), C.black, M.Metal, { collide = false })
	local pad = b:box(
		V(3, 0.3, 3),
		V(0, 0.3, 0),
		if kind == "Vip" then BUTTON_COLORS.Vip else BUTTON_COLORS.Locked,
		M.Neon,
		{ collide = false, name = "Pad" }
	)
	pad.CanTouch = true
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(220, 64)
	gui.StudsOffset = V(0, 2.6, 0)
	gui.MaxDistance = 48
	gui.LightInfluence = 0
	gui.Parent = pad
	local name = Instance.new("TextLabel")
	name.Name = "Title"
	name.Size = UDim2.fromScale(1, 0.55)
	name.BackgroundTransparency = 1
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.2
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.Text = title
	name.Parent = gui
	local cost = Instance.new("TextLabel")
	cost.Name = "Price"
	cost.Position = UDim2.fromScale(0, 0.55)
	cost.Size = UDim2.fromScale(1, 0.45)
	cost.BackgroundTransparency = 1
	cost.TextColor3 = if kind == "Vip" then BUTTON_COLORS.Vip else BUTTON_COLORS.Buy
	cost.TextStrokeTransparency = 0.2
	cost.Font = Enum.Font.GothamBlack
	cost.TextScaled = true
	cost.Text = price
	cost.Parent = gui
	return pad
end

-- Колорадский жук (ГДД 122–124). boss = Гигантский Жук-Мутант
function Models.Bug(b: Builder, boss: boolean)
	local s = if boss then 3 else 1
	local shell = Color3.fromRGB(240, 205, 110)
	b:ellipsoid(V(1.5, 0.9, 1.9) * s, V(0, 0.55 * s, 0), shell, M.SmoothPlastic, { collide = false })
	for i = -2, 2 do
		b:box(
			V(0.12, 0.08, 1.5) * s,
			V(i * 0.26 * s, 0.98 * s, -0.05 * s),
			C.black,
			M.SmoothPlastic,
			{ collide = false, rot = V(-8, 0, 0) }
		)
	end
	b:ellipsoid(
		V(0.9, 0.55, 0.6) * s,
		V(0, 0.5 * s, 1.05 * s),
		Color3.fromRGB(230, 130, 40),
		M.SmoothPlastic,
		{ collide = false }
	)
	local eyeColor = if boss then Color3.fromRGB(120, 255, 60) else C.black
	local eyeMat = if boss then M.Neon else M.SmoothPlastic
	b:ball(0.2 * s, V(-0.25 * s, 0.6 * s, 1.32 * s), eyeColor, eyeMat, { collide = false })
	b:ball(0.2 * s, V(0.25 * s, 0.6 * s, 1.32 * s), eyeColor, eyeMat, { collide = false })
	for _, side in ipairs({ -1, 1 }) do
		for k = -1, 1 do
			b:box(
				V(0.7, 0.1, 0.1) * s,
				V(side * 0.85 * s, 0.25 * s, k * 0.5 * s),
				C.black,
				M.SmoothPlastic,
				{ collide = false, rot = V(0, k * 20 * side, side * -25) }
			)
		end
	end
	local hitbox = b:box(
		V(2.6, 1.6, 2.8) * s,
		V(0, 0.7 * s, 0.1 * s),
		C.black,
		M.SmoothPlastic,
		{ collide = false, transparency = 1, name = "Hitbox", shadow = false }
	)
	b.model.PrimaryPart = hitbox
	if boss then
		local sparks = Instance.new("Sparkles")
		sparks.SparkleColor = Color3.fromRGB(120, 255, 60)
		sparks.Parent = hitbox
		b:billboard(hitbox, "🪲 ЖУК-МУТАНТ", 3.5, Color3.fromRGB(150, 255, 90), 120)
	end
	return hitbox
end

-- Дроны (ГДД 106–109)
function Models.Drone(b: Builder, color: Color3, rotors: number)
	b:box(V(1.4, 0.5, 1.4), V(0, 0, 0), color, M.SmoothPlastic, { collide = false })
	b:ball(0.5, V(0, -0.1, 0.7), C.black, M.Glass, { collide = false })
	local led = b:box(V(0.3, 0.1, 0.1), V(0, 0.1, 0.72), C.cyan, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 3 })
	for i = 0, rotors - 1 do
		local a = math.rad(i * 360 / rotors + 45)
		local tip = V(math.cos(a) * 1.4, 0.15, math.sin(a) * 1.4)
		b:pipe(V(0, 0.1, 0), tip, 0.15, C.black)
		local rotor = b:group("Rotor" .. i, tip + V(0, 0.15, 0))
		rotor:box(V(1.4, 0.05, 0.2), tip + V(0, 0.15, 0), C.metalDark, M.SmoothPlastic, { collide = false })
		b:tag(rotor:groupModel(), "Spin", { Axis = "Y", Speed = 900 })
	end
	-- клешня
	b:box(V(0.1, 0.6, 0.1), V(0, -0.5, 0), C.metal, M.Metal, { collide = false })
	b:box(V(0.6, 0.1, 0.1), V(0, -0.8, 0), C.metal, M.Metal, { collide = false })
end

-- Роботы (ГДД 111–113, 125, 128, 129)
function Models.Robot(b: Builder, color: Color3)
	b:box(V(1.6, 1.2, 1.4), V(0, 0.9, 0), color, M.SmoothPlastic, { collide = false })
	for _, x in ipairs({ -0.75, 0.75 }) do
		b:cylX(0.3, 0.7, V(x, 0.35, 0.4), C.black, M.Rubber, { collide = false })
		b:cylX(0.3, 0.7, V(x, 0.35, -0.4), C.black, M.Rubber, { collide = false })
	end
	b:box(V(1, 0.7, 0.9), V(0, 1.85, 0), C.white, M.SmoothPlastic, { collide = false })
	local eye = b:box(V(0.6, 0.18, 0.05), V(0, 1.9, 0.46), C.cyan, M.Neon, { collide = false })
	b:tag(eye, "Pulse", { Speed = 2 })
	b:cyl(0.5, 0.06, V(0.3, 2.45, 0), C.metal, M.Metal, { collide = false })
	b:ball(0.15, V(0.3, 2.72, 0), C.red, M.Neon, { collide = false })
end

function Models.StaffNpc(b: Builder, color: Color3, title: string)
	local fig = b:figure(V(0, 0, 0), { shirt = color, pants = Color3.fromRGB(50, 55, 65), hat = nil }, 0, 0.85)
	local head = fig:FindFirstChild("Head") :: BasePart
	b:billboard(head, title, 1.8, Color3.fromRGB(255, 240, 180), 30)
end

-- Лопата (инструмент этапа 1)
function Models.Shovel(golden: boolean): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Лопата"
	tool.ToolTip = "Кликни по созревшей грядке"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Shovel", true)
	tool.Grip = CFrame.fromMatrix(V(0, 0, -1.3), V(0, 1, 0), V(0, 0, -1))

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = V(0.3, 0.3, 4)
	handle.Color = if golden then C.gold else C.wood
	handle.Material = if golden then M.Foil else M.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local function attach(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
	end
	attach(
		V(1.2, 0.12, 1.3),
		CFrame.new(0, 0, 2.55),
		if golden then C.gold else C.metal,
		if golden then M.Foil else M.Metal
	)
	attach(V(1, 0.25, 0.25), CFrame.new(0, 0, -2.05), if golden then C.gold else C.woodDark, M.Wood)
	return tool
end

------------------------------------------------------------------
-- Центральная площадь
------------------------------------------------------------------

-- Статуя «Основатель Картофельной Империи» (ГДД 150)
function Models.FounderStatue(b: Builder)
	b:cyl(1.2, 9, V(0, 0.6, 0), C.stone, M.Marble)
	b:cyl(1.6, 6.5, V(0, 2, 0), C.stoneDark, M.Marble)
	local fig = b:figure(V(0, 2.8, 0), { shirt = C.stone, pants = C.stone, skin = C.stone, hat = C.stone }, 0, 1.8)
	for _, d in ipairs(fig:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Material = M.Marble
			d.Color = Color3.fromRGB(220, 218, 210)
		end
	end
	b:potato(V(3, 8.3, 0.8), 2, C.gold, { collide = false }).Material = M.Foil
	local plaque = b:box(V(4.2, 0.9, 0.1), V(0, 2, 3.26), C.gold, M.Foil, { collide = false })
	b:label(
		plaque,
		Enum.NormalId.Back,
		"ОСНОВАТЕЛЬ КАРТОФЕЛЬНОЙ ИМПЕРИИ",
		{ color = C.black }
	)
end

-- Зал Славы игроков сервера (ГДД 151)
function Models.HallOfFame(b: Builder)
	b:box(V(10, 0.6, 2), V(0, 0.3, 0), C.stone, M.Marble)
	b:box(V(0.6, 8, 0.6), V(-4.6, 4, 0), C.gold, M.Foil)
	b:box(V(0.6, 8, 0.6), V(4.6, 4, 0), C.gold, M.Foil)
	local board = b:box(V(8.6, 6.4, 0.4), V(0, 4.4, 0), C.black, M.SmoothPlastic, { name = "Board" })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "FameGui"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.18)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = C.gold
	title.TextScaled = true
	title.Text = "🏆 ЗАЛ СЛАВЫ"
	title.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.05, 0.2)
	list.Size = UDim2.fromScale(0.9, 0.78)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextColor3 = Color3.new(1, 1, 1)
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Text = "Пока пусто"
	list.Parent = gui
	local back = gui:Clone()
	back.Face = Enum.NormalId.Front
	back.Parent = board
end

-- Ворота телепортации Rebirth и пьедестал с Золотым Клубнем (ГДД 148–149)
function Models.RebirthGate(b: Builder)
	b:box(V(9, 0.5, 3), V(0, 0.25, 0), C.purple, M.Marble)
	for _, x in ipairs({ -3.8, 3.8 }) do
		b:box(V(1.2, 9, 1.2), V(x, 4.5, 0), C.black, M.Marble)
	end
	b:box(V(9, 1.2, 1.4), V(0, 9.4, 0), C.black, M.Marble)
	local portal = b:box(V(6.4, 8.4, 0.2), V(0, 4.7, 0), C.purple, M.ForceField, { collide = false })
	portal.CanQuery = false
	local swirl = b:group("Swirl", V(0, 4.7, 0))
	for i = 0, 5 do
		swirl:box(
			V(5.6, 0.25, 0.1),
			V(0, 4.7, 0),
			C.cyan,
			M.Neon,
			{ rot = V(0, 0, i * 30), collide = false, transparency = 0.4 }
		)
	end
	b:tag(swirl:groupModel(), "Spin", { Axis = "Z", Speed = 60 })
	b:light(portal, C.purple, 18, 2)
	local plaque = b:box(V(5, 0.8, 0.1), V(0, 9.4, 0.75), C.black, M.SmoothPlastic, { collide = false })
	b:label(plaque, Enum.NormalId.Back, "REBIRTH", { color = C.purple })
end

function Models.GoldenPedestal(b: Builder)
	b:cyl(2.4, 2.2, V(0, 1.2, 0), C.white, M.Marble)
	b:cyl(0.3, 2.6, V(0, 2.55, 0), C.gold, M.Foil)
	local tuber = b:potato(V(0, 3.6, 0), 1.8, C.gold, { collide = false })
	tuber.Material = M.Foil
	b:tag(tuber, "Bob", { Amplitude = 0.3, Speed = 1.5 })
	local sparks = Instance.new("Sparkles")
	sparks.SparkleColor = C.gold
	sparks.Parent = tuber
end

-- Капсула криосна магната (ГДД 153)
function Models.CryoCapsule(b: Builder)
	b:box(V(2.6, 0.6, 5), V(0, 0.3, 0), C.metalDark, M.Metal)
	b:ellipsoid(V(2.4, 2.2, 4.6), V(0, 1.4, 0), Color3.fromRGB(190, 230, 255), M.Glass, { transparency = 0.45 })
	b:figure(V(0, 0.9, -1.2), { shirt = C.white, pants = C.white }, 0, 0.7)
	local led = b:box(V(1.6, 0.1, 0.1), V(0, 0.55, 2.52), C.cyan, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 0.8 })
end

-- Фонарь уличного освещения (ГДД 181)
function Models.StreetLight(b: Builder)
	b:cyl(0.4, 1, V(0, 0.2, 0), C.metalDark, M.Metal)
	b:cyl(9, 0.35, V(0, 4.6, 0), C.metalDark, M.Metal)
	b:box(V(0.3, 0.3, 2.2), V(0, 9, 0.9), C.metalDark, M.Metal, { collide = false })
	local lamp = b:box(V(0.9, 0.3, 1.2), V(0, 8.8, 1.8), Color3.fromRGB(255, 240, 200), M.Neon, { collide = false })
	b:light(lamp, Color3.fromRGB(255, 230, 190), 24, 1.6, true)
end

-- Мусорный контейнер переработки (ГДД 180)
function Models.TrashBin(b: Builder)
	b:box(V(2.2, 1.6, 1.4), V(0, 0.8, 0), C.green, M.Metal)
	b:box(V(2.3, 0.15, 1.5), V(0, 1.65, 0), Color3.fromRGB(40, 110, 50), M.Metal, { rot = V(-10, 0, 0) })
	local s = b:box(V(0.8, 0.8, 0.05), V(0, 0.9, 0.71), C.white, M.SmoothPlastic, { collide = false })
	b:label(s, Enum.NormalId.Back, "♻", { color = C.green })
end

function Models.Bench(b: Builder)
	b:box(V(4, 0.25, 1.2), V(0, 1.1, 0), C.wood, M.WoodPlanks)
	b:box(V(4, 1, 0.2), V(0, 1.8, -0.55), C.wood, M.WoodPlanks)
	for _, x in ipairs({ -1.7, 1.7 }) do
		b:box(V(0.2, 1, 1), V(x, 0.5, 0), C.metalDark, M.Metal)
	end
end

return Models
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Science</string>
              <string name="Source"><![CDATA[-- Модели сектора 4: НИИ квантовой селекции, космодром и Rebirth

local Kit = require(script.Parent.Parent.ModelKit)
local Energy = require(script.Parent.Energy)

type Builder = Kit.Builder

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local Models = {}

local function beakers(b: Builder, x0: number, y: number, z: number)
	local colors = { C.green, C.cyan, C.purple, C.orange }
	for i, color in ipairs(colors) do
		b:cyl(0.5, 0.3, V(x0 + i * 0.45, y + 0.25, z), color, M.Neon, { collide = false, transparency = 0.2 })
	end
end

function Models.Lab(b: Builder)
	local white = Color3.fromRGB(240, 242, 245)
	b:box(V(12, 0.3, 8), V(0, 0.15, 0), white, M.Marble)
	-- каркас и стеклянные стены
	for _, x in ipairs({ -5.9, 5.9 }) do
		for _, z in ipairs({ -3.9, 3.9 }) do
			b:box(V(0.3, 4.5, 0.3), V(x, 2.4, z), white, M.SmoothPlastic)
		end
	end
	b:box(V(12, 4.2, 0.15), V(0, 2.4, -3.9), C.glass, M.Glass, { transparency = 0.6 })
	b:box(V(0.15, 4.2, 8), V(-5.9, 2.4, 0), C.glass, M.Glass, { transparency = 0.6 })
	b:box(V(4.5, 4.2, 0.15), V(-3.6, 2.4, 3.9), C.glass, M.Glass, { transparency = 0.6 })
	b:box(V(4.5, 4.2, 0.15), V(3.6, 2.4, 3.9), C.glass, M.Glass, { transparency = 0.6 })
	b:box(V(0.15, 4.2, 8), V(5.9, 2.4, 0), C.glass, M.Glass, { transparency = 0.6 })
	b:box(V(12.4, 0.4, 8.4), V(0, 4.75, 0), white, M.SmoothPlastic)
	local sign = b:box(V(5, 0.9, 0.1), V(0, 5.4, 4.2), C.white, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "🧬 ЛАБОРАТОРИЯ ДНК", { color = C.blue })
	-- дверь со сканером отпечатка (ГДД 161)
	local scanner = b:box(V(0.4, 0.6, 0.1), V(1.6, 1.8, 4.0), C.black, M.SmoothPlastic, { collide = false })
	b:box(V(0.25, 0.3, 0.05), V(1.6, 1.8, 4.06), C.green, M.Neon, { collide = false })
	local _ = scanner
	-- лабораторный стол с мензурками (ГДД 131)
	b:box(V(4, 0.2, 1.4), V(-3.2, 1.3, -2.8), white, M.SmoothPlastic)
	b:box(V(4, 1.2, 1.2), V(-3.2, 0.6, -2.8), C.metal, M.Metal)
	beakers(b, -5, 1.4, -2.8)
	-- электронный микроскоп (ГДД 132)
	b:box(V(1.2, 0.8, 1.2), V(-1.8, 1.8, -2.8), C.white, M.SmoothPlastic, { collide = false })
	b:cyl(1.4, 0.4, V(-1.8, 2.8, -2.8), C.metalDark, M.Metal, { collide = false })
	-- серверный шкаф нейросети (ГДД 138)
	b:box(V(1.4, 3.4, 1.2), V(4.8, 1.9, -2.9), C.black, M.Metal)
	for y = 0.8, 3.2, 0.4 do
		local led = b:box(V(1, 0.08, 0.05), V(4.8, y, -2.28), C.cyan, M.Neon, { collide = false })
		b:tag(led, "Pulse", { Speed = 1 + y })
	end
	-- лазерный стимулятор деления клеток (ГДД 139)
	b:box(V(1.4, 1, 1), V(2.6, 0.8, -2.8), C.metal, M.Metal)
	local beam = b:box(V(0.1, 0.1, 1.6), V(2.6, 1.6, -2.2), C.red, M.Neon, { collide = false })
	b:tag(beam, "Pulse", { Speed = 6 })
	-- терминал исследований
	local terminal = b:box(V(1.6, 1.2, 0.2), V(0, 1.8, 1.4), C.black, M.SmoothPlastic, { rot = V(-20, 0, 0) })
	b:label(terminal, Enum.NormalId.Back, "СОРТА", { color = C.green, background = C.black })
	b:box(V(0.3, 1.2, 0.3), V(0, 0.75, 1.4), C.metal, M.Metal)
	Energy.openMenu(terminal, "Research", "Исследования семян", "Терминал")
end

function Models.Centrifuge(b: Builder)
	b:cyl(1.6, 3.4, V(0, 0.8, 0), C.white, M.SmoothPlastic)
	b:cyl(0.2, 3.5, V(0, 1.7, 0), C.metal, M.Metal)
	b:cyl(0.6, 3, V(0, 2.05, 0), C.glass, M.Glass, { transparency = 0.5, collide = false })
	local rotor = b:group("Rotor", V(0, 1.95, 0))
	for i = 0, 5 do
		local a = math.rad(i * 60)
		rotor:cyl(0.4, 0.35, V(math.cos(a) * 1, 1.95, math.sin(a) * 1), C.cyan, M.Neon, { collide = false })
	end
	b:tag(rotor:groupModel(), "Spin", { Axis = "Y", Speed = 720 })
	local led = b:box(V(0.6, 0.3, 0.05), V(0, 1, 1.71), C.green, M.Neon, { collide = false })
	b:tag(led, "Pulse", { Speed = 2 })
end

function Models.Mutagenesis(b: Builder)
	b:box(V(4.6, 3.6, 4.6), V(0, 1.8, 0), Color3.fromRGB(70, 75, 80), M.Metal)
	b:box(V(4.8, 0.4, 4.8), V(0, 3.8, 0), C.yellow, M.Metal)
	local window = b:box(
		V(1.8, 1.4, 0.1),
		V(0, 2, 2.31),
		Color3.fromRGB(120, 255, 60),
		M.Neon,
		{ collide = false, transparency = 0.3 }
	)
	b:light(window, Color3.fromRGB(120, 255, 60), 10, 2)
	local sign = b:box(V(1.4, 1.4, 0.05), V(0, 3.0, 2.33), C.yellow, M.SmoothPlastic, { collide = false })
	b:label(sign, Enum.NormalId.Back, "☢", { color = C.black })
	local sparks = Instance.new("Sparkles")
	sparks.SparkleColor = Color3.fromRGB(120, 255, 60)
	sparks.Parent = window
end

function Models.Incubator(b: Builder)
	b:box(V(3.6, 0.3, 4.6), V(0, 0.15, 0), C.white, M.SmoothPlastic)
	b:box(V(3.6, 3.6, 4.6), V(0, 2.1, 0), C.glass, M.Glass, { transparency = 0.55 })
	for y = 1, 3, 1 do
		b:box(V(3.2, 0.1, 4.2), V(0, y, 0), C.white, M.SmoothPlastic, { collide = false })
		for z = -1.6, 1.6, 0.8 do
			b:ellipsoid(V(0.4, 0.5, 0.4), V(-0.8, y + 0.3, z), C.leaf, M.Grass, { collide = false })
			b:ellipsoid(V(0.4, 0.5, 0.4), V(0.8, y + 0.3, z), C.leaf, M.Grass, { collide = false })
		end
	end
	local lamp = b:box(V(3.4, 0.15, 4.4), V(0, 3.85, 0), Color3.fromRGB(255, 200, 120), M.Neon, { collide = false })
	b:light(lamp, Color3.fromRGB(255, 200, 120), 8, 1)
end

function Models.QuantumIrradiator(b: Builder)
	b:cyl(0.5, 4.4, V(0, 0.25, 0), C.metalDark, M.Metal)
	b:cyl(4.4, 0.8, V(0, 2.7, 0), C.black, M.Metal)
	local rings = b:group("Rings", V(0, 2.8, 0))
	for i, y in ipairs({ 1.6, 2.8, 4 }) do
		rings:cyl(0.15, 2.8 - i * 0.3, V(0, y, 0), C.cyan, M.Neon, { collide = false, transparency = 0.15 })
	end
	b:tag(rings:groupModel(), "Bob", { Amplitude = 0.4, Speed = 2 })
	local emitter = b:ellipsoid(V(2.4, 0.6, 2.4), V(0, 5.2, 0), C.white, M.SmoothPlastic, { rot = V(25, 0, 0) })
	b:light(emitter, C.cyan, 16, 2, true)
end

function Models.HoloTerminal(b: Builder)
	b:box(V(2.6, 1.2, 1.6), V(0, 0.6, 0), C.black, M.Metal)
	b:box(V(2.4, 0.1, 1.4), V(0, 1.25, 0), C.cyan, M.Neon, { collide = false, transparency = 0.3 })
	local holo = b:group("Holo", V(0, 2.5, 0))
	holo:cyl(2.2, 0.15, V(0, 2.4, 0), C.cyan, M.Neon, { collide = false, transparency = 0.3 })
	for i = 0, 5 do
		local a = math.rad(i * 60)
		local y = 1.8 + i * 0.25
		holo:pipe(V(0, y, 0), V(math.cos(a) * 0.9, y + 0.6, math.sin(a) * 0.9), 0.08, C.cyan, M.Neon)
		holo:ball(
			0.3,
			V(math.cos(a) * 0.9, y + 0.6, math.sin(a) * 0.9),
			C.cyan,
			M.Neon,
			{ collide = false, transparency = 0.2 }
		)
	end
	b:tag(holo:groupModel(), "Spin", { Axis = "Y", Speed = 40 })
end

function Models.SeedVault(b: Builder)
	b:box(V(3.8, 3.4, 3.8), V(0, 1.7, 0), Color3.fromRGB(225, 235, 245), M.Metal)
	local door = b:cylZ(0.3, 2.4, V(0, 1.7, 1.95), C.metal, M.Metal)
	b:box(V(1.6, 0.2, 0.15), V(0, 1.7, 2.15), C.metalDark, M.Metal, { collide = false })
	b:box(V(4, 0.3, 4), V(0, 3.55, 0), Color3.fromRGB(200, 230, 250), M.Ice)
	local mist = Instance.new("ParticleEmitter")
	mist.Color = ColorSequence.new(Color3.new(1, 1, 1))
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.Size = NumberSequence.new(0.6, 1.4)
	mist.Lifetime = NumberRange.new(1, 2)
	mist.Rate = 5
	mist.Speed = NumberRange.new(0.3, 0.8)
	mist.Acceleration = V(0, -0.5, 0)
	mist.Parent = door
end

function Models.GodMonument(b: Builder)
	b:box(V(4, 1, 6), V(0, 0.5, 0), C.stone, M.Marble)
	b:box(V(3, 1.2, 5), V(0, 1.6, 0), C.stoneDark, M.Marble)
	local idol = b:group("Idol", V(0, 4.5, 0))
	idol:potato(V(0, 4.6, 0), 4.2, C.gold, { rot = V(0, 0, 90) }).Material = M.Foil
	idol:box(V(1.6, 0.6, 1.6), V(0, 6.9, 0), C.gold, M.Foil, { collide = false })
	for i = 0, 4 do
		local a = math.rad(i * 72)
		idol:box(V(0.3, 0.6, 0.3), V(math.cos(a) * 0.65, 7.4, math.sin(a) * 0.65), C.gold, M.Foil, { collide = false })
	end
	idol:ball(0.5, V(-0.5, 5.2, 1.0), C.white, M.SmoothPlastic, { collide = false })
	idol:ball(0.5, V(0.5, 5.2, 1.0), C.white, M.SmoothPlastic, { collide = false })
	b:tag(idol:groupModel(), "Bob", { Amplitude = 0.3, Speed = 1 })
	local plaque = b:box(V(2.4, 0.6, 0.05), V(0, 1.6, 2.53), C.gold, M.Foil, { collide = false })
	b:label(plaque, Enum.NormalId.Back, "КАРТОФЕЛЬНЫЙ БОГ", { color = C.black })
	local glow = b:ball(0.2, V(0, 4.6, 0), C.gold, M.Neon, { collide = false, transparency = 1 })
	b:light(glow, C.gold, 14, 2)
end

function Models.LaunchPad(b: Builder)
	b:box(V(14, 1, 14), V(0, 0.5, 0), C.concrete, M.Concrete, { name = "Pad" })
	b:box(V(4, 0.06, 4), V(0, 1.03, 0), C.black, M.Concrete, { collide = false })
	for _, r in ipairs({ 5, 6.4 }) do
		b:box(V(r * 2, 0.06, 0.3), V(0, 1.04, r), C.yellow, M.SmoothPlastic, { collide = false })
		b:box(V(r * 2, 0.06, 0.3), V(0, 1.04, -r), C.yellow, M.SmoothPlastic, { collide = false })
		b:box(V(0.3, 0.06, r * 2), V(r, 1.04, 0), C.yellow, M.SmoothPlastic, { collide = false })
		b:box(V(0.3, 0.06, r * 2), V(-r, 1.04, 0), C.yellow, M.SmoothPlastic, { collide = false })
	end
	for _, x in ipairs({ -6.5, 6.5 }) do
		for _, z in ipairs({ -6.5, 6.5 }) do
			local lamp = b:cyl(0.6, 0.5, V(x, 1.3, z), C.red, M.Neon, { collide = false })
			b:tag(lamp, "Pulse", { Speed = 1.5 })
		end
	end
	-- газоотводный лоток
	b:box(V(3, 0.8, 4), V(0, 0.4, 8.6), C.stoneDark, M.Concrete, { collide = false })
end

function Models.LaunchTower(b: Builder)
	b:box(V(4, 0.6, 6), V(0, 0.3, 0), C.concrete, M.Concrete)
	local h = 22
	for _, x in ipairs({ -1.2, 1.2 }) do
		for _, z in ipairs({ -1.2, 1.2 }) do
			b:box(V(0.35, h, 0.35), V(x, h / 2, z), C.red, M.Metal)
		end
	end
	for y = 2, h - 2, 2 do
		b:box(
			V(2.6, 0.2, 0.2),
			V(0, y, 1.2),
			C.red,
			M.Metal,
			{ collide = false, rot = V(0, 0, if y % 4 == 0 then 30 else -30) }
		)
		b:box(V(2.6, 0.2, 0.2), V(0, y, -1.2), C.red, M.Metal, { collide = false })
		b:box(V(0.2, 0.2, 2.6), V(1.2, y, 0), C.red, M.Metal, { collide = false })
	end
	-- руки обслуживания к шаттлу (шаттл стоит на площадке западнее, x = -10)
	for _, y in ipairs({ 8, 14, 19 }) do
		b:box(V(6, 0.4, 1), V(-4, y, 0), C.metalDark, M.Metal, { collide = false })
	end
	b:pipe(V(-1.2, 12, 0.8), V(-7, 9, 0.8), 0.25, C.black, M.Rubber)
	b:pipe(V(-1.2, 16, -0.8), V(-7, 13, -0.8), 0.25, C.black, M.Rubber)
	local top = b:ball(0.5, V(0, h + 0.5, 0), C.red, M.Neon, { collide = false })
	b:tag(top, "Pulse", { Speed = 1 })
end

-- Шаттл ставится поверх стартовой площадки (overlay)
function Models.Shuttle(b: Builder)
	local stack = b:group("Stack", V(0, 1, 0))
	local white = Color3.fromRGB(245, 245, 245)
	-- ракета-носитель «Спуд-1» (ГДД 145)
	stack:cyl(12, 3.2, V(0, 7, -0.6), Color3.fromRGB(230, 120, 40), M.SmoothPlastic)
	stack:ellipsoid(V(3.2, 3, 3.2), V(0, 13, -0.6), Color3.fromRGB(230, 120, 40), M.SmoothPlastic)
	for _, x in ipairs({ -2.1, 2.1 }) do
		stack:cyl(10, 1.2, V(x, 6, -0.6), white, M.SmoothPlastic)
		stack:ellipsoid(V(1.2, 1.6, 1.2), V(x, 11.4, -0.6), white, M.SmoothPlastic)
	end
	-- орбитальный корабль «Галактический Картофель» (ГДД 146)
	stack:cyl(9, 2.2, V(0, 7.5, 1.8), white, M.SmoothPlastic)
	stack:ellipsoid(V(2.2, 3, 2.2), V(0, 12.4, 1.8), C.black, M.SmoothPlastic)
	stack:wedge(V(0.4, 4, 3.4), V(-2.2, 4.4, 1.8), white, M.SmoothPlastic, { rot = V(0, 0, 0) })
	stack:wedge(V(0.4, 4, 3.4), V(2.2, 4.4, 1.8), white, M.SmoothPlastic, { rot = V(0, 0, 0) })
	stack:box(V(4.4, 0.3, 3), V(0, 3.4, 1.8), white, M.SmoothPlastic)
	local logo = stack:box(V(1.6, 1.6, 0.1), V(0, 8, 2.92), white, M.SmoothPlastic, { collide = false })
	stack:label(logo, Enum.NormalId.Back, "🥔", { color = C.black })
	-- двигатели
	for i, x in ipairs({ -2.1, 0, 2.1 }) do
		local nozzle = stack:cyl(0.8, 1, V(x, 0.6, -0.6), C.metalDark, M.Metal, { name = "Engine" .. i })
		local fire = Instance.new("Fire")
		fire.Name = "Flame"
		fire.Enabled = false
		fire.Size = 6
		fire.Heat = -10
		fire.Color = Color3.fromRGB(255, 150, 40)
		fire.SecondaryColor = Color3.fromRGB(255, 240, 120)
		fire.Parent = nozzle
		local smoke = Instance.new("Smoke")
		smoke.Name = "Exhaust"
		smoke.Enabled = false
		smoke.Size = 6
		smoke.Opacity = 0.4
		smoke.RiseVelocity = -4
		smoke.Color = Color3.fromRGB(220, 220, 220)
		smoke.Parent = nozzle
	end
	stack:groupModel():SetAttribute("Shuttle", true)
	local plaque = b:box(V(0.1, 0.1, 0.1), V(0, 14.5, 0), white, M.SmoothPlastic, { collide = false, transparency = 1 })
	b:billboard(plaque, "🚀 Шаттл готов к Rebirth", 2, C.yellow, 80)
	Energy.openMenu(plaque, "Rebirth", "Запуск Rebirth", "Шаттл")
	local prompt = plaque:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.MaxActivationDistance = 22
	end
end

function Models.Beacon(b: Builder)
	b:cyl(0.4, 1.6, V(0, 0.2, 0), C.concrete, M.Concrete)
	b:cyl(10, 0.3, V(0, 5.2, 0), C.white, M.Metal)
	local lamp = b:ball(0.8, V(0, 10.4, 0), C.red, M.Neon, { collide = false })
	b:light(lamp, C.red, 20, 2)
	b:tag(lamp, "Pulse", { Speed = 1.2 })
end

function Models.Satellite(b: Builder)
	b:box(V(2.6, 0.6, 2.6), V(0, 0.3, 0), C.concrete, M.Concrete)
	b:cyl(2.6, 0.5, V(0, 1.9, 0), C.metal, M.Metal)
	local dish = b:group("Dish", V(0, 3.4, 0))
	dish:ellipsoid(V(3.2, 0.8, 3.2), V(0, 3.6, 0), C.white, M.SmoothPlastic, { rot = V(40, 0, 0), collide = false })
	dish:pipe(V(0, 3.6, 0), V(0, 4.6, 0.9), 0.1, C.metalDark)
	dish:ball(0.3, V(0, 4.6, 0.9), C.red, M.Neon, { collide = false })
	b:tag(dish:groupModel(), "Spin", { Axis = "Y", Speed = 15 })
end

function Models.StarTerminal(b: Builder)
	b:box(V(2.6, 0.4, 2.6), V(0, 0.2, 0), C.purple, M.Metal)
	b:box(V(1.6, 2.4, 1), V(0, 1.6, -0.3), C.gold, M.Foil)
	local screen = b:box(V(1.4, 1, 0.1), V(0, 2.2, 0.22), C.black, M.SmoothPlastic)
	b:label(screen, Enum.NormalId.Back, "⭐ ЗВЁЗДЫ", { color = C.yellow, background = C.black })
	local star = b:ball(0.7, V(0, 3.4, -0.3), C.yellow, M.Neon, { collide = false })
	b:tag(star, "Bob", { Amplitude = 0.3, Speed = 2 })
	b:light(star, C.yellow, 10, 2)
	Energy.openMenu(screen, "StarTech", "Звёздные технологии", "Терминал звёзд")
end

return Models
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Генерация мира: центральная площадь, дорожки и 6 баз игроков 80x80 по кругу.
-- Локальная система базы: x вправо (восток), z к входу (к площади), пол на y = 0.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.ModelKit)
local Misc = require(script.Parent.Models.Misc)

local V = Vector3.new
local C = Kit.C
local M = Enum.Material

local FLOOR_Y = 0.2

local World = {}

export type PlotInfo = {
	index: number,
	cframe: CFrame,
	folder: Model,
	items: Folder,
	buttons: Folder,
	staff: Folder,
	bugs: Folder,
	sign: TextLabel,
	spawn: CFrame,
}

World.plots = {} :: { PlotInfo }

local SECTORS = {
	{
		name = "СЕКТОР 1: АГРО-БЛОК",
		z0 = 14,
		z1 = 40,
		color = Color3.fromRGB(105, 165, 75),
		material = M.Grass,
	},
	{
		name = "СЕКТОР 3: ЭНЕРГЕТИКА И ДРОН-СЕРВИС",
		z0 = -2,
		z1 = 14,
		color = Color3.fromRGB(80, 82, 88),
		material = M.Asphalt,
	},
	{
		name = "СЕКТОР 2: ЗАВОД ПЕРЕРАБОТКИ",
		z0 = -22,
		z1 = -2,
		color = Color3.fromRGB(165, 165, 160),
		material = M.Concrete,
	},
	{
		name = "СЕКТОР 4: НАУКА, КОСМОДРОМ И REBIRTH",
		z0 = -40,
		z1 = -22,
		color = Color3.fromRGB(215, 222, 235),
		material = M.CeramicTiles,
	},
}

local function floorText(b: Kit.Builder, text: string, pos: Vector3, width: number)
	local p = b:box(V(width, 0.05, 1.6), pos, C.white, M.SmoothPlastic, { collide = false, transparency = 1 })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.3
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 230, 120)
	label.TextStrokeTransparency = 0.4
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
end

local function buildPlotBase(index: number, cf: CFrame): PlotInfo
	local folder = Instance.new("Model")
	folder.Name = "Plot" .. index
	folder:SetAttribute("PlotIndex", index)
	folder.WorldPivot = cf

	local b = Kit.new("Base", cf * CFrame.new(0, -FLOOR_Y, 0))
	-- полы секторов
	for _, s in ipairs(SECTORS) do
		local depth = s.z1 - s.z0
		b:box(V(80, 0.2, depth), V(0, 0.1, (s.z0 + s.z1) / 2), s.color, s.material)
	end
	-- центральная дорожка
	b:box(V(6, 0.06, 80), V(0, 0.23, 0), Color3.fromRGB(125, 125, 128), M.Pavement, { collide = false })
	for _, s in ipairs(SECTORS) do
		floorText(b, s.name, V(0, 0.27, s.z1 - 1.4), 6)
	end
	-- сетчатый забор с колючей проволокой (ГДД 168) вокруг индустриальной части
	local fence = Color3.fromRGB(150, 155, 160)
	local function fenceLine(a: Vector3, c: Vector3)
		local mid = (a + c) / 2
		local len = (c - a).Magnitude
		local alongX = math.abs(c.X - a.X) > 0.1
		b:box(
			if alongX then V(len, 2.8, 0.1) else V(0.1, 2.8, len),
			mid + V(0, 1.6, 0),
			fence,
			M.DiamondPlate,
			{ transparency = 0.55 }
		)
		b:pipe(a + V(0, 3.1, 0), c + V(0, 3.1, 0), 0.12, Color3.fromRGB(90, 90, 95))
		local n = math.max(1, math.floor(len / 8))
		for i = 0, n do
			b:box(V(0.25, 3.3, 0.25), a:Lerp(c, i / n) + V(0, 1.85, 0), Color3.fromRGB(90, 90, 95), M.Metal)
		end
	end
	fenceLine(V(-40, 0, 14), V(-40, 0, -40))
	fenceLine(V(40, 0, 14), V(40, 0, -40))
	fenceLine(V(-40, 0, -40), V(-4, 0, -40))
	fenceLine(V(4, 0, -40), V(40, 0, -40))

	-- табличка владельца у входа
	b:box(V(0.4, 4, 0.4), V(-7, 2.2, 41.5), C.woodDark, M.Wood)
	local board = b:box(V(7, 2.2, 0.3), V(-7, 4.6, 41.5), C.woodLight, M.WoodPlanks, { name = "OwnerSign" })
	local sign = b:label(board, Enum.NormalId.Back, "Свободная база", { color = C.woodDark })
	local base = b.model
	base.Parent = folder

	local function sub(name: string, class: string)
		local f = Instance.new(class)
		f.Name = name
		f.Parent = folder
		return f
	end

	local info: PlotInfo = {
		index = index,
		cframe = cf,
		folder = folder,
		items = sub("Items", "Folder") :: Folder,
		buttons = sub("Buttons", "Folder") :: Folder,
		staff = sub("Staff", "Folder") :: Folder,
		bugs = sub("Bugs", "Folder") :: Folder,
		sign = sign,
		spawn = cf * CFrame.new(0, 3, 37), -- лицом вглубь базы (-Z)
	}
	return info
end

local function hubObject(builderName: string, parent: Instance, cf: CFrame, ...)
	local b = Kit.new(builderName, cf)
	Misc[builderName](b, ...)
	return b:finish(parent)
end

local function tree(parent: Instance, pos: Vector3, scale: number)
	local b = Kit.new("Tree", CFrame.new(pos))
	b:cyl(5 * scale, 1.2 * scale, V(0, 2.5 * scale, 0), C.woodDark, M.Wood)
	b:ellipsoid(V(7, 6, 7) * scale, V(0, 6.5 * scale, 0), C.leafDark, M.Grass)
	b:ellipsoid(V(5, 4.5, 5) * scale, V(0.8 * scale, 9 * scale, 0.5 * scale), C.leaf, M.Grass)
	b:finish(parent)
end

function World.build()
	local G = Config.Game
	local root = Instance.new("Folder")
	root.Name = "World"
	root.Parent = workspace

	-- центральная площадь
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	hub.Parent = root
	local plaza = Kit.new("Plaza", CFrame.new())
	plaza:cyl(0.3, G.HubRadius * 2, V(0, 0.15, 0), Color3.fromRGB(190, 185, 175), M.Pavement)
	plaza:cyl(0.32, G.HubRadius * 2 - 6, V(0, 0.16, 0), Color3.fromRGB(205, 200, 190), M.Cobblestone)
	plaza:finish(hub)
	hubObject("FounderStatue", hub, CFrame.new(0, 0.3, 0) * CFrame.Angles(0, math.rad(180), 0))

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace

	local count = G.PlotCount
	local R = G.PlotRingRadius
	for i = 1, count do
		local angle = (i - 1) * 2 * math.pi / count
		local dir = V(math.sin(angle), 0, math.cos(angle))
		local center = dir * R + V(0, FLOOR_Y, 0)
		local cf = CFrame.lookAt(center, center + dir)
		local info = buildPlotBase(i, cf)
		info.folder.Parent = plotsFolder
		World.plots[i] = info

		-- дорожка от площади к входу на базу
		local inner = G.HubRadius - 2
		local outer = R - 40
		local mid = dir * ((inner + outer) / 2)
		local path = Kit.new("Path" .. i, CFrame.lookAt(mid, mid + dir))
		path:box(V(8, 0.24, outer - inner), V(0, 0.12, 0), Color3.fromRGB(150, 145, 140), M.Pavement)
		path:finish(hub)
		-- фонари вдоль дорожки
		for d = inner + 8, outer - 4, 16 do
			for _, side in ipairs({ -1, 1 }) do
				local perp = dir:Cross(Vector3.yAxis) * side
				local p = dir * d + perp * 5.5
				-- +Z модели (стрела фонаря) смотрит на дорожку
				hubObject("StreetLight", hub, CFrame.lookAt(p, p + perp))
			end
		end
	end

	-- объекты площади между дорожками
	local decor = { "HallOfFame", "RebirthGate", "GoldenPedestal", "CryoCapsule", "Bench", "TrashBin" }
	for i, name in ipairs(decor) do
		local angle = (i - 0.5) * 2 * math.pi / count
		local p = V(math.sin(angle), 0, math.cos(angle)) * (G.HubRadius - 12) + V(0, 0.3, 0)
		-- +Z модели смотрит в центр площади
		local model = hubObject(name, hub, CFrame.lookAt(p, p + (p - V(0, 0.3, 0))))
		if name == "HallOfFame" then
			World.hallOfFame = model
		end
	end

	-- деревья по внешнему кольцу
	local rng = Random.new(42)
	local trees = Instance.new("Folder")
	trees.Name = "Trees"
	trees.Parent = root
	for i = 1, 36 do
		local angle = i / 36 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local r = R + 75 + rng:NextNumber(-10, 25)
		tree(trees, V(math.sin(angle) * r, 0, math.cos(angle) * r), rng:NextNumber(0.9, 1.5))
	end
end

-- CFrame точки (x, z) базы с поворотом rot (градусы) и подъёмом y
function World.localCFrame(info: PlotInfo, x: number, z: number, rot: number?, y: number?): CFrame
	return info.cframe * CFrame.new(x, y or 0, z) * CFrame.Angles(0, math.rad(rot or 0), 0)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
