		yieldBoost = 0.05,
		visual = "Npc",
		color = { 80, 160, 80 },
	},
	{
		id = "palletizer",
		name = "Робо-рука паллетайзер",
		asset = 113,
		requires = "office",
		cost = 380_000,
		growth = 3,
		max = 2,
		factoryAdd = 0.5,
		visual = "Robot",
		color = { 255, 140, 30 },
	},
	{
		id = "engineer",
		name = "Главный инженер цеха",
		asset = 116,
		requires = "office",
		cost = 750_000,
		growth = 1,
